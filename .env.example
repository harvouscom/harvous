CLERK_AUTHORIZED_PARTIES="http://localhost:4322,https://app.harvous.com,https://new.harvous.com"
CLERK_WEBHOOK_SECRET=""
SUPABASE_DATABASE_URL=""
SUPABASE_DIRECT_URL=""
# Supabase project URL (https://xxx.supabase.co) — Realtime broadcast from API
SUPABASE_URL=""
# Service role key — server only (Netlify); never expose to clients
SUPABASE_SERVICE_ROLE_KEY=""
# Vite SPA + native anon key (Realtime subscribe)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
AUDIENCEFUL_API_KEY=""

# Native Better Stack URL (not status.harvous.com — that domain will point at Netlify after cutover)
BETTERSTACK_STATUS_JSON_URL="https://harvous.betteruptime.com/index.json"

# Vite SPA (mirrors PUBLIC_CLERK_PUBLISHABLE_KEY for @clerk/react)
VITE_CLERK_PUBLISHABLE_KEY=""
# Deprecated: the Unlimited plan is retired (archived in Clerk)
VITE_CLERK_UNLIMITED_PLAN_ID=""

# PostHog (product analytics) — SPA reads PUBLIC_* or VITE_PUBLIC_* (vite envPrefix includes both)
PUBLIC_POSTHOG_KEY=""
PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Optional aliases if you prefer the VITE_ prefix only:
# VITE_PUBLIC_POSTHOG_KEY=""
# VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Polar Billing (merchant of record) — sandbox and live use different ids/keys.
# Each (plan × interval) is its own Polar Product; see src/lib/billing-plans.ts.
#   Founding    $45/yr  annual only, first 99 subscribers, lifetime lock
#   Plus        $8/mo · $64/yr (four months free)
#   Connector   $5/mo · $60/yr (no annual discount — exactly 12× monthly)
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ENV="sandbox"
POLAR_PLUS_PRODUCT_FOUNDING_ANNUAL=""
POLAR_PLUS_PRODUCT_MONTHLY=""
POLAR_PLUS_PRODUCT_ANNUAL=""
POLAR_CONNECTOR_PRODUCT_MONTHLY=""
POLAR_CONNECTOR_PRODUCT_ANNUAL=""
# Client only needs the product ids (checkout session is created server-side; no client token)
VITE_POLAR_PLUS_PRODUCT_FOUNDING_ANNUAL=""
VITE_POLAR_PLUS_PRODUCT_MONTHLY=""
VITE_POLAR_PLUS_PRODUCT_ANNUAL=""
VITE_POLAR_CONNECTOR_PRODUCT_MONTHLY=""
VITE_POLAR_CONNECTOR_PRODUCT_ANNUAL=""

# Optional: generate server/data/bibles/{NASB,CSB,AMP,MSG}.json (NASB = NASB 1995; API.Bible — same class of pipeline as other bundled translations)
# API_BIBLE_KEY=""
# API_BIBLE_ID_NASB=""  # bible id for NASB 1995
# API_BIBLE_ID_CSB=""
# API_BIBLE_ID_AMP=""
# API_BIBLE_ID_MSG=""

# Here’s My Church partner API (server-only — never expose PARTNER key to the SPA)
# Base must include /v1. See heresmychurch/docs/future/public-api.md
HERESMYCHURCH_API_BASE="https://epufchwxofsyuictfufy.supabase.co/functions/v1/make-server-283d8046/v1"
HERESMYCHURCH_ANON_KEY=""
HERESMYCHURCH_PARTNER_API_KEY=""

# Harvous admin + system user (Clerk user ID of the Harvous Admin account)
HARVOUS_SYSTEM_USER_ID=""
HARVOUS_ADMIN_SECRET="" # optional: admin API access via Authorization: Bearer <secret>
# Comma-separated Clerk user IDs with admin access (HARVOUS_SYSTEM_USER_ID is always included)
HARVOUS_ADMIN_USER_IDS=""
# Comma-separated admin emails — resolved via Clerk at request time
HARVOUS_ADMIN_EMAILS="derekj@hey.com"
# Curated Easter content: override space id for publish/grant scripts (optional)
EASTER_2026_SPACE_ID=""
# One-off: npm run harvous:grant-space-member — add your admin Clerk id to the Easter space
HARVOUS_GRANT_USER_ID=""
HARVOUS_GRANT_SPACE_ID="" # optional; defaults to EASTER_2026_SPACE_ID or known Easter 2026 id
