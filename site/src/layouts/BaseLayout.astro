---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Harvous — Create your study Bible.",
  description = "A notes app for Bible study. Notes, highlights, and references — all linked to scripture, on every device.",
  ogImage = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://harvous.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Resolve day/night before paint (no flash). Sets data-color-scheme on
         <html>, which drives both site chrome (--color-*) and the AppShell
         replica (--pds-*). -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("harvous-color-scheme");
          const scheme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.colorScheme = scheme;
        } catch (e) {
          document.documentElement.dataset.colorScheme = "light";
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/harvous-2-icon.png" />
    <link rel="apple-touch-icon" href="/images/harvous-2-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? "https://harvous.com").toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveals: paper-stack fan-in (.in-view) + generic [data-reveal] (.revealed).
      const stacks = document.querySelectorAll(".paper-stack");
      const reveals = document.querySelectorAll("[data-reveal]");

      if ("IntersectionObserver" in window) {
        const reveal = (el: Element, cls: string, ob: IntersectionObserver) => {
          el.classList.add(cls);
          ob.unobserve(el);
        };
        const stackObserver = new IntersectionObserver(
          (entries, ob) => {
            entries.forEach((e) => e.isIntersecting && reveal(e.target, "in-view", ob));
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
        );
        stacks.forEach((el) => stackObserver.observe(el));

        const revealObserver = new IntersectionObserver(
          (entries, ob) => {
            entries.forEach((e) => e.isIntersecting && reveal(e.target, "revealed", ob));
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        reveals.forEach((el) => revealObserver.observe(el));
      } else {
        // Fallback: show everything in its final state immediately.
        stacks.forEach((el) => el.classList.add("in-view"));
        reveals.forEach((el) => el.classList.add("revealed"));
      }
    </script>
  </body>
</html>
