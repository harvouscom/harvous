---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DownloadCTA from "../../components/DownloadCTA.astro";
import { Icon } from "astro-icon/components";

const accent = { bg: "var(--color-peach)", ink: "var(--color-peach-ink)" };

const moments = [
  {
    icon: "fa6-solid:book-open",
    heading: "A space just for this study",
    body: "Everything about your Romans study — or Genesis, or John — in one place. Notes, threads per chapter, highlights, scripture references. Nothing shares space with your other study.",
  },
  {
    icon: "fa6-solid:book-bible",
    heading: "Scripture pills that go deep",
    body: "Every reference links out in one tap. Cross-reference a verse in Romans to something in Galatians and read it right there, in whichever of the 7 translations you prefer.",
  },
  {
    icon: "fa6-solid:diagram-project",
    heading: "Notes that live in multiple threads",
    body: "A note on justification can belong in your Romans thread and your theology thread at the same time. Because understanding doesn't stay in one category.",
  },
  {
    icon: "fa6-solid:book",
    heading: "Built-in dictionary",
    body: "Easton's Bible Dictionary is right there. You won't have to leave the note to look up a word — the definition comes to you.",
  },
];
---

<BaseLayout
  title="For book study — Harvous"
  description="Going deep on one book of the Bible? Harvous gives your study a home — notes, threads, scripture links, and a dictionary, all in one place."
>
  <!-- Hero -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-3xl px-5 py-16 md:py-24">
      <a
        href="/use-cases"
        class="inline-flex items-center gap-1.5 text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M14 8a.75.75 0 0 1-.75.75H3.56l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L3.56 7.25H13.25A.75.75 0 0 1 14 8Z" clip-rule="evenodd"/>
        </svg>
        Use cases
      </a>
      <div class="mt-6">
        <span
          class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
          style={`background: ${accent.bg}; color: ${accent.ink};`}
        >
          Book study
        </span>
      </div>
      <h1 class="mt-5 font-display text-4xl leading-[1.05] md:text-6xl">
        Going deep. One book, start to finish.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
        You're doing a real study of a book of the Bible — Romans, Genesis, John. Weeks or months of it. You're building understanding chapter by chapter, and you need somewhere to keep what you find so it compounds instead of disappears.
      </p>
    </div>
  </section>

  <!-- Feature moments -->
  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-10 sm:grid-cols-2">
      {moments.map((m) => (
        <div class="flex flex-col gap-4">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-xl"
            style={`background: ${accent.bg};`}
          >
            <Icon name={m.icon} class="h-5 w-5" style={`color: ${accent.ink};`} />
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{m.heading}</h3>
            <p class="mt-2 text-[var(--color-ink-soft)] leading-relaxed">{m.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Quote -->
  <section class="fade-rule-y">
    <div class="mx-auto max-w-2xl px-5 py-16 text-center">
      <blockquote class="font-display text-3xl leading-snug md:text-4xl">
        "Looking forward to continuing to use it to <mark>help in my study</mark>."
      </blockquote>
      <figcaption class="mt-6 text-sm italic text-[var(--color-ink-soft)]">&mdash;Theo, Nov 2025</figcaption>
    </div>
  </section>

  <DownloadCTA />
</BaseLayout>
