---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DownloadCTA from "../../components/DownloadCTA.astro";
import { Icon } from "astro-icon/components";

const accent = { bg: "var(--color-lilac)", ink: "var(--color-lilac-ink)" };

const moments = [
  {
    icon: "fa6-solid:folder",
    heading: "One thread per sermon series",
    body: "A thread called \"Romans — Sunday series\" collects every week of notes. Scroll back and see the whole arc. Week one connects to week eight because they're in the same place.",
  },
  {
    icon: "fa6-solid:tags",
    heading: "Auto-tagging connects the dots",
    body: "Write about \"faith\" in week three and Harvous files it with other notes where that word matters. Cross-series connections surface on their own — no manual organizing needed.",
  },
  {
    icon: "fa6-solid:highlighter",
    heading: "Highlights save the phrases",
    body: "That line the pastor said that you underlined — it's a highlight now, with a color and an annotation you can add later. Your highlighted phrases stay linked to the note they came from.",
  },
  {
    icon: "fa6-solid:magnifying-glass",
    heading: "Search that actually works",
    body: "Half-remember something from two months ago? Start typing what you remember. Harvous searches across all your threads and notes. You'll find it.",
  },
];
---

<BaseLayout
  title="For sermon notes — Harvous"
  description="Sunday thoughts have a habit of fading by Monday. Harvous keeps your sermon notes organized, searchable, and connected to each other across series."
>
  <!-- Hero -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-3xl px-5 py-16 md:py-24">
      <a
        href="/use-cases"
        class="inline-flex items-center gap-1.5 text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M14 8a.75.75 0 0 1-.75.75H3.56l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L3.56 7.25H13.25A.75.75 0 0 1 14 8Z" clip-rule="evenodd"/>
        </svg>
        Use cases
      </a>
      <div class="mt-6">
        <span
          class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
          style={`background: ${accent.bg}; color: ${accent.ink};`}
        >
          Sermon notes
        </span>
      </div>
      <h1 class="mt-5 font-display text-4xl leading-[1.05] md:text-6xl">
        Sunday thoughts have a habit of disappearing by Monday.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
        You take notes at church. Maybe in your phone, maybe on the bulletin, maybe in a journal you bring. The notes exist — somewhere. But they don't connect to each other, and two months later you couldn't find them if you tried.
      </p>
    </div>
  </section>

  <!-- Feature moments -->
  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-10 sm:grid-cols-2">
      {moments.map((m) => (
        <div class="flex flex-col gap-4">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-xl"
            style={`background: ${accent.bg};`}
          >
            <Icon name={m.icon} class="h-5 w-5" style={`color: ${accent.ink};`} />
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{m.heading}</h3>
            <p class="mt-2 text-[var(--color-ink-soft)] leading-relaxed">{m.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Quote -->
  <section class="fade-rule-y">
    <div class="mx-auto max-w-2xl px-5 py-16 text-center">
      <blockquote class="font-display text-3xl leading-snug md:text-4xl">
        "Harvous is <mark>simple and efficient</mark> compared to other apps I've tried."
      </blockquote>
      <figcaption class="mt-6 text-sm italic text-[var(--color-ink-soft)]">&mdash;Teaella, Apr 2026</figcaption>
    </div>
  </section>

  <DownloadCTA />
</BaseLayout>
