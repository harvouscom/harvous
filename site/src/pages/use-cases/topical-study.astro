---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DownloadCTA from "../../components/DownloadCTA.astro";
import { Icon } from "astro-icon/components";

const accent = { bg: "var(--color-accent-soft)", ink: "var(--color-accent)" };

const moments = [
  {
    icon: "fa6-solid:bookmark",
    heading: "A thread for the theme",
    body: "One thread called \"Grace\" (or \"Names of God\" or \"Prayer\"). Add notes from wherever you are in Scripture — Genesis, the Psalms, Paul's letters — and they all live there.",
  },
  {
    icon: "fa6-solid:tags",
    heading: "Auto-tagging surfaces connections you didn't plan",
    body: "Add a note on Ephesians 2 and Harvous tags themes that connect it to what you wrote in Psalms. Patterns you weren't looking for start to show up.",
  },
  {
    icon: "fa6-solid:layer-group",
    heading: "Many notes, one thread",
    body: "Notes from different books, different weeks, different moments — all pulled into one thread by what they're actually about. The thread becomes the record of your chase.",
  },
  {
    icon: "fa6-solid:magnifying-glass",
    heading: "Search by what you were thinking",
    body: "You wrote about \"unmerited favor\" at some point. Even if you didn't tag it that way, searching for it finds it. Your words, your language — Harvous doesn't require you to organize perfectly.",
  },
];
---

<BaseLayout
  title="For topical study — Harvous"
  description="Following a theme wherever it goes in Scripture? Harvous keeps all your notes on grace, prayer, or any topic together — no matter where in the Bible they came from."
>
  <!-- Hero -->
  <section class="border-b border-[var(--color-rule)]">
    <div class="mx-auto max-w-3xl px-5 py-16 md:py-24">
      <a
        href="/use-cases"
        class="inline-flex items-center gap-1.5 text-sm text-[var(--color-ink-soft)] hover:text-[var(--color-ink)]"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M14 8a.75.75 0 0 1-.75.75H3.56l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L3.56 7.25H13.25A.75.75 0 0 1 14 8Z" clip-rule="evenodd"/>
        </svg>
        Use cases
      </a>
      <div class="mt-6">
        <span
          class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
          style={`background: ${accent.bg}; color: ${accent.ink};`}
        >
          Topical study
        </span>
      </div>
      <h1 class="mt-5 font-display text-4xl leading-[1.05] md:text-6xl">
        Following a theme wherever it goes in Scripture.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
        You start noticing something. Grace shows up in Genesis, in Paul's letters, in the Psalms. Or you're tracing names of God, or following what Scripture says about prayer. You need somewhere that can hold a thread that runs across the whole Bible.
      </p>
    </div>
  </section>

  <!-- Feature moments -->
  <section class="mx-auto max-w-5xl px-5 py-20">
    <div class="grid gap-10 sm:grid-cols-2">
      {moments.map((m) => (
        <div class="flex flex-col gap-4">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-xl"
            style={`background: ${accent.bg};`}
          >
            <Icon name={m.icon} class="h-5 w-5" style={`color: ${accent.ink};`} />
          </div>
          <div>
            <h3 class="text-lg font-semibold text-[var(--color-ink)]">{m.heading}</h3>
            <p class="mt-2 text-[var(--color-ink-soft)] leading-relaxed">{m.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Quote -->
  <section class="fade-rule-y">
    <div class="mx-auto max-w-2xl px-5 py-16 text-center">
      <blockquote class="font-display text-3xl leading-snug md:text-4xl">
        "Harvous is <mark>simple and efficient</mark> compared to other apps I've tried."
      </blockquote>
      <figcaption class="mt-6 text-sm italic text-[var(--color-ink-soft)]">&mdash;Teaella, Apr 2026</figcaption>
    </div>
  </section>

  <DownloadCTA />
</BaseLayout>
