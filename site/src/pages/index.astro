---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCentered from "../components/HeroCentered.astro";
import ProductCard from "../components/ProductCard.astro";
import FounderLetter from "../components/FounderLetter.astro";
import Container from "../components/layout/Container.astro";

// Feature cards — copy + pills straight from the Figma "Home" frame. Screenshots
// are stand-ins from /app-preview; swap for fresh captures.
const cards = [
  {
    pills: ["note"],
    title: "Take notes like Google Docs",
    body: "Rich text formatting is, of course, there from creating headings to adding bullets, dividers, and links.",
    image: "/app-preview/hero.png",
    imageAlt: "Writing a note in Harvous with rich-text formatting",
  },
  {
    pills: ["scripture"],
    title: "Just type the reference",
    body: "Instead of a Bible reader just type the Scripture reference you want and open it. Available in 11 English translations.",
    image: "/app-preview/scripture.png",
    imageAlt: "A scripture reference opened inline with a translation picker",
  },
  {
    pills: ["highlight"],
    title: "Highlight text and annotate",
    body: "Select text to highlight and add an annotation. You can even do this within the Scripture you add.",
    image: "/app-preview/highlight.png",
    imageAlt: "A highlighted phrase with an annotation",
  },
  {
    pills: ["folder", "thread"],
    title: "Auto or manually organized",
    body: "Notes, by default, automatically organize into folders with tags. Manually connect notes together to create threads.",
    image: "/app-preview/folders.png",
    imageAlt: "Notes auto-organized into folders, with threads connecting them",
  },
] as const;
---

<BaseLayout>
  <HeroCentered />

  <!-- Intro heading + horizontal card carousel (matches the Figma frame). -->
  <section class="intro">
    <Container size="xl">
      <h2 class="intro__title" data-reveal>
        Harvous is a notes app<br class="hidden sm:block" /> made for Bible study
      </h2>
    </Container>

    <div class="cards" data-reveal style="--reveal-delay: 80ms;">
      <div class="cards__track">
        {cards.map((c) => (
          <ProductCard pills={c.pills} title={c.title} body={c.body} image={c.image} imageAlt={c.imageAlt} />
        ))}
      </div>
    </div>
  </section>

  <!-- Founder letter (closes the frame). -->
  <section class="letter">
    <Container size="md">
      <FounderLetter />
    </Container>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 6rem); }
  .intro__title {
    text-align: center;
    font-family: "Google Sans Flex", "Google Sans", ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-variation-settings: "wdth" 100, "ROND" 0;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  /* Horizontal carousel: first card aligns to the container's left edge, the
     row bleeds off the right. Scroll-snap on touch. */
  .cards {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-block: 0.5rem 1.5rem;
    padding-left: max(1.25rem, calc((100vw - 72rem) / 2));
    padding-right: 1.25rem;
  }
  .cards__track { display: flex; gap: 3rem; width: max-content; }
  .cards__track > :global(*) {
    flex: 0 0 clamp(300px, 82vw, 527px);
    scroll-snap-align: start;
  }

  .letter { padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 8vw, 6rem); }
</style>
