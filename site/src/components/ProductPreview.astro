---
// A hand-built CSS mock of the Harvous prototype shell. Stays in sync with brand
// tokens. Used in the hero — can be replaced with a real screenshot later by
// swapping this component for an <Image />.
---

<div class="relative">
  <!-- App frame -->
  <div class="overflow-hidden rounded-3xl border border-[var(--color-rule)] bg-white shadow-[var(--shadow-card)]">
    <!-- Title bar -->
    <div class="flex items-center gap-1.5 border-b border-[var(--color-rule)] bg-[var(--color-warm)] px-4 py-3">
      <span class="h-2.5 w-2.5 rounded-full bg-[#f1605d]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#f1bf4a]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#54c04a]"></span>
    </div>

    <div class="grid grid-cols-12 min-h-[420px]">
      <!-- Sidebar -->
      <aside class="col-span-3 border-r border-[var(--color-rule)] bg-[var(--color-paper)] p-4 hidden sm:flex sm:flex-col">
        <div class="mb-4">
          <div class="text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]">View</div>
          <div class="mt-2 flex flex-col gap-1 text-xs">
            <div class="rounded-md bg-white px-2 py-1.5 font-medium">Notes</div>
            <div class="px-2 py-1.5 text-[var(--color-ink-soft)]">Folders</div>
            <div class="px-2 py-1.5 text-[var(--color-ink-soft)]">Highlights</div>
            <div class="px-2 py-1.5 text-[var(--color-ink-soft)]">Scripture</div>
            <div class="px-2 py-1.5 text-[var(--color-ink-soft)]">Dictionary</div>
          </div>
        </div>
        <div class="mb-2 text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]">Recent</div>
        <div class="flex flex-col gap-2 text-xs">
          <div class="rounded-md px-2 py-1.5">
            <div class="truncate font-medium">Saved by grace</div>
            <div class="truncate text-[var(--color-ink-faint)]">Ephesians 2 · today</div>
          </div>
          <div class="rounded-md px-2 py-1.5">
            <div class="truncate font-medium">Sermon on the Mount</div>
            <div class="truncate text-[var(--color-ink-faint)]">Matthew 5–7 · yesterday</div>
          </div>
          <div class="rounded-md px-2 py-1.5">
            <div class="truncate font-medium">Fruits of the Spirit</div>
            <div class="truncate text-[var(--color-ink-faint)]">Galatians 5 · 2d</div>
          </div>
        </div>
        <!-- Today's Passage -->
        <div class="mt-auto pt-4">
          <div class="rounded-xl border border-[var(--color-rule)] bg-white px-3 py-2.5">
            <div class="text-[10px] text-[var(--color-ink-faint)]">Today's Passage</div>
            <div class="mt-0.5 flex items-center justify-between gap-1">
              <span class="text-xs font-semibold text-[var(--color-ink)]">Proverbs 3:11–12</span>
              <div class="flex items-center gap-1">
                <span class="flex h-5 w-5 items-center justify-center rounded-md bg-[var(--color-paper)] text-[10px] text-[var(--color-ink-soft)]">
                  <svg viewBox="0 0 16 16" fill="currentColor" class="h-2.5 w-2.5"><path d="M2 2h12v1.5H2V2zm0 3h12v1.5H2V5zm0 3h8v1.5H2V8zm8.5 2.5 3.5 3.5-3.5 3.5-1.06-1.06 2.44-2.44-2.44-2.44L10.5 10.5z"/></svg>
                </span>
                <span class="flex h-5 w-5 items-center justify-center rounded-md bg-[var(--color-paper)] text-[10px] text-[var(--color-ink-soft)]">+</span>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Note canvas -->
      <section class="col-span-12 sm:col-span-6 border-r border-[var(--color-rule)] bg-white p-6 flex flex-col">
        <div class="mb-1 text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]">Letters · Notes</div>
        <h3 class="mb-3 text-xl font-semibold">Saved by grace</h3>
        <p class="text-sm leading-relaxed text-[var(--color-ink)]">
          Paul tells the Ephesians they were once dead in trespasses, but now alive together with Christ. The pivot in
          <span class="relative mx-1 inline-flex items-center rounded-full bg-[var(--color-accent-soft)] px-2 py-0.5 text-[12px] font-medium text-[var(--color-accent)] ring-1 ring-[var(--color-accent)]/20">
            Ephesians 2:8
          </span>
          is the phrase
          <span class="bg-[var(--color-highlight)] px-0.5">by grace</span> — the unearned favor of God as the ground of salvation.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink)]">
          Compare with
          <span class="mx-1 inline-flex items-center rounded-full bg-[var(--color-accent-soft)] px-2 py-0.5 text-[12px] font-medium text-[var(--color-accent)] ring-1 ring-[var(--color-accent)]/20">Romans 3:24</span>
          which reads "justified by his grace as a gift" — the same logic in different words.
        </p>
        <div class="flex-1"></div>
        <div class="mt-4 rounded-xl border-2 border-[var(--color-highlight)] bg-white p-3 text-xs shadow-[0_8px_24px_-12px_rgba(20,18,12,0.15)]">
          <div class="mb-2 flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <svg viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3 text-[var(--color-ink-soft)]"><path d="M11.013 2.513a1.75 1.75 0 0 1 2.475 2.474L6.226 12.25l-2.743.556.556-2.743 7.974-7.55ZM2 14.25h12v1.5H2v-1.5Z"/></svg>
              <span class="text-[10px] font-semibold text-[var(--color-ink)]">Annotation</span>
            </div>
            <span class="h-3 w-3 rounded-full bg-[var(--color-highlight)] ring-1 ring-[#e0c878]/40"></span>
          </div>
          <p class="text-[12px] leading-relaxed text-[var(--color-ink)]">Grace = God's unearned favor. The opposite of merit. The engine of the gospel.</p>
          <div class="mt-2.5 border-t border-[var(--color-rule)] pt-2">
            <div class="text-[10px] text-[var(--color-ink-faint)]">Respond</div>
            <div class="mt-1 flex flex-wrap gap-1">
              <span class="rounded-full border border-[var(--color-rule)] px-2 py-0.5 text-[10px] text-[var(--color-ink-soft)]">What does this show about God?</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Dictionary / pill dock -->
      <aside class="col-span-12 sm:col-span-3 bg-[var(--color-paper)] p-4">
        <div class="mb-2 text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]">Dictionary</div>
        <div class="rounded-xl border border-[var(--color-rule)] bg-white p-3">
          <div class="text-sm font-semibold">Grace</div>
          <div class="mt-0.5 text-[11px] text-[var(--color-ink-faint)]">Easton's Bible Dictionary, 1897</div>
          <p class="mt-2 text-[12px] leading-relaxed text-[var(--color-ink-soft)]">
            (3.) God's forgiving mercy (Rom. 11:6; Eph. 2:5). (4.) The gospel as
            distinguished from the law (John 1:17; Rom. 6:14; 1 Pet. 5:12).
          </p>
        </div>
        <div class="mt-3 text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]">Translation</div>
        <div class="mt-2 flex flex-wrap gap-1.5 text-[11px]">
          <span class="rounded-full bg-[var(--color-ink)] px-2 py-0.5 text-white">ESV</span>
          <span class="rounded-full bg-white px-2 py-0.5 ring-1 ring-[var(--color-rule)]">KJV</span>
          <span class="rounded-full bg-white px-2 py-0.5 ring-1 ring-[var(--color-rule)]">NIV</span>
          <span class="rounded-full bg-white px-2 py-0.5 ring-1 ring-[var(--color-rule)]">NLT</span>
        </div>
      </aside>
    </div>
  </div>
</div>
