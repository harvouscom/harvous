---
// Three-up pastel feature cards, Craft-style. Each card has a soft pastel
// background, a centered display heading + tagline, and a hand-built floating
// UI mock that demonstrates the feature at a glance.
---

<section class="mx-auto max-w-6xl px-5 pt-0 pb-20">
  <div class="mx-auto max-w-5xl grid gap-5 md:grid-cols-3">
    <!-- Card 1: Linked references (sky) -->
    <article
      class="relative overflow-hidden rounded-3xl px-6 pt-12 pb-8 md:px-8 md:pt-14"
      style="background: var(--color-sky);"
    >
      <div class="relative z-10 text-center">
        <h2 class="font-display text-[1.6rem] leading-[1.05] md:text-[2rem]" style="color: var(--color-sky-ink);">
          Linked references
        </h2>
        <p class="mx-auto mt-3 max-w-[26ch] text-sm md:text-base" style="color: var(--color-sky-ink); opacity: 0.72;">
          Every scripture mention is a tap-able pill, linked to seven translations.
        </p>
      </div>

      <div class="relative mt-10 h-56 overflow-hidden">
        <!-- back card: translation switcher -->
        <div class="absolute left-1/2 top-32 w-[78%] -translate-x-1/2 overflow-hidden rotate-[-4deg] rounded-2xl bg-white/85 px-4 py-3 shadow-[0_10px_30px_-12px_rgba(20,18,12,0.25)] backdrop-blur-sm">
          <div class="text-[10px] font-semibold uppercase tracking-wider" style="color: var(--color-sky-ink); opacity: 0.6;">
            Translation
          </div>
          <div class="mt-2 flex gap-1.5 text-[11px] font-semibold">
            <span class="rounded-md px-2 py-1 text-white" style="background: var(--color-sky-ink);">ESV</span>
            <span class="rounded-md px-2 py-1" style="color: var(--color-sky-ink); opacity: 0.55;">KJV</span>
            <span class="rounded-md px-2 py-1" style="color: var(--color-sky-ink); opacity: 0.55;">NIV</span>
            <span class="rounded-md px-2 py-1" style="color: var(--color-sky-ink); opacity: 0.55;">NLT</span>
            <span class="rounded-md px-2 py-1" style="color: var(--color-sky-ink); opacity: 0.55;">NET</span>
          </div>
        </div>
        <!-- front card: sentence with pill -->
        <div class="absolute left-[44%] top-4 w-[82%] -translate-x-1/2 rotate-[2deg] rounded-2xl bg-white px-5 py-4 shadow-[0_18px_40px_-14px_rgba(20,18,12,0.28)]">
          <p class="text-sm leading-relaxed" style="color: var(--color-ink);">
            Compare with
            <span class="mx-0.5 inline-flex items-center rounded-md px-1.5 py-0.5 text-[12px] font-semibold" style="background: var(--color-accent-soft); color: var(--color-accent);">Romans 3:24</span>
            which reads "justified by his grace as a gift..."
          </p>
        </div>
      </div>
    </article>

    <!-- Card 2: Auto-organized folders & tags (lilac) -->
    <article
      class="relative overflow-hidden rounded-3xl px-6 pt-12 pb-8 md:px-8 md:pt-14"
      style="background: var(--color-lilac);"
    >
      <div class="relative z-10 text-center">
        <h2 class="font-display text-[1.6rem] leading-[1.05] md:text-[2rem]" style="color: var(--color-lilac-ink);">
          Sorts itself
        </h2>
        <p class="mx-auto mt-3 max-w-[26ch] text-sm md:text-base" style="color: var(--color-lilac-ink); opacity: 0.72;">
          Auto-folders and auto-tags organize every note — add your own anytime.
        </p>
      </div>

      <div class="relative mt-10 h-56">
        <!-- back: auto tag chip -->
        <div class="absolute right-3 top-[140px] rotate-[4deg] rounded-2xl bg-white/90 px-3 py-2 shadow-[0_8px_20px_-10px_rgba(20,18,12,0.25)] backdrop-blur-sm">
          <div class="flex items-center gap-1.5">
            <svg class="h-3 w-3" style="color: var(--color-lilac-ink);" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.937 15.5A2 2 0 0 1 8.523 14.914l-5.667-5.667a2 2 0 0 1-.586-1.414V3.5a1 1 0 0 1 1-1h4.333a2 2 0 0 1 1.414.586l5.667 5.667a2 2 0 0 1 0 2.828L11.351 14.914a2 2 0 0 1-1.414.586ZM6 5.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z" />
            </svg>
            <span class="text-[11px] font-semibold uppercase tracking-wider" style="color: var(--color-lilac-ink); opacity: 0.7;">Auto-tagged</span>
          </div>
          <div class="mt-1.5 flex flex-wrap gap-1">
            <span class="rounded-md px-1.5 py-0.5 text-[10px] font-medium" style="background: var(--color-lilac); color: var(--color-lilac-ink);">grace</span>
            <span class="rounded-md px-1.5 py-0.5 text-[10px] font-medium" style="background: var(--color-lilac); color: var(--color-lilac-ink);">faith</span>
            <span class="rounded-md px-1.5 py-0.5 text-[10px] font-medium" style="background: var(--color-lilac); color: var(--color-lilac-ink);">salvation</span>
          </div>
        </div>
        <!-- front: auto folders -->
        <div class="absolute left-1/2 -top-2 w-[86%] -translate-x-1/2 -rotate-[2deg] rounded-2xl bg-white p-4 shadow-[0_18px_40px_-14px_rgba(20,18,12,0.28)]">
          <div class="flex items-center justify-between">
            <div class="text-[10px] font-semibold uppercase tracking-wider" style="color: var(--color-lilac-ink); opacity: 0.6;">Folders</div>
            <div class="flex items-center gap-1 text-[9px] font-medium" style="color: var(--color-lilac-ink); opacity: 0.7;">
              <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 1.5l1.6 4.9h5.1l-4.1 3 1.6 4.9-4.2-3-4.2 3 1.6-4.9-4.1-3h5.1L10 1.5z" />
              </svg>
              Auto
            </div>
          </div>
          <div class="mt-2 space-y-1.5">
            <div class="flex items-center justify-between rounded-md px-2 py-1.5" style="background: rgba(20,18,12,0.025);">
              <div class="flex items-center gap-1.5">
                <svg class="h-3 w-3" style="color: var(--color-lilac-ink); opacity: 0.6;" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M2 5a2 2 0 0 1 2-2h3.5l2 2H16a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5Z" />
                </svg>
                <span class="text-[11px] font-medium" style="color: var(--color-ink);">Grace</span>
              </div>
              <span class="text-[10px]" style="color: var(--color-ink-faint);">12</span>
            </div>
            <div class="flex items-center justify-between rounded-md px-2 py-1.5" style="background: rgba(20,18,12,0.025);">
              <div class="flex items-center gap-1.5">
                <svg class="h-3 w-3" style="color: var(--color-lilac-ink); opacity: 0.6;" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M2 5a2 2 0 0 1 2-2h3.5l2 2H16a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5Z" />
                </svg>
                <span class="text-[11px] font-medium" style="color: var(--color-ink);">Ephesians study</span>
              </div>
              <span class="text-[10px]" style="color: var(--color-ink-faint);">8</span>
            </div>
            <div class="flex items-center justify-between rounded-md px-2 py-1.5" style="background: rgba(20,18,12,0.025);">
              <div class="flex items-center gap-1.5">
                <svg class="h-3 w-3" style="color: var(--color-lilac-ink); opacity: 0.6;" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M2 5a2 2 0 0 1 2-2h3.5l2 2H16a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5Z" />
                </svg>
                <span class="text-[11px] font-medium" style="color: var(--color-ink);">Romans</span>
              </div>
              <span class="text-[10px]" style="color: var(--color-ink-faint);">6</span>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- Card 3: Study highlights (highlight yellow) -->
    <article
      class="relative overflow-hidden rounded-3xl px-6 pt-12 pb-8 md:px-8 md:pt-14"
      style="background: var(--color-highlight);"
    >
      <div class="relative z-10 text-center">
        <h2 class="font-display text-[1.6rem] leading-[1.05] md:text-[2rem]" style="color: #7a5410;">
          Study highlights
        </h2>
        <p class="mx-auto mt-3 max-w-[26ch] text-sm md:text-base" style="color: #7a5410; opacity: 0.72;">
          Mark key phrases with color-coded highlights and personal annotations.
        </p>
      </div>

      <div class="relative mt-10 h-56">
        <!-- back: annotation chip -->
        <div class="absolute left-4 top-28 -rotate-[4deg] rounded-2xl bg-white/90 px-3 py-2 shadow-[0_10px_24px_-12px_rgba(20,18,12,0.25)] backdrop-blur-sm">
          <div class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider" style="color: #7a5410; opacity: 0.7;">
            <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: #7a5410;"></span>
            Annotation
          </div>
          <div class="mt-1 text-[12px]" style="color: var(--color-ink);">
            "By grace" — God's unearned favor
          </div>
        </div>
        <!-- front: highlighted text -->
        <div class="absolute right-2 top-2 w-[82%] rotate-[2deg] rounded-2xl bg-white p-4 shadow-[0_18px_40px_-14px_rgba(20,18,12,0.28)]">
          <p class="text-sm leading-relaxed" style="color: var(--color-ink);">
            We're saved
            <mark class="mark">by grace</mark>
            through faith — not by works of our own.
          </p>
        </div>
      </div>
    </article>
  </div>
</section>
