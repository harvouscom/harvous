---
interface Props {
  name: string;
  when: string;
  tone?: "peach" | "sky" | "mint" | "lilac" | "pink" | "cream";
}

const { name, when, tone = "lilac" } = Astro.props;

const tones: Record<string, [string, string]> = {
  peach: ["var(--color-peach)", "var(--color-peach-ink)"],
  sky: ["var(--color-sky)", "var(--color-sky-ink)"],
  mint: ["var(--color-mint)", "var(--color-mint-ink)"],
  lilac: ["var(--color-lilac)", "var(--color-lilac-ink)"],
  pink: ["var(--color-pink)", "var(--color-pink-ink)"],
  cream: ["var(--color-cream)", "var(--color-cream-ink)"],
};
const [bg, ink] = tones[tone] ?? tones.lilac;
const initial = name.trim().charAt(0).toUpperCase();
---

<figure class="testimonial-card" style={`--card-bg: ${bg}; --card-ink: ${ink};`}>
  <blockquote class="testimonial-quote">
    <slot />
  </blockquote>
  <figcaption class="testimonial-foot">
    <span class="testimonial-avatar">{initial}</span>
    <span>
      <span class="testimonial-name">{name}</span>
      <span class="testimonial-when">{when}</span>
    </span>
  </figcaption>
</figure>

<style>
  .testimonial-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--card-bg);
    color: var(--card-ink);
    border-radius: 1.25rem;
    padding: 1.4rem 1.4rem 1.25rem;
    box-shadow: 0 1px 2px rgba(20, 18, 12, 0.04), 0 14px 34px -18px rgba(20, 18, 12, 0.22);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .testimonial-card:hover {
    transform: translateY(-3px) rotate(-0.6deg);
    box-shadow: 0 1px 2px rgba(20, 18, 12, 0.05), 0 22px 44px -18px rgba(20, 18, 12, 0.28);
  }
  .testimonial-quote {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--card-ink);
  }
  .testimonial-quote :global(mark) {
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .testimonial-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .testimonial-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--card-ink) 16%, transparent);
    color: var(--card-ink);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .testimonial-name {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--card-ink);
  }
  .testimonial-when {
    display: block;
    font-size: 0.78rem;
    opacity: 0.72;
  }
</style>
