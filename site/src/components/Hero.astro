---
import CTAButton from "./CTAButton.astro";
---

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-5 pb-10 pt-10 md:pt-12">

    <!-- max-w-5xl aligns left edge with TriptychSection cards below -->
    <div class="mx-auto max-w-5xl">
      <div class="grid items-center gap-6 lg:grid-cols-[5fr_7fr] lg:gap-12">

        <!-- Copy -->
        <div class="text-center lg:text-left">
          <h1 class="font-display text-5xl leading-[1.0] tracking-tight lg:text-[5rem]">
            Create your <span class="whitespace-nowrap">study Bible.</span>
          </h1>
          <p class="mx-auto mt-6 max-w-md text-lg text-[var(--color-ink-soft)] md:text-xl lg:mx-0 lg:max-w-none">
            Notes and highlights <mark>linked to scripture</mark>, with a built-in dictionary. Seven translations. On web, Mac, iPhone, and iPad.
          </p>
          <div class="mt-7 flex items-center justify-center gap-3 lg:justify-start">
            <CTAButton href="https://app.harvous.com/sign-up" variant="primary" size="lg" external>
              Start for free
            </CTAButton>
            <CTAButton href="/features" variant="secondary" size="lg">
              See features
            </CTAButton>
          </div>
        </div>

        <!-- App preview image — wider than grid cell, slightly scaled, overflows right, clipped by section overflow-hidden -->
        <div class="relative lg:w-[calc(100%+25vw)] lg:origin-top-left lg:scale-[1.08]">
          <img
            src="/app-preview-mac.png"
            alt="Harvous app"
            class="w-full"
          />
        </div>

      </div>
    </div>
  </div>
</section>
