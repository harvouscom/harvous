    "series:schema": "tsx server/scripts/add-series-presentation-schema.ts",
    "series:schema:apply": "tsx server/scripts/add-series-presentation-schema.ts --apply",
    "shared-spaces:schema:additive": "tsx server/scripts/add-shared-spaces-schema.ts",
    "shared-spaces:preflight": "tsx server/scripts/preflight-canonical-space-notes.ts",
    "shared-spaces:backfill": "tsx server/scripts/backfill-canonical-space-notes.ts",
    "shared-spaces:db:push": "tsx server/scripts/shared-spaces-db-push.ts",
    "shared-spaces:verify": "tsx server/scripts/verify-canonical-space-notes.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/check-typecheck-baseline.mjs",
    "typecheck:baseline": "node scripts/check-typecheck-baseline.mjs --update",
    "perf:check": "node scripts/check-perf-budget.mjs",
    "perf:baseline": "node scripts/check-perf-budget.mjs --update",
    "lighthouse:perf": "node scripts/lighthouse-a11y.mjs --perf"
