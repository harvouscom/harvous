---
import "../styles/global.css";
import "@fontsource/reddit-sans/400.css";
import "@fontsource/reddit-sans/500.css";
import "@fontsource/reddit-sans/600.css";
import "@fontsource/reddit-mono/500.css";
import "@fontsource/reddit-mono/600.css";

interface Props {
  classNames?: string;
  title?: string;
}

const { classNames = '', title = 'Harvous' }: Props = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-[var(--color-light-paper)]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F3F2EC" />
    <!-- Apple specific tags for homescreen icons -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Harvous" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Development environment error suppression - MUST be first script -->
    <script is:inline>
      // Suppress errors immediately, before any other scripts run
      (function() {
        if (typeof window === 'undefined') return;
        
        // Debug: Log that error suppression is active
        console.log('[Error Suppression] Script loaded and active');
        
        const originalConsoleError = console.error;
        console.error = function(...args) {
          const message = String(args[0] || '');
          const fullMessage = args.map(String).join(' ');
          
          // Suppress __DEFINES__ errors
          if (message.includes('__DEFINES__') || fullMessage.includes('__DEFINES__') ||
              message.includes('env.mjs') || fullMessage.includes('env.mjs')) {
            return;
          }
          
          // Suppress DEV property errors
          if ((message.includes('Cannot read properties') || fullMessage.includes('Cannot read properties')) &&
              (message.includes("'DEV'") || fullMessage.includes("'DEV'") || 
               message.includes('reading \'DEV\'') || fullMessage.includes('reading \'DEV\''))) {
            return;
          }
          
          // Suppress MIME type errors - enhanced to catch CSS and .astro file errors
          if (message.includes('Failed to load module script') || 
              message.includes('MIME type') ||
              message.includes('Expected a JavaScript-or-Wasm module script') ||
              fullMessage.includes('Failed to load module script') ||
              fullMessage.includes('MIME type') ||
              fullMessage.includes('Expected a JavaScript-or-Wasm module script') ||
              // Catch specific file type errors
              (fullMessage.includes('.css') && fullMessage.includes('module script')) ||
              (fullMessage.includes('.astro') && fullMessage.includes('module script')) ||
              (fullMessage.includes('text/css') && fullMessage.includes('module script'))) {
            return;
          }
          
          originalConsoleError.apply(console, args);
        };
        
        const originalConsoleWarn = console.warn;
        console.warn = function(...args) {
          const message = String(args[0] || '');
          if (message.includes('Clerk: Clerk has been loaded with development keys') ||
              message.includes('Clerk: The <SignIn/>') ||
              (message.includes('script-src') && message.includes('was not explicitly set'))) {
            return;
          }
          originalConsoleWarn.apply(console, args);
        };
        
        // Catch unhandled errors and promise rejections - MUST be in capture phase
        window.addEventListener('error', function(event) {
          const message = String(event.message || '');
          const source = String(event.filename || event.target?.src || '');
          const fullError = message + ' ' + source;
          
          // Suppress MIME type and module script errors - be very aggressive
          if (message.includes('__DEFINES__') || 
              message.includes('env.mjs') ||
              (message.includes('Cannot read properties') && message.includes("'DEV'")) ||
              // Suppress ALL module script loading errors
              message.includes('Failed to load module script') ||
              message.includes('Expected a JavaScript-or-Wasm module script') ||
              message.includes('module script') ||
              message.includes('MIME type') ||
              // Suppress errors for .css and .astro files
              source.includes('.css') ||
              source.includes('.astro') ||
              fullError.includes('.css') ||
              fullError.includes('.astro')) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            return false;
          }
        }, true); // Capture phase - catch before other handlers
        
        window.addEventListener('unhandledrejection', function(event) {
          const reason = String(event.reason || '');
          const reasonStr = reason + ' ' + (event.reason?.stack || '');
          
          // Suppress MIME type errors in promise rejections
          if (reason.includes('__DEFINES__') || 
              reason.includes('env.mjs') ||
              (reason.includes('Cannot read properties') && reason.includes("'DEV'")) ||
              // Suppress ALL module script loading errors
              reason.includes('Failed to load module script') ||
              reason.includes('Expected a JavaScript-or-Wasm module script') ||
              reason.includes('module script') ||
              reason.includes('MIME type') ||
              reasonStr.includes('.css') ||
              reasonStr.includes('.astro')) {
            event.preventDefault();
            return false;
          }
        });
      })();
    </script>
    
    <!-- PWA startup optimization script - inlined for faster execution -->
    <script is:inline src="/scripts/pwa-startup.js"></script>
    
    <!-- Special tab interaction handler for first-touch optimization -->
    <script is:inline src="/scripts/tab-interaction-handler.js"></script>
  </head>
  <body
    class={`font-sans bg-[var(--color-light-paper)] min-h-screen ${classNames}`}
  >
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    background-color: var(--color-light-paper);
    -webkit-background-color: var(--color-light-paper);
  }
  
  /* iOS Safari specific fixes for status bar area */
  @supports (-webkit-touch-callout: none) {
    html {
      background-color: var(--color-light-paper) !important;
      -webkit-background-color: var(--color-light-paper) !important;
    }
    
    body {
      background-color: var(--color-light-paper) !important;
      -webkit-background-color: var(--color-light-paper) !important;
      /* Ensure background extends behind status bar */
      padding-top: env(safe-area-inset-top);
      min-height: calc(100vh + env(safe-area-inset-top));
    }
  }
  
  /* Ensure mobile browsers fill the entire screen */
  @media (max-width: 1159px) {
    html, body {
      min-height: 100vh;
      min-height: 100svh;
    }
    
    /* iOS specific mobile fixes */
    @supports (-webkit-touch-callout: none) {
      body {
        min-height: calc(100vh + env(safe-area-inset-top));
        min-height: calc(100svh + env(safe-area-inset-top));
      }
    }
  }
</style>
