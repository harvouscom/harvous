---
import "../styles/global.css";
import "sonner/dist/styles.css";
import ToastProvider from "@/components/react/ToastProvider.tsx";
import SquareButton from "@/components/SquareButton.astro";
import NewNotePanelSimple from "@/components/NewNotePanelSimple.astro";
import NewThreadPanelReact from "@/components/react/NewThreadPanel.tsx";
import NoteDetailsPanel from "@/components/react/NoteDetailsPanel.tsx";
import EditThreadPanel from "@/components/react/EditThreadPanel.tsx";
import DesktopPanelManager from "@/components/react/DesktopPanelManager.tsx";
import BottomSheetReact from "@/components/BottomSheetReact.astro";
import KeyboardShortcutsInit from "@/components/react/KeyboardShortcutsInit.tsx";
import PanelManagerWithContext from "@/components/react/PanelManagerWithContext.tsx";
import MobileBottomSheetWithContext from "@/components/react/MobileBottomSheetWithContext.tsx";
import PostHog from "@/components/posthog.astro";
import PostHogUserInit from "@/components/react/PostHogUserInit.tsx";
import UpgradeSuccessHandler from "@/components/react/UpgradeSuccessHandler.tsx";
import SyncManagerIsland from "@/components/react/SyncManagerIsland.tsx";
import { shouldShowMoreButton } from "@/utils/menu-options";
import { ClientRouter, fade } from "astro:transitions";
// Initialize toast utility globally
import "@/utils/toast";
import packageJson from '../../package.json';

interface Props {
  classNames?: string;
  title?: string;
  contentType?: "thread" | "note" | "space" | "dashboard" | "profile";
  contentId?: string;
  currentThread?: any;
  currentSpace?: any;
  currentNote?: any;
  userId?: string;
  userData?: {
    email?: string;
    name?: string;
    displayName?: string;
    userColor?: string;
  };
  founderLetterHtml?: string;
}

const { 
  classNames = '', 
  title = 'Harvous', 
  contentType = 'dashboard', 
  contentId, 
  currentThread, 
  currentSpace, 
  currentNote,
  userId,
  userData,
  founderLetterHtml = ''
}: Props = Astro.props;

// Extract noteType from currentNote for menu options
const noteType = currentNote?.noteType;

// Determine if More button should be shown (pass contentId to hide for unorganized thread)
const showMoreButton = shouldShowMoreButton(contentType, contentId);

// Extract publishable key in frontmatter (where import.meta works)
const publishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY || null;

---

<!doctype html>
<html lang="en" class="bg-[var(--color-light-paper)]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#F3F2EC" />
    <!-- Apple specific tags for homescreen icons -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Harvous" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Preconnect to external services - eliminates DNS/TCP/TLS latency -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://clerk.harvous.com" crossorigin />
    <link rel="dns-prefetch" href="https://us.posthog.com" />
    
    <!-- Preload critical font files to eliminate FOUT (Flash of Unstyled Text) -->
    <!-- These load in parallel with stylesheets, so fonts are ready when CSS is parsed -->
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/files/reddit-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/files/reddit-sans-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/files/reddit-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/files/reddit-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-mono@5.1.1/files/reddit-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Roundo is only used for specific headings, prefetch instead of preload to avoid "unused" warning -->
    <link rel="prefetch" href="/fonts/Roundo-Variable.ttf" as="font" type="font/ttf" crossorigin="anonymous" />

    <!-- Font CSS - loaded as external stylesheets that persist across view transitions -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/400.css" transition:persist />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/500.css" transition:persist />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/600.css" transition:persist />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-sans@5.1.1/700.css" transition:persist />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-mono@5.1.1/500.css" transition:persist />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/reddit-mono@5.1.1/600.css" transition:persist />
    
    <!-- Prefetch critical routes for faster navigation -->
    <link rel="prefetch" href="/" />
    <link rel="prefetch" href="/new-space" />
    <link rel="prefetch" href="/find" />
    <link rel="prefetch" href="/profile" />
    
    <!-- PostHog Analytics (Official Astro Integration) -->
    <PostHog />
    
    <!-- Performance Tracking Script -->
    <script is:inline>
      // Track page load performance after PostHog is initialized
      // Using window.posthog directly to avoid module import errors
      (function() {
        if (typeof window === 'undefined') {
          return;
        }

        // Helper function to capture events safely
        function captureEvent(eventName, properties) {
          try {
            if (window.posthog && typeof window.posthog.capture === 'function') {
              window.posthog.capture(eventName, properties);
            }
          } catch (error) {
            console.error('[PostHog] Error capturing event:', error);
          }
        }

        // Track page load metrics
        function trackPageLoad() {
          if (!window.posthog) {
            return;
          }

          try {
            // Track DOMContentLoaded time
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', function() {
                const domContentLoadedTime = performance.now();
                captureEvent('page_load_dom_content_loaded', {
                  load_time_ms: Math.round(domContentLoadedTime),
                  page_url: window.location.pathname,
                });
              });
            } else {
              // Already loaded
              const timing = performance.timing;
              if (timing && timing.domContentLoadedEventEnd && timing.navigationStart) {
                const domContentLoadedTime = timing.domContentLoadedEventEnd - timing.navigationStart;
                captureEvent('page_load_dom_content_loaded', {
                  load_time_ms: Math.round(domContentLoadedTime),
                  page_url: window.location.pathname,
                });
              }
            }

            // Track full page load time
            if (document.readyState === 'complete') {
              const timing = performance.timing;
              if (timing && timing.loadEventEnd && timing.navigationStart) {
                const loadTime = timing.loadEventEnd - timing.navigationStart;
                captureEvent('page_load_complete', {
                  load_time_ms: Math.round(loadTime),
                  page_url: window.location.pathname,
                });
              }
            } else {
              window.addEventListener('load', function() {
                const timing = performance.timing;
                const loadTime = timing && timing.loadEventEnd && timing.navigationStart
                  ? timing.loadEventEnd - timing.navigationStart
                  : performance.now();
                captureEvent('page_load_complete', {
                  load_time_ms: Math.round(loadTime),
                  page_url: window.location.pathname,
                });
              });
            }

            // Track First Contentful Paint if available
            if ('PerformanceObserver' in window) {
              try {
                const observer = new PerformanceObserver(function(list) {
                  for (var i = 0; i < list.getEntries().length; i++) {
                    var entry = list.getEntries()[i];
                    if (entry.name === 'first-contentful-paint') {
                      captureEvent('page_load_first_contentful_paint', {
                        fcp_ms: Math.round(entry.startTime),
                        page_url: window.location.pathname,
                      });
                      observer.disconnect();
                    }
                  }
                });
                observer.observe({ entryTypes: ['paint'] });
              } catch (e) {
                // PerformanceObserver not supported or failed
              }
            }
          } catch (error) {
            console.error('[PostHog] Error tracking page load:', error);
          }
        }

        // Wait for PostHog to be ready
        function checkPostHog() {
          if (window.posthog) {
            trackPageLoad();
          } else {
            setTimeout(checkPostHog, 100);
          }
        }

        // Start checking after a short delay
        setTimeout(checkPostHog, 200);
      })();
    </script>
    
    <!-- Enable View Transitions for client-side navigation -->
    <ClientRouter />
    
    <!-- Prefetch critical navigation paths when browser is idle -->
    <script is:inline>
      // Prefetch critical paths when browser is idle to avoid blocking initial load
      (function() {
        if (typeof window === 'undefined') return;
        
        const prefetchCriticalPaths = () => {
          const paths = ['/', '/new-space', '/find'];
          paths.forEach(path => {
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = path;
            document.head.appendChild(link);
          });
        };
        
        // Prefetch when browser is idle
        if ('requestIdleCallback' in window) {
          requestIdleCallback(prefetchCriticalPaths, { timeout: 2000 });
        } else {
          // Fallback for browsers without requestIdleCallback
          setTimeout(prefetchCriticalPaths, 1000);
        }
      })();
    </script>
    
    <!-- Critical CSS inlined for faster first paint -->
    <style>
      /* Essential styles to prevent layout shift */
      body {
        margin: 0;
        opacity: 1 !important;
        animation: none !important;
        background-color: var(--color-light-paper);
        font-display: swap;
      }
      /* High-priority animation optimizations */
      .thread-card, .note-card-placeholder, .close-tab-btn {
        will-change: transform;
        contain: content;
        touch-action: manipulation;
      }
    </style>
    
    <!-- PWA startup optimization script - inlined for faster execution -->
    <script is:inline src="/scripts/pwa-startup.js"></script>
    
    <!-- Special tab interaction handler for first-touch optimization -->
    <script is:inline src="/scripts/tab-interaction-handler.js"></script>
    
    <!-- Font Awesome removed - using inline SVGs via Icon component -->
    
    <!-- Clerk Error Handling -->
    <script is:inline>
      // Handle Clerk initialization errors gracefully
      window.addEventListener('error', (event) => {
        // Check if error is from Clerk timeout
        if (event.message && event.message.includes('Clerk') && event.message.includes('timeout')) {
          console.warn('[Clerk] Initialization timeout detected. App will continue to function, but authentication features may be limited.');
          // Prevent error from propagating to PostHog if it's just a timeout
          event.preventDefault();
        }
      });
      
      // Handle unhandled promise rejections from Clerk
      window.addEventListener('unhandledrejection', (event) => {
        const reason = event.reason?.message || String(event.reason || '');
        if (reason.includes('Clerk') && (reason.includes('timeout') || reason.includes('failed_to_load'))) {
          console.warn('[Clerk] Load timeout detected. App will continue to function.');
          // Prevent error from propagating
          event.preventDefault();
        }
      });
    </script>
    
    <!-- Avatar Manager Global Script -->
    <script is:inline src="/scripts/avatar-manager-global.js"></script>
    
    <!-- Profile Data Sync Script -->
    <script is:inline src="/scripts/profile-sync.js"></script>
    
    <!-- Clerk Publishable Key Global (for React Islands after View Transitions) -->
    <script is:inline define:vars={{ publishableKey }}>
      (function() {
        if (typeof window === 'undefined') return;
        // Make publishableKey available globally for React Islands
        // This ensures billing components work after View Transitions navigation
        window.CLERK_PUBLISHABLE_KEY = publishableKey || null;
      })();
    </script>
    
    <!-- Development environment fixes -->
    <script>
      // Only run in development
      // @ts-ignore
      if (import.meta.env.DEV) {
        // Override module script loading to handle MIME type issues
        const originalCreateElement = document.createElement;
        // @ts-ignore
        document.createElement = function(tagName) {
          const element = originalCreateElement.call(this, tagName);
          // @ts-ignore
          if (tagName === 'script' && element.type === 'module') {
            element.addEventListener('error', function(e) {
              // Don't prevent the error, but log it as a warning
              console.warn('Module script loading issue (development):', e);
            });
          }
          return element;
        };
        
        // Suppress specific MIME type errors in console
        const originalConsoleError = console.error;
        // @ts-ignore
        console.error = function(...args) {
          const message = args[0];
          if (typeof message === 'string' && 
              (message.includes('Failed to load module script') || 
               message.includes('MIME type'))) {
            console.warn('Development MIME type issue (suppressed):', ...args);
            return;
          }
          originalConsoleError.apply(console, args);
        };
      }
    </script>
    
    <!-- Tab functionality script -->
    <script is:inline src="/scripts/tabs/tab-manager.js"></script>
    
    <!-- iOS Haptics Polyfill - enables navigator.vibrate() on iOS 18+ -->
    <script>
      import('ios-vibrator-pro-max').catch(() => {
        // Polyfill failed to load, haptics will only work on Android
      });
    </script>
    
    <!-- Haptics Handler - Provides tactile feedback for button interactions -->
    <script is:inline src="/scripts/haptics-handler.js"></script>

  </head>
  <body
    class={`font-sans bg-[var(--color-light-paper)] ${classNames}`}
  >
    <ToastProvider client:load />
    <KeyboardShortcutsInit client:load />
    <PostHogUserInit client:load userId={userId} userData={userData} />
    <UpgradeSuccessHandler client:load />
    <SyncManagerIsland client:load userId={userId} />

    <div class="app-layout" transition:animate={fade({ duration: '0.1s' })}>
      <!-- Desktop Layout (1160px and wider) -->
      <div class="desktop-layout">
        <!-- Navigation Column -->
        <section class="layout-column">
          <div 
            slot="navigation" 
            class="layout-column"
            data-thread-id={currentThread?.id}
            data-thread-title={currentThread?.title}
            data-thread-color={currentThread?.color}
            data-thread-note-count={currentThread?.noteCount}
            data-thread-background-gradient={currentThread?.backgroundGradient}
            data-thread-space-id={currentThread?.spaceId}
            data-space-id={currentSpace?.id}
            data-space-title={currentSpace?.title}
            data-space-color={currentSpace?.color}
            data-space-item-count={currentSpace?.totalItemCount}
            data-space-background-gradient={currentSpace?.backgroundGradient}
            data-content-type={contentType}
            data-content-id={contentId}
            data-parent-thread-id={currentThread?.id}
            data-parent-thread-title={currentThread?.title}
            data-parent-thread-count={currentThread?.noteCount}
            data-parent-thread-background-gradient={currentThread?.backgroundGradient}
            data-parent-thread-color={currentThread?.color}
          >
            <slot name="navigation" />
          </div>
        </section>

        <!-- Main Column -->
        <section class="layout-column">
          <div class="layout-column">
            <slot name="main" />
          </div>
        </section>

        <!-- Additional Column -->
        <section class="layout-column desktop-additional-column">
          <slot name="additional">
            <!-- React Panel Management -->
            <div class="desktop-panel-container">
              <!-- SquareButtons (shown when no panel is open) -->
              <div id="square-buttons-container" class={`square-buttons-container ${showMoreButton ? 'square-buttons-container--with-more' : ''}`}>
                {showMoreButton && (
                  <SquareButton variant="More" withMenu={true} contentType={contentType} contentId={contentId} currentThreadId={currentThread?.id} noteType={noteType} />
                )}
                {contentType !== 'profile' && (
                  <SquareButton variant="Add" withMenu={true} />
                )}
              </div>
              <!-- React Panel Manager (wrapped with context provider) -->
              <!-- This renders both desktop and mobile panels in a single React tree -->
              <PanelManagerWithContext
                currentThread={currentThread}
                currentSpace={currentSpace}
                currentNote={currentNote}
                contentType={contentType}
                publishableKey={publishableKey}
                version={packageJson.version}
                client:load
              />
            </div>
          </slot>
        </section>
      </div>

      <!-- Mobile/Tablet Layout (below 1160px) -->
      <div class="mobile-layout">
        <!-- Navigation Column (Top) -->
        <div class="mobile-nav-slot">
          <slot name="mobile-navigation" />
        </div>
        
        <!-- Main Column (Middle) -->
        <div class="mobile-main">
          <slot name="main" />
        </div>
        
        <!-- Additional Column (Bottom) -->
        <div class="mobile-additional">
          <slot name="mobile-additional" />
        </div>

        <!-- Mobile Bottom Sheet (mounted here because .desktop-layout is display:none on mobile) -->
        <MobileBottomSheetWithContext
          currentThread={currentThread}
          currentSpace={currentSpace}
          currentNote={currentNote}
          contentType={contentType}
          publishableKey={publishableKey}
          founderLetterHtml={founderLetterHtml}
          version={packageJson.version}
          client:load
        />
      </div>
    </div>
  </body>
</html>


<!-- Service Worker Registration for PWA -->
<script is:inline src="/scripts/service-worker-manager.js"></script>

<!-- Pre-caching for offline reading -->
<script>
  import { precacheRecentContent } from '@/utils/precache-user-data';
  
  if (typeof window !== 'undefined') {
    // Check if already precached this session
    if (!sessionStorage.getItem('harvous-precached')) {
      // Helper to check if auth is ready
      function isAuthReady() {
        const cookies = document.cookie.split(';');
        const hasClerkCookie = cookies.some(cookie => 
          cookie.trim().startsWith('__clerk') || 
          cookie.trim().startsWith('__session')
        );
        const isProtectedRoute = !window.location.pathname.includes('/sign-in') && 
                                !window.location.pathname.includes('/sign-up');
        return hasClerkCookie || isProtectedRoute;
      }
      
      // Wait for auth to be ready, then pre-cache
      const checkAuthAndPrecache = () => {
        if (isAuthReady()) {
          // Use idle callback to avoid blocking page load
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => {
              precacheRecentContent().then(() => {
                sessionStorage.setItem('harvous-precached', 'true');
              }).catch(err => {
                console.warn('Pre-caching failed:', err);
              });
            }, { timeout: 5000 });
          } else {
            // Fallback for browsers without requestIdleCallback
            setTimeout(() => {
              precacheRecentContent().then(() => {
                sessionStorage.setItem('harvous-precached', 'true');
              }).catch(err => {
                console.warn('Pre-caching failed:', err);
              });
            }, 2000);
          }
        } else {
          // Retry after delay if auth not ready yet
          setTimeout(checkAuthAndPrecache, 1000);
        }
      };
      
      // Start checking after a short delay to let page load
      setTimeout(checkAuthAndPrecache, 500);
    }
  }
</script>

<!-- React islands re-hydration for View Transitions -->
<script>
  // Ensure React islands properly re-hydrate after View Transitions
  // This is especially important for navigation slot updates
  document.addEventListener('astro:after-swap', () => {
    // Astro automatically handles hydration, so we don't need to do anything here
    // The requestAnimationFrame was unnecessary - Astro handles timing correctly
  });
</script>

<!-- Astro Navigation Setup -->
<!-- Note: Navigation is now set up via KeyboardShortcutsInit component -->

<!-- Toast Initialization -->
<!-- Note: toast utility is imported in frontmatter and initializes automatically -->
<!-- The toast system has fallback handling, so no need to check/warn here -->
<!-- Toast Handler -->
<script is:inline src="/scripts/toast-handler.js"></script>

<!-- Custom Toast event listener -->
<script>
  window.addEventListener('showToast', (event) => {
    // @ts-ignore - event.detail is a CustomEvent detail
    const { message, type } = event.detail;
    if (window.toast && type in window.toast) {
      // @ts-ignore
      const toastMethod = window.toast[type];
      if (typeof toastMethod === 'function') {
        toastMethod(message);
      }
    } else {
      console.warn('Toast system not available to handle showToast event.');
    }
  });
</script>

<!-- Note: toast utility is also imported in frontmatter to initialize window.toast -->

<!-- Navigation History Script -->
<script is:inline src="/scripts/navigation/history-tracker.js" data-astro-rerun></script>

<!-- Selected Space Sync (ensures space selection persists across navigations) -->
<script is:inline data-astro-rerun>
  (function () {
    if (typeof window === 'undefined') return;

    var STORAGE_KEY = 'harvous-selected-space-id';
    var EVENT_NAME = 'harvousSelectedSpaceUpdated';

    function normalizeSpaceId(value) {
      if (!value) return null;
      var trimmed = String(value).trim();
      if (!trimmed || trimmed === 'home') return null;
      if (trimmed.charAt(0) === '/') trimmed = trimmed.slice(1);
      if (trimmed.charAt(trimmed.length - 1) === '/') trimmed = trimmed.slice(0, -1);
      return trimmed || null;
    }

    function persistSelectedSpace(spaceId) {
      if (!spaceId || spaceId.indexOf('space_') !== 0) return;
      try {
        window.localStorage.setItem(STORAGE_KEY, spaceId);
      } catch (e) {
        try {
          window.sessionStorage.setItem(STORAGE_KEY, spaceId);
        } catch (e2) {}
      }
      try {
        window.dispatchEvent(new CustomEvent(EVENT_NAME, { detail: { spaceId: spaceId } }));
      } catch (e3) {}
    }

    function syncSelectedSpace() {
      try {
        // Highest priority: explicit space context in the URL (e.g. opening a note from a space page)
        try {
          var params = new URLSearchParams(window.location.search || '');
          var fromQuery = normalizeSpaceId(params.get('space'));
          if (fromQuery && fromQuery.indexOf('space_') === 0) {
            persistSelectedSpace(fromQuery);
            return;
          }
        } catch (e0) {}

        // Fallback: if we're on a space page, use the stable navigation wrapper's data-space-id.
        // NOTE: `slot="navigation"` is not reliable at runtime with Astro View Transitions.
        var navEl = document.querySelector('[data-navigation-active=\"true\"][data-space-id]');
        if (!navEl) return;
        var spaceId = normalizeSpaceId(navEl.getAttribute('data-space-id'));
        if (!spaceId || spaceId.indexOf('space_') !== 0) return;
        persistSelectedSpace(spaceId);
      } catch (e) {
        // Non-critical: ignore storage/DOM failures
      }
    }

    syncSelectedSpace();
    document.addEventListener('astro:page-load', syncSelectedSpace);
    document.addEventListener('astro:after-swap', syncSelectedSpace);
  })();
</script>


<!-- Hide unorganized thread if it's been closed -->
<script is:inline src="/scripts/navigation/unorganized-handler.js"></script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    overflow: hidden; /* Prevent page-level scrolling */
    background-color: var(--color-light-paper);
    -webkit-background-color: var(--color-light-paper);
  }
  
  /* iOS Safari specific fixes for status bar area */
  @supports (-webkit-touch-callout: none) {
    html {
      background-color: var(--color-light-paper) !important;
      -webkit-background-color: var(--color-light-paper) !important;
    }
    
    body {
      background-color: var(--color-light-paper) !important;
      -webkit-background-color: var(--color-light-paper) !important;
      /* Remove padding from body - apply to content instead */
      min-height: 100vh;
    }
    
    /* Apply safe area padding to main content container instead of body */
    .app-layout {
      padding-top: env(safe-area-inset-top);
    }
  }
  
  /* Ensure mobile browsers fill the entire screen */
  @media (max-width: 1159px) {
    html, body {
      min-height: 100vh;
      min-height: 100svh;
    }
    
    /* iOS specific mobile fixes */
    @supports (-webkit-touch-callout: none) {
      body {
        min-height: 100vh;
        min-height: 100svh;
      }
    }
  }

  /* Mobile Drawer Responsive Styles */
  
  /* Hide desktop additional column on mobile */
  @media (max-width: 1159px) {
    .desktop-additional-column {
      display: none !important;
    }
    
    /* Ensure mobile drawer is visible */
    .mobile-drawer {
      display: block !important;
    }
  }
  
  /* Show desktop additional column on desktop */
  @media (min-width: 1160px) {
    .desktop-additional-column {
      display: block !important;
    }
    
    /* Hide mobile drawer on desktop */
    .mobile-drawer {
      display: none !important;
    }
  }
  
  /* Mobile drawer specific styles */
  .mobile-drawer {
