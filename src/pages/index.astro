                          <div class="empty-state-message">
                            <div style="font-family: var(--font-sans); font-weight: 600; color: #4a473d; font-size: 18px; line-height: 1.2;">
                              <p>So when's move-in day?</p>
                            </div>
                            <div style="font-family: var(--font-sans); font-weight: 400; color: #78766f; font-size: 14px; line-height: 1.3; max-width: 250px;">
                              <p>Add to your Harvous and this area will start to feel lived in.</p>
                            </div>
                          </div>
