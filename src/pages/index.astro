---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import CardStack from "@/components/CardStack.astro";
import TabNav from "@/components/TabNav.astro";
import NavigationColumnReact from "@/components/NavigationColumnReact.astro";
import MobileNavigation from "@/components/MobileNavigation.astro";
import { getAllThreadsWithCounts, getSpacesWithCounts, getMemberOfSpaces, getInboxCount, getContentItems } from "@/utils/dashboard-data";
import OrganizedContentList from "@/components/react/OrganizedContentList";
import { getThreadGradientCSS } from "@/utils/colors";
import MobileAdditional from "@/components/MobileAdditional.astro";

// Get user data from Clerk authentication
const auth = Astro.locals.auth();
const { userId } = auth;

// Auth redirect is now handled by middleware - no need to check here
// Type guard: middleware ensures userId exists, but TypeScript doesn't know this
if (!userId) {
  throw new Error('User ID is required but not found');
}

// Get cached user data (optimized - no API calls on every page load)
import { getCachedUserData, type CachedUserData } from '@/utils/user-cache';

// Fetch navigation and content data in parallel
let threads: any[] = [];
let spaces: any[] = [];
let inboxCount: number = 0;
let contentItems: any[] = [];
let userData: CachedUserData = {
  firstName: '',
  lastName: '',
  email: '',
  initials: 'U',
  displayName: 'User',
  userColor: 'paper',
};

try {
    // Await user data first so new users get onboarding thread created before we fetch threads
    userData = await getCachedUserData(userId).catch(() => ({
      firstName: '',
      lastName: '',
      email: '',
      initials: 'U',
      displayName: 'User',
      userColor: 'paper',
    }));

    // Then fetch threads, spaces, member-of spaces, inbox in parallel (onboarding thread now exists for new users)
    const [threadsData, spacesData, memberOfData, inboxCountData] = await Promise.allSettled([
      getAllThreadsWithCounts(userId),
      getSpacesWithCounts(userId),
      getMemberOfSpaces(userId),
      getInboxCount(userId),
    ]);

    // Extract results from Promise.allSettled
    threads = threadsData.status === 'fulfilled' ? threadsData.value : [];
    const ownedSpaces = spacesData.status === 'fulfilled' ? spacesData.value : [];
    const memberOfSpaces = memberOfData.status === 'fulfilled' ? memberOfData.value : [];
    inboxCount = inboxCountData.status === 'fulfilled' ? inboxCountData.value : 0;

    const joinedSpaces = (memberOfSpaces || []).map((m: { id: string; title: string | null; color: string | null; memberCount: number }) => ({
      id: m.id,
      title: m.title || 'Untitled space',
      color: m.color,
      totalItemCount: m.memberCount,
      backgroundGradient: getThreadGradientCSS(m.color || 'paper'),
    }));
    spaces = [
      ...ownedSpaces.map((space: any) => ({
        ...space,
        backgroundGradient: space.backgroundGradient || getThreadGradientCSS(space.color || 'blue'),
      })),
      ...joinedSpaces,
    ];

    // Fetch content items with threads passed in to avoid duplicate query
    try {
      contentItems = await getContentItems(userId, 30, 0, true, threads);
    } catch (error) {
      console.error("Error fetching content items:", error);
      contentItems = [];
    }

    // Ensure threads have backgroundGradient property for consistency
    threads = threads.map(thread => ({
      ...thread,
      backgroundGradient: thread.backgroundGradient || getThreadGradientCSS(thread.color || 'blue')
    }));
} catch (error) {
  console.error("Error fetching dashboard data:", error);
  
  // Fallback to empty data if database fails
  threads = [];
  spaces = [];
  inboxCount = 0;
  contentItems = [];
}

// Add HTTP caching headers for better performance (Netlify function optimization)
// Longer cache + stale-while-revalidate reduces function invocations on repeat visits
Astro.response.headers.set('Cache-Control', 'private, no-cache');

const { initials, userColor } = userData;

// Inbox count for navigation display
const inboxItemCount = inboxCount;

// Organized content for tabs
const organizedContent = Array.isArray(contentItems) ? contentItems : [];

// Timestamp when SSR data was generated - used by client to detect stale cached pages
const dataGeneratedAt = Date.now();
---

<Layout 
  title="Harvous" 
  contentType="dashboard" 
  currentThread={null} 
  currentSpace={null}
  userId={userId}
  userData={{
    email: userData.email,
    name: `${userData.firstName} ${userData.lastName}`.trim(),
    displayName: userData.displayName,
    userColor: userData.userColor,
  }}
>
  <!-- Navigation Column -->
  <NavigationColumnReact 
    slot="navigation"
    inboxCount={inboxItemCount}
    spaces={spaces}
    activeThread={null}
    currentSpace={null}
    isNote={false}
    currentId={undefined}
    showProfile={false}
    initials={initials}
    userColor={userColor}
  />

  <!-- Mobile Navigation -->
  <div slot="mobile-navigation">
    <MobileNavigation 
      spaces={spaces}
      threads={threads}
      inboxCount={inboxItemCount}
      currentSpace={null}
      currentThread={null}
      initials={initials}
      userColor={userColor}
    />
  </div>

  <!-- Main Column -->
  <div slot="main" class="h-full min-h-0 overflow-hidden" id="dashboard-content" data-navigation-item="dashboard" data-title="My Home" data-count={inboxItemCount} data-background-gradient="var(--color-paper)">
              <CardStack title="My Home" subtitle="" headerBgColor="var(--color-paper)">
                  <div class="flex flex-col gap-3">
                  <!-- TabNav Group -->
                  <div class="flex flex-col">
                    <!-- TabNav - All/Threads/Notes/Scripture -->
                    <TabNav 
                      tabs={[
                        { id: "all", label: "All", isActive: true },
                        { id: "threads", label: "Threads", isActive: false },
                        { id: "notes", label: "Notes", isActive: false },
                        { id: "scripture", label: "Scripture", isActive: false }
                      ]}
                      class="content-tabs"
                    />
                    
                    <!-- All Content -->
                    <div class="organized-content flex flex-col" data-tab-content="all">
                      <OrganizedContentList
                        initialItems={organizedContent}
                        filter="all"
                        userId={userId}
                        dataGeneratedAt={dataGeneratedAt}
                        client:load
                      />
                    </div>

                    <!-- Threads Only Content -->
                    <div class="organized-content flex flex-col hidden" data-tab-content="threads">
                      <OrganizedContentList
                        initialItems={organizedContent.filter(item => item.type === 'thread')}
                        filter="threads"
                        userId={userId}
                        dataGeneratedAt={dataGeneratedAt}
                        client:load
                      />
                    </div>

                    <!-- Notes Only Content -->
                    <div class="organized-content flex flex-col hidden" data-tab-content="notes">
                      <OrganizedContentList
                        initialItems={organizedContent.filter((item: any) => item?.type === 'note' && (item?.noteType === 'default' || !item?.noteType))}
                        filter="notes"
                        userId={userId}
                        dataGeneratedAt={dataGeneratedAt}
                        client:load
                      />
                    </div>

                    <!-- Scripture Only Content -->
                    <div class="organized-content flex flex-col hidden" data-tab-content="scripture">
                      <OrganizedContentList
                        initialItems={organizedContent.filter((item: any) => item?.type === 'note' && item?.noteType === 'scripture')}
                        filter="scripture"
                        userId={userId}
                        dataGeneratedAt={dataGeneratedAt}
                        client:load
                      />
                    </div>
                </div>
              </div>
              </CardStack>
  </div>


  <!-- Mobile Additional -->
  <div slot="mobile-additional">
    <MobileAdditional contentType="dashboard" currentSpace={null} />
  </div>


</Layout>

<!-- Initialize navigation cache with server-rendered data -->
<script is:inline define:vars={{ threads, spaces, inboxItemCount }}>
  (function() {
    if (typeof window === 'undefined') return;
    
    // Inline cache initialization to avoid import issues
    const CACHE_KEY = 'harvous_navigation_cache';
    
    function setCachedNavigationData(data) {
      try {
        const cacheData = {
          threads: data.threads || [],
          spaces: data.spaces || [],
          inboxCount: data.inboxCount || 0,
          timestamp: Date.now()
        };
        localStorage.setItem(CACHE_KEY, JSON.stringify(cacheData));
      } catch (error) {
        console.warn('Failed to cache navigation data:', error);
      }
    }
    
    // Initialize cache with server-rendered data
    setCachedNavigationData({ threads, spaces, inboxCount: inboxItemCount });
    
    // Re-initialize after View Transitions (debounced to avoid multiple calls)
    let navigationCacheTimeout = null;
    document.addEventListener('astro:page-load', () => {
      if (navigationCacheTimeout) clearTimeout(navigationCacheTimeout);
      navigationCacheTimeout = setTimeout(() => {
        setCachedNavigationData({ threads, spaces, inboxCount: inboxItemCount });
      }, 50);
    });
  })();
</script>
