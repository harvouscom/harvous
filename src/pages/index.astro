                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; width: 100%; text-align: center; padding-top: 64px; padding-bottom: 64px;">
                          <div class="empty-state-message">
                            <div style="font-family: var(--font-sans); font-weight: 600; color: #4a473d; font-size: 18px; line-height: 1.2;">
                              <p>So when's move-in day?</p>
                            </div>
                            <div style="font-family: var(--font-sans); font-weight: 400; color: #78766f; font-size: 14px; line-height: 1.3; max-width: 250px;">
                              <p>Add to your Harvous and this area will start to feel lived in.</p>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                    
                    <!-- Notes Only Content -->
                    <div class="organized-content flex flex-col hidden" data-tab-content="notes">
                      {organizedContent.filter((item: any) => item?.type === 'note' && (item?.noteType === 'default' || !item?.noteType)).length > 0 ? (
                        <OrganizedContentList 
                          initialItems={organizedContent.filter((item: any) => item?.type === 'note' && (item?.noteType === 'default' || !item?.noteType))}
                          filter="notes"
                          client:visible
                        />
                      ) : (
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; width: 100%; text-align: center; padding-top: 64px; padding-bottom: 64px;">
                          <div class="empty-state-message">
                            <div style="font-family: var(--font-sans); font-weight: 600; color: #4a473d; font-size: 18px; line-height: 1.2;">
                              <p>So when's move-in day?</p>
                            </div>
                            <div style="font-family: var(--font-sans); font-weight: 400; color: #78766f; font-size: 14px; line-height: 1.3; max-width: 250px;">
                              <p>Add to your Harvous and this area will start to feel lived in.</p>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                    
                    <!-- Scripture Only Content -->
                    <div class="organized-content flex flex-col hidden" data-tab-content="scripture">
                      {organizedContent.filter((item: any) => item?.type === 'note' && item?.noteType === 'scripture').length > 0 ? (
                        <OrganizedContentList 
                          initialItems={organizedContent.filter((item: any) => item?.type === 'note' && item?.noteType === 'scripture')}
                          filter="scripture"
                          client:visible
                        />
                      ) : (
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px; width: 100%; text-align: center; padding-top: 64px; padding-bottom: 64px;">
                          <div class="empty-state-message">
                            <div style="font-family: var(--font-sans); font-weight: 600; color: #4a473d; font-size: 18px; line-height: 1.2;">
                              <p>So when's move-in day?</p>
                            </div>
                            <div style="font-family: var(--font-sans); font-weight: 400; color: #78766f; font-size: 14px; line-height: 1.3; max-width: 250px;">
                              <p>Add to your Harvous and this area will start to feel lived in.</p>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                </div>
              </div>
              </CardStack>
  </div>


  <!-- Mobile Additional -->
  <div slot="mobile-additional">
    <MobileAdditional contentType="dashboard" currentSpace={null} />
  </div>


</Layout>

<!-- Initialize navigation cache with server-rendered data -->
<script is:inline define:vars={{ threads, spaces, inboxItemCount }}>
  (function() {
    if (typeof window === 'undefined') return;
    
    // Inline cache initialization to avoid import issues
    const CACHE_KEY = 'harvous_navigation_cache';
    const CACHE_DURATION = 30 * 1000; // 30 seconds
    
    function setCachedNavigationData(data) {
      try {
        const cacheData = {
          threads: data.threads || [],
          spaces: data.spaces || [],
          inboxCount: data.inboxCount || 0,
          timestamp: Date.now()
        };
        localStorage.setItem(CACHE_KEY, JSON.stringify(cacheData));
      } catch (error) {
        console.warn('Failed to cache navigation data:', error);
      }
    }
    
    // Initialize cache with server-rendered data
    setCachedNavigationData({ threads, spaces, inboxCount: inboxItemCount });
    
    // Re-initialize after View Transitions (debounced to avoid multiple calls)
    let navigationCacheTimeout = null;
    document.addEventListener('astro:page-load', () => {
      // Debounce to avoid multiple rapid calls
      if (navigationCacheTimeout) clearTimeout(navigationCacheTimeout);
      navigationCacheTimeout = setTimeout(() => {
        // Re-cache with current data
        setCachedNavigationData({ threads, spaces, inboxCount: inboxItemCount });
      }, 50);
    });
  })();
</script>

<!-- Update inbox/archive auto text based on active tab -->
<script is:inline>
  function updateInboxArchiveText() {
    // Find all inbox-archive-tabs instances (works for both desktop and mobile)
    const inboxArchiveTabs = document.querySelectorAll('.inbox-archive-tabs');
    
    inboxArchiveTabs.forEach(function(tabContainer) {
      const inboxButton = tabContainer.querySelector('[data-tab-id="inbox"]');
      const archiveButton = tabContainer.querySelector('[data-tab-id="archive"]');
      
      if (!inboxButton || !archiveButton) return;
      
      // Find text elements within the same parent container
      const parentContainer = tabContainer.parentElement;
      if (!parentContainer) return;
      
      const inboxText = parentContainer.querySelector('.inbox-auto-text');
      const archiveText = parentContainer.querySelector('.archive-auto-text');
      
      if (!inboxText || !archiveText) return;
      
      const isInboxActive = inboxButton.getAttribute('data-active') === 'true';
      
      if (isInboxActive) {
        inboxText.classList.remove('hidden');
        archiveText.classList.add('hidden');
      } else {
        inboxText.classList.add('hidden');
        archiveText.classList.remove('hidden');
      }
    });
  }
  
  // Update on page load
  if (typeof window !== 'undefined') {
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateInboxArchiveText);
    } else {
      updateInboxArchiveText();
    }
    
    // Listen for tab clicks on inbox-archive-tabs
    document.addEventListener('click', function(e) {
      const clickedTab = e.target.closest('.inbox-archive-tabs [data-tab-button]');
      if (clickedTab) {
        // Small delay to let tab-manager.js update the active state first
        setTimeout(updateInboxArchiveText, 10);
      }
    });
    
    // Also listen for View Transitions (debounced)
    let inboxArchiveTimeout = null;
    document.addEventListener('astro:page-load', function() {
      if (inboxArchiveTimeout) clearTimeout(inboxArchiveTimeout);
      inboxArchiveTimeout = setTimeout(updateInboxArchiveText, 50);
    });
  }
</script>

<!-- Trigger auto-archive on page load to ensure items older than 14 days are archived -->
<script is:inline>
  (function() {
    if (typeof window === 'undefined') return;
    
    // Track if we've already triggered auto-archive to avoid duplicate calls
    let autoArchiveTriggered = false;
    
    // Trigger auto-archive in the background (fire-and-forget)
    // This ensures items older than 14 days get archived even if the scheduled job hasn't run
    function triggerAutoArchive() {
      // Only trigger once per page load
      if (autoArchiveTriggered) return;
      autoArchiveTriggered = true;
      
      // Use requestIdleCallback to avoid blocking page rendering
      const scheduleArchive = (callback) => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(callback, { timeout: 2000 });
        } else {
          setTimeout(callback, 1000);
        }
      };
      
      scheduleArchive(async () => {
        try {
          // Call auto-archive endpoint (authenticated users can trigger for their own items)
          const response = await fetch('/api/inbox/auto-archive', {
            method: 'POST',
            credentials: 'include'
          });
          
          if (!response.ok) {
            // Log error details for debugging
            const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
            console.error('Auto-archive failed:', {
              status: response.status,
              statusText: response.statusText,
              error: errorData
            });
            return;
          }
          
          const result = await response.json();
          
          if (result.archivedCount > 0) {
            // If items were archived, refresh the page to show updated inbox
            // Use View Transitions if available for smooth refresh
            if (document.startViewTransition) {
              document.startViewTransition(() => {
                window.location.reload();
              });
            } else {
              window.location.reload();
            }
          } else if (result.errors && result.errors.length > 0) {
            console.warn('Auto-archive completed with errors:', result.errors);
          }
        } catch (error) {
          // Log network errors and other exceptions
          console.error('Auto-archive trigger failed:', error);
        }
      });
    }
    
    // Trigger on initial page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', triggerAutoArchive);
    } else {
      triggerAutoArchive();
    }
    
    // Reset flag on View Transitions to allow re-triggering on navigation
    document.addEventListener('astro:page-load', function() {
      autoArchiveTriggered = false;
      // Debounce to avoid multiple rapid calls
      setTimeout(triggerAutoArchive, 100);
    });
  })();
</script>

<!-- Trigger auto-delete when archive tab is viewed to ensure items older than 30 days are deleted -->
<script is:inline>
  (function() {
    if (typeof window === 'undefined') return;
    
    // Track if we've already triggered auto-delete to avoid duplicate calls
    let autoDeleteTriggered = false;
    
    // Check if archive tab is currently visible
    function isArchiveTabVisible() {
      const archiveButton = document.querySelector('.inbox-archive-tabs [data-tab-id="archive"]');
      const archiveContent = document.querySelector('.archive-content');
      return archiveButton?.getAttribute('data-active') === 'true' || 
             (archiveContent && !archiveContent.classList.contains('hidden'));
    }
    
    // Trigger auto-delete in the background (fire-and-forget)
    // This ensures archived items older than 30 days get deleted even if the scheduled job hasn't run
    function triggerAutoDelete() {
      // Only trigger if archive tab is visible
      if (!isArchiveTabVisible()) return;
      
      // Only trigger once per page load
      if (autoDeleteTriggered) return;
      autoDeleteTriggered = true;
      
      // Use requestIdleCallback to avoid blocking page rendering
      const scheduleDelete = (callback) => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(callback, { timeout: 2000 });
        } else {
          setTimeout(callback, 1000);
        }
      };
      
      scheduleDelete(async () => {
        try {
          // Call auto-delete endpoint (authenticated users can trigger for their own items)
          const response = await fetch('/api/inbox/auto-delete', {
            method: 'POST',
            credentials: 'include'
          });
          
          if (!response.ok) {
            // Log error details for debugging
            const errorData = await response.json().catch(() => ({ error: 'Unknown error' }));
            console.error('Auto-delete failed:', {
              status: response.status,
              statusText: response.statusText,
              error: errorData
            });
            return;
          }
          
          const result = await response.json();
          
          if (result.deletedCount > 0) {
            // If items were deleted, refresh the page to show updated archive
            // Use View Transitions if available for smooth refresh
            if (document.startViewTransition) {
              document.startViewTransition(() => {
                window.location.reload();
              });
            } else {
              window.location.reload();
            }
          } else if (result.errors && result.errors.length > 0) {
            console.warn('Auto-delete completed with errors:', result.errors);
          }
        } catch (error) {
          // Log network errors and other exceptions
          console.error('Auto-delete trigger failed:', error);
        }
      });
    }
    
    // Trigger on initial page load if archive tab is visible
    function checkAndTriggerAutoDelete() {
      if (isArchiveTabVisible()) {
        triggerAutoDelete();
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAndTriggerAutoDelete);
    } else {
      checkAndTriggerAutoDelete();
    }
    
    // Reset flag on View Transitions to allow re-triggering on navigation
    document.addEventListener('astro:page-load', function() {
      autoDeleteTriggered = false;
      // Debounce to avoid multiple rapid calls
      setTimeout(checkAndTriggerAutoDelete, 100);
    });
    
    // Also trigger when archive tab is clicked
    document.addEventListener('click', function(e) {
      const clickedTab = e.target.closest('.inbox-archive-tabs [data-tab-button]');
      if (clickedTab) {
        const tabId = clickedTab.getAttribute('data-tab-id');
        if (tabId === 'archive') {
          // Small delay to let tab-manager.js update the active state first
          setTimeout(() => {
            autoDeleteTriggered = false; // Reset flag to allow triggering
            triggerAutoDelete();
          }, 100);
        }
      }
    });
  })();
</script>
