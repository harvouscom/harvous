---
export const prerender = false;
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import CardStack from "@/components/CardStack.astro";
import CardNote from "@/components/react/CardNote";
import CondensedNoteItem from "@/components/react/CondensedNoteItem";
import Button from "@/components/Button.astro";
import { db, Threads, Notes, NoteThreads, UserMetadata, eq, and, desc, asc } from 'astro:db';
import { sql } from 'astro:db';
import { isValidShareToken } from '@/utils/ids';
import { type ThreadColor } from '@/utils/colors';
import { ClientRouter } from "astro:transitions";
import circleQuestionIconRaw from "@fortawesome/fontawesome-free/svgs/solid/circle-question.svg?raw";

// Extract path from SVG
const circleQuestionPath = circleQuestionIconRaw.match(/<path d="([^"]+)"/)?.[1] || '';

// Get shareToken from URL params
const { shareToken } = Astro.params;

// Check if user is authenticated
const auth = Astro.locals.auth();
const { userId } = auth;
const isAuthenticated = !!userId;

// Initialize data
let thread = null;
let notes: any[] = [];
let creator = null;
let error = null;

// Validate share token format
if (!shareToken || !isValidShareToken(shareToken)) {
  error = 'invalid';
} else {
  // Fetch the thread by share token (must be public)
  thread = await db
    .select({
      id: Threads.id,
      title: Threads.title,
      subtitle: Threads.subtitle,
      color: Threads.color,
      isPublic: Threads.isPublic,
      shareToken: Threads.shareToken,
      createdAt: Threads.createdAt,
      userId: Threads.userId
    })
    .from(Threads)
    .where(and(
      eq(Threads.shareToken, shareToken),
      eq(Threads.isPublic, true)
    ))
    .get();

  if (!thread) {
    error = 'not_found';
  } else {
    // Set cache headers so link previews (messages, etc.) get fresh HTML and correct og:image when thread color/title changes
    Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

    // Fetch notes for the thread via junction table
    notes = await db.select({
      id: Notes.id,
      title: Notes.title,
      content: Notes.content,
      noteType: Notes.noteType,
      createdAt: Notes.createdAt,
      updatedAt: Notes.updatedAt,
      lastVisited: Notes.lastVisited,
    })
    .from(Notes)
    .innerJoin(NoteThreads, eq(NoteThreads.noteId, Notes.id))
    .where(and(eq(NoteThreads.threadId, thread.id), eq(Notes.contentEncrypted, false)))
    .orderBy(
      asc(sql`CASE WHEN ${Notes.lastVisited} IS NOT NULL THEN 0 ELSE 1 END`),
      desc(Notes.lastVisited),
      desc(Notes.updatedAt),
      desc(Notes.createdAt),
      asc(Notes.id)
    )
    .all();

    // Fetch creator info from UserMetadata
    const creatorData = await db
      .select({
        firstName: UserMetadata.firstName,
        lastName: UserMetadata.lastName,
        userColor: UserMetadata.userColor,
        profileImageUrl: UserMetadata.profileImageUrl
      })
      .from(UserMetadata)
      .where(eq(UserMetadata.userId, thread.userId))
      .get();

    // Generate initials and display name
    const firstName = creatorData?.firstName || '';
    const lastName = creatorData?.lastName || '';
    const firstInitial = firstName.charAt(0).toUpperCase();
    const lastInitial = lastName.charAt(0).toUpperCase();
    const displayName = firstName
      ? (lastName ? `${firstName} ${lastInitial}.` : firstName)
      : 'A Harvous User';

    creator = {
      firstName,
      displayName,
      userColor: creatorData?.userColor || 'paper'
    };
  }
}

// Get thread color for styling
const threadColor = (thread?.color || 'blue') as ThreadColor;

// Construct URLs for Open Graph (single default image for all shared threads)
const siteUrl = Astro.url.origin;
const shareUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = `${siteUrl}/og/thread-default.png`;

// Prepare meta data
const ogTitle = thread?.title ? `${thread.title} | Shared Thread` : 'Shared Thread';
const ogDescription = thread?.subtitle || `A Bible study thread${notes.length > 0 ? ` with ${notes.length} ${notes.length === 1 ? 'note' : 'notes'}` : ''} on Harvous`;
---

<EmptyLayout title={ogTitle}>
  <Fragment slot="head">
    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </Fragment>
  <div id="shared-thread-content" class="auth-page">
    <div class="auth-page__container">
      <!-- Left Column: Animated Mesh Gradient Background -->
      <div class="auth-page__video-section thread-colors-mesh-gradient">
        <div class="auth-page__video-overlay">
          <!-- Harvous logo (white) -->
          <a href="https://harvous.com" class="auth-page__logo-container">
            <svg
              width="28"
              height="40"
              viewBox="0 0 45 64"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="auth-page__logo"
              aria-label="Harvous"
            >
              <path d="M44.8037 63.9941H0.0078125V0H44.8037V63.9941ZM34.5645 31.168C25.6988 34.2637 18.5024 41.2949 15.3711 50.543L14.2842 53.752H34.5645V31.168ZM10.2471 37.8643C15.8921 29.2487 24.5827 23.0353 34.5645 20.4824V10.2393H10.2471V37.8643Z" fill="#fff"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Thread Content -->
      <div class="auth-page__form-section shared-page__content-section">
        <div class="shared-page__content">
          {error === 'invalid' || error === 'not_found' ? (
            <div class="shared-page__error">
              <div class="shared-page__error-icon">
                <svg width="48" height="48" viewBox="0 0 512 512" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d={circleQuestionPath} />
                </svg>
              </div>
              <h1 class="shared-page__error-title">This thread isn't available</h1>
              <p class="shared-page__error-message">
                Hmm, we can't find this thread. The link might have expired or the owner made it private.
              </p>
              <a href="https://harvous.com" class="shared-page__error-link">
                Learn more about Harvous
              </a>
            </div>
          ) : thread && (
            <>
              <!-- Creator info (above CardStack) -->
              <div class="shared-page__creator shared-page__fade-in" style="animation-delay: 0ms;">
                <p>Created by {creator?.displayName || 'A Harvous User'} on Harvous</p>
              </div>

              <!-- CardStack with notes and CTA -->
              <div class="shared-page__card-container shared-page__slide-up" style="animation-delay: 50ms;">
                <CardStack
                  title={thread.title}
                  headerBgColor={`var(--color-${threadColor})`}
                  centerTitle={true}
                >
                  <!-- Notes list (scrollable) -->
                  <div class="shared-page__notes-scroll">
                    {notes.length === 0 ? (
                      <div class="shared-page__notes-empty">
                        <p>No notes yet. Start adding thoughts as you read</p>
                      </div>
                    ) : (
                      <div class="shared-page__notes">
                        {notes.map((note, index) => (
                          <div
                            class="shared-page__note-item card-enter"
                            style={`animation-delay: ${150 + index * 50}ms;`}
                          >
                            {note.noteType === 'scripture' ? (
                              <CondensedNoteItem
                                client:load
                                title={note.title || 'Untitled Note'}
                                noteType="scripture"
                                href="#"
                                noteId={note.id}
                              />
                            ) : (
                              <CardNote
                                client:load
                                title={note.title || 'Untitled Note'}
                                content={note.content || ''}
                                noteType={note.noteType || 'default'}
                                noteId={note.id}
                              />
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>

                  <!-- CTA Button wrapper with toast -->
                  <div class="shared-page__cta-wrapper">
                    <!-- Toast notification (absolutely positioned above button) -->
                    <div id="shared-page-toast" class="shared-page__toast" aria-live="polite">
                      <span id="shared-page-toast-message"></span>
                    </div>

                    <!-- CTA Button (inside CardStack) -->
                    <Button
                      type="button"
                      id="add-to-harvous-btn"
                      class="shared-page__cta-button"
                      data-share-token={shareToken}
                      data-authenticated={isAuthenticated ? 'true' : 'false'}
                    >
                      <span class="shared-page__cta-text">Add to my Harvous</span>
                    </Button>
                  </div>
                </CardStack>
              </div>

              <!-- Footer text (below CardStack) -->
              <div class="shared-page__footer shared-page__fade-in" style="animation-delay: 200ms;">
                <p>Harvous is a notes app designed for Bible study.</p>
                <a href="https://harvous.com" target="_blank" rel="noopener noreferrer">Learn more on harvous.com</a>
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</EmptyLayout>

<!-- Enable View Transitions for client-side navigation -->
<ClientRouter />

<!-- Client-side script for Add to Harvous functionality -->
<script is:inline>
  (function() {
    const btn = document.getElementById('add-to-harvous-btn');
    const toastEl = document.getElementById('shared-page-toast');
    const toastMsgEl = document.getElementById('shared-page-toast-message');
    if (!btn) return;

    const shareToken = btn.dataset.shareToken;
    const isAuthenticated = btn.dataset.authenticated === 'true';

    // Toast helper function
    function showToast(message, type = 'info', duration = 2000) {
      if (!toastEl || !toastMsgEl) return;

      // Set message and type
      toastMsgEl.textContent = message;
      toastEl.className = 'shared-page__toast shared-page__toast--' + type + ' shared-page__toast--visible';

      // Auto-hide after duration
      if (duration > 0) {
        setTimeout(() => {
          toastEl.classList.remove('shared-page__toast--visible');
        }, duration);
      }
    }

    btn.addEventListener('click', async function() {
      if (!shareToken) return;

      // Disable button while processing
      btn.disabled = true;

      if (isAuthenticated) {
        // User is signed in - call API directly
        try {
          const response = await fetch('/api/shared/add-to-harvous', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ shareToken })
          });

          const data = await response.json();

          if (response.ok && data.success) {
            showToast('Added to your Harvous!', 'success', 0);
            const id = data.createdIds.threadId;
            const path = id.startsWith('thread_') ? '/thread/' + id.slice(7) : '/' + id;
            const absoluteUrl = window.location.origin + path;
            setTimeout(() => {
              window.location.replace(absoluteUrl);
            }, 800);
          } else {
            // Error - show toast
            showToast(data.error || 'Failed to add thread', 'error');
            btn.disabled = false;
          }
        } catch (error) {
          console.error('Error adding thread:', error);
          showToast('An error occurred', 'error');
          btn.disabled = false;
        }
      } else {
        // User is not signed in - store intent and redirect to sign-in
        try {
          const pendingData = {
            shareToken: shareToken,
            timestamp: Date.now()
          };
          sessionStorage.setItem('pendingSharedThreadAdd', JSON.stringify(pendingData));
        } catch (e) {
          console.error('[Shared Thread Page] Failed to store pending action:', e);
        }

        // Redirect to sign-in with return URL
        const currentUrl = window.location.href;
        const signInUrl = '/sign-in?redirect_url=' + encodeURIComponent(currentUrl);
        window.location.href = signInUrl;
      }
    });

    // Check for pending action on page load (after sign-in redirect)
    if (isAuthenticated) {
      try {
        const pendingStr = sessionStorage.getItem('pendingSharedThreadAdd');
        if (pendingStr) {
          const pending = JSON.parse(pendingStr);
          // Only process if it's recent (within 10 minutes) and matches this thread
          if (pending.shareToken === shareToken && (Date.now() - pending.timestamp) < 600000) {
            // Clear the pending action first
            sessionStorage.removeItem('pendingSharedThreadAdd');
            
            // Directly call the API instead of triggering button click
            // This ensures we can use the global toast system
            fetch('/api/shared/add-to-harvous', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ shareToken })
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                const id = data.createdIds.threadId;
                const path = (id.startsWith('thread_') ? '/thread/' + id.slice(7) : '/' + id) + '?toast=success&message=' + encodeURIComponent('Thread was added to your Harvous');
                window.location.replace(window.location.origin + path);
              } else {
                // Show error toast on current page
                if (window.toast) {
                  window.toast.error(data.error || 'Failed to add thread');
                }
              }
            })
            .catch(error => {
              console.error('[Shared Thread Page] Error adding thread:', error);
              if (window.toast) {
                window.toast.error('An error occurred');
              }
            });
          } else {
            // Clear stale pending action
            sessionStorage.removeItem('pendingSharedThreadAdd');
          }
        }
      } catch (e) {
        console.error('Error checking pending action:', e);
        sessionStorage.removeItem('pendingSharedThreadAdd');
      }
    }
  })();
</script>

<style is:global>
  /* Mesh gradient using all thread colors with subtle movement (from sign-in page) */
  .thread-colors-mesh-gradient {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
  }

  .thread-colors-mesh-gradient::before {
    content: '';
    position: absolute;
    top: -75%;
    left: -75%;
    width: 250%;
    height: 250%;
    background:
      radial-gradient(circle at 20% 30%, var(--color-blue) 0%, transparent 55%),
      radial-gradient(circle at 80% 20%, var(--color-purple) 0%, transparent 55%),
      radial-gradient(circle at 40% 70%, var(--color-pink) 0%, transparent 55%),
      radial-gradient(circle at 60% 80%, var(--color-orange) 0%, transparent 55%),
      radial-gradient(circle at 10% 60%, var(--color-yellow) 0%, transparent 55%),
      radial-gradient(circle at 90% 50%, var(--color-green) 0%, transparent 55%);
    background-size: 100% 100%;
    animation: mesh-movement 6s ease-in-out infinite;
    opacity: 0.8;
  }

  .thread-colors-mesh-gradient::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
      radial-gradient(circle at 70% 40%, var(--color-pink) 0%, transparent 50%),
      radial-gradient(circle at 30% 90%, var(--color-yellow) 0%, transparent 50%),
      radial-gradient(circle at 50% 10%, var(--color-blue) 0%, transparent 50%),
      radial-gradient(circle at 15% 50%, var(--color-green) 0%, transparent 50%),
      radial-gradient(circle at 85% 70%, var(--color-purple) 0%, transparent 50%),
      radial-gradient(circle at 60% 30%, var(--color-orange) 0%, transparent 50%);
    background-size: 100% 100%;
    animation: mesh-movement-reverse 7.5s ease-in-out infinite;
    opacity: 0.6;
  }

  /* Mobile: Blue to pink gradient with blend zone sliding side to side */
  @media (max-width: 1159px) {
    .thread-colors-mesh-gradient::before {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to right, var(--color-blue), var(--color-pink));
      background-size: 200% 100%;
      animation: mesh-gradient-slide 6s ease-in-out infinite;
      opacity: 0.9;
    }
    .thread-colors-mesh-gradient::after {
      opacity: 0;
    }
  }

  @keyframes mesh-gradient-slide {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes mesh-movement {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    16.66% {
      transform: translate(4%, 3%) scale(1.06);
    }
    33.33% {
      transform: translate(-3%, 4%) scale(1.08);
    }
    50% {
      transform: translate(-4%, -2%) scale(1.07);
    }
    66.66% {
      transform: translate(3%, -4%) scale(1.09);
    }
    83.33% {
      transform: translate(3%, 2%) scale(1.05);
    }
  }

  @keyframes mesh-movement-reverse {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    16.66% {
      transform: translate(-4%, -3%) scale(1.07);
    }
    33.33% {
      transform: translate(4%, -4%) scale(1.09);
    }
    50% {
      transform: translate(3%, 4%) scale(1.08);
    }
    66.66% {
      transform: translate(-3%, 3%) scale(1.06);
    }
    83.33% {
      transform: translate(-2%, -3%) scale(1.05);
    }
  }

  /* Override video overlay padding for 24px spacing */
  #shared-thread-content .auth-page__video-overlay {
    padding: 24px;
  }

  /* ==========================================================================
     Page Load Animations
     ========================================================================== */

  /* Fade in animation for text elements */
  @keyframes sharedPageFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .shared-page__fade-in {
    animation: sharedPageFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Slide up animation for CardStack - subtle "placed from bottom" feel */
  @keyframes sharedPageSlideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shared-page__slide-up {
    animation: sharedPageSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Note items wrapper - inherits card-enter from animations.css */
  .shared-page__note-item {
    /* card-enter class provides the animation */
    cursor: default;
  }

  /* Override any pointer cursor from child components */
  .shared-page__note-item * {
    cursor: default !important;
  }

  /* Desktop: lock page to viewport height */
  @media (min-width: 1160px) {
    #shared-thread-content {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
    }

    #shared-thread-content .auth-page__container {
      height: 100%;
      max-height: 100vh;
    }

    #shared-thread-content .auth-page__form-section {
      height: 100%;
      max-height: 100vh;
      overflow: hidden;
    }

    #shared-thread-content .shared-page__content-section {
      padding-top: 12px !important;
    }
  }

  /* Shared page content section */
  .shared-page__content-section {
    background-color: var(--color-light-paper) !important;
    padding: 0 !important;
  }

  /* Mobile: lock page to viewport height, no scrolling */
  @media (max-width: 1159px) {
    #shared-thread-content {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
    }

    #shared-thread-content .auth-page__container {
      height: 100%;
      max-height: 100vh;
    }

    #shared-thread-content .auth-page__form-section.shared-page__content-section {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      height: 100%;
      max-height: 100vh;
      overflow: hidden;
    }
  }

  .shared-page__content {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 0;
    min-height: 100%;
  }

  /* Mobile: constrain content to viewport height */
  @media (max-width: 1159px) {
    .shared-page__content {
      height: 100%;
      max-height: 100vh;
      overflow: hidden;
      justify-content: flex-start;
    }
  }

  /* Desktop: constrain content to viewport height */
  @media (min-width: 1160px) {
    .shared-page__content {
      height: 100%;
      max-height: 100vh;
      overflow: hidden;
      justify-content: flex-start;
      padding-top: 0;
    }
  }

  /* Creator info */
  .shared-page__creator {
    padding: 12px 0;
    text-align: center;
    width: 100%;
    flex-shrink: 0;
  }

  .shared-page__creator p {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-stone-grey);
    margin: 0;
    line-height: 1.5;
  }

  /* CardStack container */
  .shared-page__card-container {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 300px;
  }

  /* Mobile: constrain card container to fit within viewport */
  @media (max-width: 1159px) {
    .shared-page__card-container {
      min-height: 0;
      overflow: hidden;
      max-height: calc(100vh - 120px); /* Account for creator info and spacing */
    }
  }

  /* Desktop: allow CardStack to shrink to fit available space */
  @media (min-width: 1160px) {
    .shared-page__card-container {
      min-height: 0;
      overflow: hidden;
    }
  }

  /* Make CardStack fill container */
  .shared-page__card-container .card-stack {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .shared-page__card-container .card-stack__container {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .shared-page__card-container .card-stack__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .shared-page__card-container .card-stack__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .shared-page__card-container .card-stack__inner-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  /* Scrollable notes container */
  .shared-page__notes-scroll {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
  }

  /* Mobile: add padding-bottom to account for fixed button */
  @media (max-width: 1159px) {
    .shared-page__notes-scroll {
      padding-bottom: 72px; /* Space for fixed button (60px button + 12px spacing) */
    }
  }

  /* Desktop: remove max-height constraint, let flex handle it */
  @media (min-width: 1160px) {
    .shared-page__notes-scroll {
      max-height: none;
    }
  }

  /* Notes inside CardStack */
  .shared-page__notes {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shared-page__notes-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    color: var(--color-stone-grey);
    text-align: center;
  }

  .shared-page__notes-empty p {
    margin: 0;
    font-size: 14px;
  }

  /* Toast notification - absolutely positioned 12px above button */
  .shared-page__toast {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 20px;
    background: linear-gradient(168.707deg, rgba(255, 255, 255, 1.0) 11.711%, rgb(248, 248, 248) 71.325%);
    border-radius: 12px;
    box-shadow: 0px 7px 16px 0px rgba(0, 0, 0, 0.1), 0px 30px 30px 0px rgba(0, 0, 0, 0.09), 0px 67px 40px 0px rgba(0, 0, 0, 0.05);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-deep-grey);
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
