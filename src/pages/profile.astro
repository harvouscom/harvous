---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import CardStack from "@/components/CardStack.astro";
import NavigationColumnReact from "@/components/NavigationColumnReact.astro";
import MobileNavigation from "@/components/MobileNavigation.astro";
import MobileAdditional from "@/components/MobileAdditional.astro";
import { getAllThreadsWithCounts, getSpacesWithCounts, getMemberOfSpaces, getInboxCount } from "@/utils/dashboard-data";
import { getSeasonalXP, getLifetimeXP } from "@/utils/xp-system";
import { getSeasonDisplayName } from "@/utils/season-helpers";
import { getThreadGradientCSS } from "@/utils/colors";
import { getCachedUserData, type CachedUserData } from '@/utils/user-cache';
import { formatMonthYearUTC } from '@/utils/date-formatting';
import { db, UserMetadata, eq } from 'astro:db';
import ProfilePageReact from "@/components/ProfilePageReact.astro";
import ProfileContent from "@/components/profile/ProfileContent.astro";
import ProfileCardStackHeader from "@/components/react/ProfileCardStackHeader.tsx";
import { markdownToHtml } from '@/utils/markdown-to-html';
import founderLetterMarkdown from '@/data/about/founder-letter.md?raw';

// Get user data from Clerk authentication
const auth = Astro.locals.auth();
const { userId } = auth;

// Auth redirect is now handled by middleware - no need to check here
// Pages can still use userId for conditional rendering

if (!userId) {
  return Astro.redirect('/sign-in');
}

// Set cache headers to reduce function invocations on repeat visits
Astro.response.headers.set('Cache-Control', 'private, no-cache');

// Get cached user data
let userData: CachedUserData;
try {
  userData = await getCachedUserData(userId);
} catch (error) {
  // Fallback data
  userData = {
    firstName: '',
    lastName: '',
    email: '',
    initials: 'U',
    displayName: 'User',
    userColor: 'paper',
  };
}

const { firstName, lastName, email, initials, displayName, userColor, createdAt } = userData;

// Format join date in UTC so it is consistent across server timezones and PWA vs browser.
// Use formatMonthYearUTC (hard-coded MMM) so iOS PWA doesn't show full month name.
let joinDate: string;
if (createdAt) {
  joinDate = formatMonthYearUTC(new Date(createdAt));
} else {
  joinDate = formatMonthYearUTC(new Date());
}

// Fetch navigation data and church data
let spaces: any[] = [];
let initialMemberOfIds: string[] = [];
let threads: any[] = [];
let inboxCount: number = 0;
let seasonalXP: number = 0;
let lifetimeXP: number = 0;
let seasonName: string = '';
let churchData = {
  churchName: null as string | null,
  churchCity: null as string | null,
  churchState: null as string | null
};

try {
  const [spacesData, memberOfData, threadsData, inboxCountData, seasonalXPData, lifetimeXPData, userMetadata] = await Promise.all([
    getSpacesWithCounts(userId),
    getMemberOfSpaces(userId),
    getAllThreadsWithCounts(userId),
    getInboxCount(userId),
    getSeasonalXP(userId),
    getLifetimeXP(userId),
    db.select().from(UserMetadata).where(eq(UserMetadata.userId, userId)).get()
  ]);

  const ownedSpaces = spacesData.map(space => ({
    ...space,
    backgroundGradient: space.backgroundGradient || getThreadGradientCSS(space.color || 'blue')
  }));
  const joinedSpaces = (memberOfData || []).map((m: { id: string; title: string | null; color: string | null; memberCount: number }) => ({
    id: m.id,
    title: m.title || 'Untitled space',
    color: m.color,
    totalItemCount: m.memberCount,
    backgroundGradient: getThreadGradientCSS(m.color || 'paper'),
  }));
  spaces = [...ownedSpaces, ...joinedSpaces];
  initialMemberOfIds = (memberOfData || []).map((m: { id: string }) => m.id);
  threads = threadsData.map(thread => ({
    ...thread,
    backgroundGradient: thread.backgroundGradient || getThreadGradientCSS(thread.color || 'blue')
  }));
  inboxCount = inboxCountData;
  seasonalXP = seasonalXPData;
  lifetimeXP = lifetimeXPData;
  seasonName = getSeasonDisplayName();

  // Extract church data from UserMetadata
  if (userMetadata) {
    churchData = {
      churchName: userMetadata.churchName ?? null,
      churchCity: userMetadata.churchCity ?? null,
      churchState: userMetadata.churchState ?? null
    };
  }

} catch (error) {
  console.error("Error fetching navigation data:", error);
}

const contentType = "profile";
const contentId = "profile";

// Extract publishable key in frontmatter (where import.meta works)
const publishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY || null;

// Load and parse the founder letter markdown
// Use ?raw import to get the raw markdown content at build time
const founderLetterHtml = markdownToHtml(founderLetterMarkdown);
---

<Layout 
  title="Profile" 
  contentType={contentType} 
  contentId={contentId}
  userId={userId}
  userData={{
    email: userData.email,
    name: `${userData.firstName} ${userData.lastName}`.trim(),
    displayName: userData.displayName,
    userColor: userData.userColor,
  }}
  founderLetterHtml={founderLetterHtml}
>
  <!-- Navigation Column -->
  <NavigationColumnReact 
    slot="navigation"
    inboxCount={inboxCount}
    spaces={spaces}
    activeThread={null}
    currentSpace={null}
    isNote={false}
    currentId={undefined}
    showProfile={true}
    initials={initials}
    userColor={userColor}
  />

  <!-- Main Column -->
  <div slot="main" class="h-full flex flex-col">
    <CardStack 
      centerTitle={true}
      class="h-full"
      id="profile-cardstack"
    >
      <ProfileCardStackHeader 
        slot="header"
        initialColor={userColor}
        client:load
      />
      <ProfileContent joinDate={joinDate} seasonalXP={seasonalXP} seasonName={seasonName} />
      <!-- Spacer so last item scrolls above the floating logout button -->
      <div class="profile-logout-spacer" />
    </CardStack>
  </div>

  <ProfilePageReact
    slot="additional"
    displayName={displayName}
    userColor={userColor}
    joinDate={joinDate}
    seasonalXP={seasonalXP}
    lifetimeXP={lifetimeXP}
    seasonName={seasonName}
    firstName={firstName}
    lastName={lastName}
    spaces={spaces}
    initialMemberOfIds={initialMemberOfIds}
    churchData={churchData}
    publishableKey={publishableKey}
    founderLetterHtml={founderLetterHtml}
  />

  <!-- Mobile Navigation -->
  <div slot="mobile-navigation">
    <MobileNavigation 
      spaces={spaces}
      threads={threads}
      inboxCount={inboxCount}
      currentSpace={null}
      currentThread={null}
      initials={initials}
      userColor={userColor}
    />
  </div>

  <!-- Mobile Additional -->
  <div slot="mobile-additional">
    <MobileAdditional contentType="profile" contentId={contentId} currentThread={null} currentSpace={null} />
  </div>
  <!-- Logout is handled by event delegation in Layout.astro (click on #logout-button); sign-out runs on current page where Clerk is already loaded. -->
</Layout>
