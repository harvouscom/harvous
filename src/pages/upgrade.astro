---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import { getSubscriptionInfo } from "@/utils/subscription";
import { PricingTable } from "@clerk/astro/components";
import UpgradeButtonGroup from "@/components/react/UpgradeButtonGroup";
import UpgradeSuccessHandler from "@/components/react/UpgradeSuccessHandler";
import UpgradePageContent from "@/components/react/UpgradePageContent";

// Get user data from Clerk authentication
const auth = Astro.locals.auth();
const { userId } = auth;

if (!userId) {
  throw new Error('User ID is required but not found');
}

// Get subscription info (pass auth object to use has() method)
const subscriptionInfo = await getSubscriptionInfo(userId, auth);
---

<EmptyLayout title="Upgrade - Harvous">
  <UpgradeSuccessHandler client:load />
  <div id="upgrade-content" class="auth-page auth-page__hidden">
    <div class="auth-page__container">
      <!-- Top Row (Mobile) / Left Column (Desktop): Animated Gradient Background -->
      <div class="auth-page__video-section thread-colors-mesh-gradient">
        <div class="auth-page__video-overlay">
          <!-- Harvous logo -->
          <a href="https://harvous.com" class="auth-page__logo-container">
            <svg 
              width="45" 
              height="64" 
              viewBox="0 0 45 64" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
              class="auth-page__logo sign-in-logo"
              aria-label="Harvous"
            >
              <path d="M44.8037 63.9941H0.0078125V0H44.8037V63.9941ZM34.5645 31.168C25.6988 34.2637 18.5024 41.2949 15.3711 50.543L14.2842 53.752H34.5645V31.168ZM10.2471 37.8643C15.8921 29.2487 24.5827 23.0353 34.5645 20.4824V10.2393H10.2471V37.8643Z" fill="#fff"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Bottom Row (Mobile) / Right Column (Desktop): Upgrade Form -->
      <div class="auth-page__form-section">
        <div class="auth-page__form-wrapper">
          <!-- Server-rendered PricingTable for Clerk to hook into -->
          <!-- Keep visible (but off-screen) permanently - Clerk needs it visible to initialize buttons -->
          <!-- Using position: absolute with off-screen positioning, NOT visibility: hidden -->
          <div id="hidden-pricing-table" style="position: absolute; top: -9999px; left: -9999px; width: 400px; height: 600px; overflow: hidden; pointer-events: none; z-index: -1;">
            <PricingTable
              appearance={{
                elements: {
                  rootBox: "clerk-form-root",
                  card: {
                    className: "clerk-form-card",
                    style: {
                      border: "none",
                      borderWidth: "0",
                      overflowX: "hidden"
                    }
                  },
                  headerTitle: "clerk-form-header-title",
                  headerSubtitle: "clerk-form-header-subtitle",
                  buttonPrimary: "clerk-form-button-primary primary-button",
                  button: "primary-button"
                },
                variables: {
                  colorPrimary: "var(--color-bold-blue)"
                }
              }}
            />
          </div>

          <!-- Client-side component that updates dynamically -->
          <div class="clerk-form-card">
            <UpgradePageContent 
              client:load
              initialHasUnlimited={subscriptionInfo.hasUnlimited}
              initialCurrentCount={subscriptionInfo.currentCount}
              initialLimit={subscriptionInfo.limit}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</EmptyLayout>

<!-- Show upgrade content once page loads -->
<!-- Note: PricingTable stays visible (but off-screen) permanently so Clerk can initialize buttons -->
<script is:inline>
  (function() {
    if (typeof window === 'undefined') return;
    
    // Show the upgrade content
    var content = document.getElementById('upgrade-content');
    if (content) {
      content.classList.remove('auth-page__hidden');
    }
    
    // Ensure PricingTable mounts by waiting for Clerk to load
    function ensurePricingTableMounts() {
      var hiddenTable = document.getElementById('hidden-pricing-table');
      if (!hiddenTable) {
        setTimeout(ensurePricingTableMounts, 100);
        return;
      }
      
      // Better detection: Check multiple indicators that Clerk is ready
      var isClerkReady = false;
      
      // Check 1: Clerk's component props map exists
      if (window._astro_clerk_component_props) {
        isClerkReady = true;
      }
      
      // Check 2: Clerk's frontend API is loaded
      if (window.__clerk_frontend_api) {
        isClerkReady = true;
      }
      
      // Check 3: Clerk global object exists
      if (window.Clerk) {
        isClerkReady = true;
      }
      
      // Check 4: Clerk scripts are in the DOM
      var clerkScripts = document.querySelectorAll('script[src*="clerk"], script[src*="clerkjs"]');
      if (clerkScripts.length > 0) {
        isClerkReady = true;
      }
      
      if (isClerkReady) {
        // Clerk appears to be ready, try to mount components
        if (typeof window.mountAllClerkAstroJSComponents === 'function') {
          window.mountAllClerkAstroJSComponents();
          
          // Check if PricingTable has mounted (has buttons) after a delay
          setTimeout(function() {
            var hasButtons = hiddenTable.querySelector('button') !== null;
            if (!hasButtons && import.meta.env.PROD) {
              console.warn('[Clerk] PricingTable: mountAllClerkAstroJSComponents called but buttons not found');
              console.warn('[Clerk] Hidden table HTML length:', hiddenTable.innerHTML.length);
              console.warn('[Clerk] Clerk scripts in DOM:', document.querySelectorAll('script[src*="clerk"]').length);
            }
          }, 1000);
        } else if (import.meta.env.PROD) {
          console.warn('[Clerk] PricingTable: Clerk ready but mountAllClerkAstroJSComponents function not found');
        }
      } else {
        // Clerk not loaded yet, wait and retry (max 15 seconds)
        var attempts = 0;
        var maxAttempts = 150; // 15 seconds
        var checkInterval = setInterval(function() {
          attempts++;
          
          // Re-check all indicators
          var ready = window._astro_clerk_component_props || 
                     window.__clerk_frontend_api || 
                     window.Clerk ||
                     document.querySelectorAll('script[src*="clerk"]').length > 0;
          
          if (ready) {
            clearInterval(checkInterval);
            ensurePricingTableMounts();
          } else if (attempts >= maxAttempts) {
            clearInterval(checkInterval);
            console.warn('[Clerk] PricingTable: Clerk did not load within 15 seconds');
            console.warn('[Clerk] Checking for Clerk scripts...');
            var scripts = document.querySelectorAll('script[src*="clerk"], script[src*="clerkjs"]');
            console.warn('[Clerk] Clerk scripts found:', scripts.length);
            if (scripts.length === 0) {
              console.error('[Clerk] No Clerk scripts in DOM - @clerk/astro may not be injecting scripts in production');
            }
          }
        }, 100);
      }
    }
    
    // Start checking after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensurePricingTableMounts);
    } else {
      setTimeout(ensurePricingTableMounts, 100);
    }
    
    // Also listen for Clerk's load event
    window.addEventListener('clerk:loaded', function() {
      if (typeof window.mountAllClerkAstroJSComponents === 'function') {
        window.mountAllClerkAstroJSComponents();
        if (import.meta.env.PROD) {
          console.log('[Clerk] PricingTable: clerk:loaded event fired, mounted components');
        }
      }
    });
  })();
</script>


<style>
  /* Hide upgrade content by default to prevent flash */
  .auth-page__hidden {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* Custom primary button styling - matches sign-in/sign-up */
  .primary-button,
  :global(.cl-formButtonPrimary) {
    background-color: var(--color-bold-blue) !important;
    will-change: transform, box-shadow !important;
    transition:
      background-color 0.125s ease-in-out,
      box-shadow 0.125s ease-in-out !important;
    box-shadow:
      0px -8px 0px 0px hsla(0, 0%, 0%, 0.1) inset,
      0px 4px 4px 0px hsla(0, 0%, 0%, 0.25) !important;
    border-radius: 1.5rem !important;
    height: 64px !important;
    font-weight: 600 !important;
    font-size: 18px !important;
    color: white !important;
    justify-content: center !important;
  }

  /* Ensure all text inside button is white */
  .primary-button *,
  :global(.cl-formButtonPrimary *) {
    color: white !important;
  }

  /* Target all Clerk primary buttons */
  :global(.cl-button[data-variant="solid"][data-color="primary"]) {
    color: white !important;
  }

  :global(.cl-button[data-variant="solid"][data-color="primary"] *) {
    color: white !important;
  }

  .primary-button:hover,
  :global(.cl-formButtonPrimary:hover) {
    background-color: var(--color-bold-blue) !important;
  }

  .primary-button:active,
  :global(.cl-formButtonPrimary:active) {
    transform: scale(0.98) !important;
    background-color: var(--color-navy) !important;
    box-shadow:
      0px -4px 0px 0px #0000001a inset,
      0px 0px 4px 0px #00000040,
      0px 4px 0px 0px #00000040 inset !important;
  }

  .primary-button:active > *,
  :global(.cl-formButtonPrimary:active > *) {
    translate: 0 0 !important;
    transform: scale(0.98) !important;
  }

  /* Hide button icons */
  .primary-button svg,
  .primary-button img,
  .primary-button [class*="icon"],
  .primary-button [class*="arrow"],
  :global(.cl-formButtonPrimary svg),
  :global(.cl-formButtonPrimary img),
  :global(.cl-formButtonPrimary [class*="icon"]),
  :global(.cl-formButtonPrimary [class*="arrow"]) {
    display: none !important;
  }

  /* Custom text input styling */
  :global(.cl-formField input[type="email"]),
  :global(.cl-formField input[type="password"]),
  :global(.cl-formField input[type="text"]) {
    background: var(--color-gradient-gray) !important;
    box-shadow: var(--shadow-small) !important;
  }

  /* Set spacing to 12px */
  :global(.cl-form),
  :global([class*="cl-internal-ht35d7"]),
  :global([class*="cl-internal-1llpz65"]),
  :global([class*="cl-internal"]:has(.cl-formField)) {
    gap: 12px !important;
  }

  /* Mesh gradient using all thread colors with subtle movement */
  .thread-colors-mesh-gradient {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
  }

  .thread-colors-mesh-gradient::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: 
      radial-gradient(circle at 20% 30%, var(--color-blue) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, var(--color-purple) 0%, transparent 50%),
      radial-gradient(circle at 40% 70%, var(--color-pink) 0%, transparent 50%),
      radial-gradient(circle at 60% 80%, var(--color-orange) 0%, transparent 50%),
      radial-gradient(circle at 10% 60%, var(--color-yellow) 0%, transparent 50%),
      radial-gradient(circle at 90% 50%, var(--color-green) 0%, transparent 50%);
    background-size: 100% 100%;
    animation: mesh-movement 8s ease-in-out infinite;
    opacity: 0.8;
  }

  .thread-colors-mesh-gradient::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(circle at 70% 40%, var(--color-pink) 0%, transparent 40%),
      radial-gradient(circle at 30% 90%, var(--color-yellow) 0%, transparent 40%),
      radial-gradient(circle at 50% 10%, var(--color-blue) 0%, transparent 40%),
      radial-gradient(circle at 15% 50%, var(--color-green) 0%, transparent 40%),
      radial-gradient(circle at 85% 70%, var(--color-purple) 0%, transparent 40%),
      radial-gradient(circle at 60% 30%, var(--color-orange) 0%, transparent 40%);
    background-size: 100% 100%;
    animation: mesh-movement-reverse 10s ease-in-out infinite;
    opacity: 0.6;
  }

  @keyframes mesh-movement {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(5%, 3%) scale(1.05);
    }
    50% {
      transform: translate(-3%, 5%) scale(1.1);
    }
    75% {
      transform: translate(3%, -2%) scale(1.05);
    }
  }

  @keyframes mesh-movement-reverse {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(-4%, -3%) scale(1.08);
    }
    50% {
      transform: translate(4%, -5%) scale(1.12);
    }
    75% {
      transform: translate(-2%, 3%) scale(1.06);
    }
  }

  /* Ensure SquareButton Back variant has proper shadow styling */
  :global(.square-button-container button[style*="background-image"]:not([data-outer-shadow])) {
    box-shadow: 0px -3px 0px 0px rgba(120, 118, 111, 0.2) inset !important;
  }

  :global(.square-button-container button[style*="background-image"]:not([data-outer-shadow]):active) {
    filter: brightness(0.97) !important;
    box-shadow: 
      0px -1px 0px 0px rgba(120, 118, 111, 0.2) inset,
      0px 1px 0px 0px rgba(120, 118, 111, 0.2) inset !important;
  }

  /* Allow scrolling on mobile while maintaining full height */
  :global(html),
  :global(body) {
    min-height: 100svh;
  }

  /* Card-level overflow protection for Clerk form elements */
  :global(.clerk-form-card),
  :global(.cl-formCard),
  :global(.cl-card) {
    overflow-x: hidden !important;
  }

  /* Ensure all Clerk form card children respect container width */
  :global(.clerk-form-card *),
  :global(.cl-formCard *),
  :global(.cl-card *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
  }

  /* Comprehensive Clerk alert/verification container constraints */
  :global([class*="cl-alert"]),
  :global([class*="cl-banner"]),
  :global([class*="cl-toast"]),
  :global([class*="cl-verification"]),
  :global([class*="cl-formFieldAlert"]),
  :global([class*="cl-formFieldWarning"]),
  :global([class*="cl-formFieldInfo"]),
  :global([class*="cl-formFieldSuccess"]) {
    box-sizing: border-box !important;
    max-width: 100% !important;
    width: 100% !important;
    overflow-x: hidden !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
  }

  /* Target all nested elements within alert containers */
  :global([class*="cl-alert"] *),
  :global([class*="cl-banner"] *),
  :global([class*="cl-toast"] *),
  :global([class*="cl-verification"] *),
  :global([class*="cl-formFieldAlert"] *),
  :global([class*="cl-formFieldWarning"] *),
  :global([class*="cl-formFieldInfo"] *),
  :global([class*="cl-formFieldSuccess"] *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
  }

  /* Ensure verification text wraps properly */
  :global([class*="cl-formFieldDescription"]),
  :global([class*="cl-formFieldDescription"] *),
  :global([class*="cl-formFieldInfoText"]),
  :global([class*="cl-formFieldInfoText"] *),
  :global([class*="cl-formFieldWarningText"]),
  :global([class*="cl-formFieldWarningText"] *),
  :global([class*="cl-formFieldSuccessText"]),
  :global([class*="cl-formFieldSuccessText"] *) {
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    white-space: normal !important;
  }

  /* Specific targeting for orange verification text and containers */
  :global([class*="verification"]),
  :global([class*="verification"] *),
  :global([style*="orange"]),
  :global([style*="orange"] *),
  :global([style*="color: orange"]),
  :global([style*="color: orange"] *),
  :global([style*="color:rgb(255"]),
  :global([style*="color:rgb(255"] *) {
    box-sizing: border-box !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    width: 100% !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Target any element with text content that might overflow */
  :global(.clerk-form-card > *),
  :global(.cl-formCard > *),
  :global(.cl-card > *) {
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Aggressive targeting for any alert-like elements */
  :global([role="alert"]),
  :global([role="alert"] *),
  :global([data-clerk-element*="alert"]),
  :global([data-clerk-element*="alert"] *),
  :global([data-clerk-element*="warning"]),
  :global([data-clerk-element*="warning"] *),
  :global([data-clerk-element*="verification"]),
  :global([data-clerk-element*="verification"] *) {
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Clerk form alert class */
  .clerk-form-alert,
  .clerk-form-alert * {
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Upgrade content styling */
  .upgrade-content {
    width: 100%;
  }

  .upgrade-content__header {
    text-align: center !important;
    margin-bottom: 2rem;
  }

  .upgrade-content__header h1.clerk-form-header-title,
  .upgrade-content__header .clerk-form-header-title {
    margin-bottom: 8px;
    text-align: center !important;
  }
  
  .upgrade-content__header .clerk-form-header-subtitle,
  .upgrade-content__header p.clerk-form-header-subtitle {
    text-align: center !important;
  }

  .upgrade-content__success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bold-blue);
    color: white;
    font-size: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .upgrade-content__plan {
    background: linear-gradient(135deg, var(--color-bold-blue) 0%, var(--color-deep-blue) 100%);
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 1.5rem;
  }

  .upgrade-content__plan-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .upgrade-content__plan-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .upgrade-content__plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .upgrade-content__plan-amount {
    font-size: 3rem;
    font-weight: 700;
  }

  .upgrade-content__plan-period {
    font-size: 1.125rem;
    opacity: 0.9;
  }

  .upgrade-content__plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .upgrade-content__plan-feature {
    font-size: 1rem;
    opacity: 0.95;
  }

  .upgrade-content__checkout-button {
    width: 100%;
  }

  .upgrade-content__info {
    font-size: 0.875rem;
    color: var(--color-medium-grey);
    text-align: center;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1159px) {
    .upgrade-content__plan-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  /* PricingTable component styling to match sign-in page */
  :global(.cl-pricingTable),
  :global(.cl-pricingTable *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
  }

  /* Style pricing table cards */
  :global(.cl-pricingTable .cl-card),
  :global(.cl-pricingTable [class*="cl-card"]) {
    background-color: white !important;
    border-radius: 1rem !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
    border: none !important;
    border-width: 0 !important;
    overflow-x: hidden !important;
  }

  /* Style pricing table buttons */
  :global(.cl-pricingTable button),
  :global(.cl-pricingTable [class*="cl-button"]) {
    background-color: var(--color-bold-blue) !important;
    border-radius: 1.5rem !important;
    height: 64px !important;
    font-weight: 600 !important;
    font-size: 18px !important;
    color: white !important;
    box-shadow:
      0px -8px 0px 0px hsla(0, 0%, 0%, 0.1) inset,
      0px 4px 4px 0px hsla(0, 0%, 0%, 0.25) !important;
    transition:
      background-color 0.125s ease-in-out,
      box-shadow 0.125s ease-in-out !important;
  }

  :global(.cl-pricingTable button:hover),
  :global(.cl-pricingTable [class*="cl-button"]:hover) {
    background-color: var(--color-bold-blue) !important;
  }

  :global(.cl-pricingTable button:active),
  :global(.cl-pricingTable [class*="cl-button"]:active) {
    transform: scale(0.98) !important;
    background-color: var(--color-navy) !important;
    box-shadow:
      0px -4px 0px 0px #0000001a inset,
      0px 0px 4px 0px #00000040,
      0px 4px 0px 0px #00000040 inset !important;
  }

  /* Style pricing table text */
  :global(.cl-pricingTable h2),
  :global(.cl-pricingTable h3),
  :global(.cl-pricingTable [class*="cl-heading"]) {
    color: var(--color-deep-grey) !important;
    font-weight: 700 !important;
  }

  :global(.cl-pricingTable p),
  :global(.cl-pricingTable [class*="cl-text"]) {
    color: var(--color-stone-grey) !important;
  }

  /* Style pricing table price display */
  :global(.cl-pricingTable [class*="price"]),
  :global(.cl-pricingTable [class*="amount"]) {
    color: var(--color-deep-grey) !important;
    font-weight: 700 !important;
  }

  /* Ensure pricing table respects container */
  :global(.cl-pricingTable) {
    width: 100% !important;
    max-width: 100% !important;
  }


  /* Remove left and right padding on mobile */
  @media (max-width: 1159px) {
    .auth-page__form-section {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }
</style>
