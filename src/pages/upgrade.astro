---
export const prerender = false;
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import { getSubscriptionInfo } from "@/utils/subscription";
import { getUserLimitsInfo } from "@/utils/tier-limits";
import UpgradeCheckoutButton from "@/components/react/UpgradeCheckoutButton";
import UpgradeSuccessHandler from "@/components/react/UpgradeSuccessHandler";
import UpgradePageContent from "@/components/react/UpgradePageContent";
import ToastProvider from "@/components/react/ToastProvider.tsx";
import { ClientRouter } from "astro:transitions";
import "sonner/dist/styles.css";

// Get user data from Clerk authentication
const auth = Astro.locals.auth();
const { userId } = auth;

if (!userId) {
  throw new Error('User ID is required but not found');
}

// Set cache headers to reduce function invocations on repeat visits
Astro.response.headers.set('Cache-Control', 'private, max-age=60, stale-while-revalidate=120');

// Get subscription info (pass auth object to use has() method)
const subscriptionInfo = await getSubscriptionInfo(userId, auth);
// Get tier limits for shared spaces (owned, joinable, members per space)
const limitsInfo = await getUserLimitsInfo(userId, auth);

// Extract publishable key and plan ID in frontmatter (where import.meta works)
// Convert to strings to ensure proper serialization
const publishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ? String(import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY) : null;
const unlimitedPlanId = import.meta.env.CLERK_UNLIMITED_PLAN_ID ? String(import.meta.env.CLERK_UNLIMITED_PLAN_ID) : 'cplan_37aJweoipC2wY2Pa94o7zMdoIyw';
---

<EmptyLayout title="Upgrade - Harvous">
  <ToastProvider client:load />
  <UpgradeSuccessHandler client:load />
  <div id="upgrade-content" class="auth-page auth-page__hidden">
    <div class="auth-page__container">
      <!-- Top Row (Mobile) / Left Column (Desktop): Animated Gradient Background -->
      <div class="auth-page__video-section thread-colors-mesh-gradient">
        <div class="auth-page__video-overlay">
          <!-- Harvous logo -->
          <a href="https://harvous.com" class="auth-page__logo-container">
            <svg 
              width="45" 
              height="64" 
              viewBox="0 0 45 64" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
              class="auth-page__logo sign-in-logo"
              aria-label="Harvous"
            >
              <path d="M44.8037 63.9941H0.0078125V0H44.8037V63.9941ZM34.5645 31.168C25.6988 34.2637 18.5024 41.2949 15.3711 50.543L14.2842 53.752H34.5645V31.168ZM10.2471 37.8643C15.8921 29.2487 24.5827 23.0353 34.5645 20.4824V10.2393H10.2471V37.8643Z" fill="#fff"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Bottom Row (Mobile) / Right Column (Desktop): Upgrade Form -->
      <div class="auth-page__form-section">
        <div class="auth-page__form-wrapper">
          <!-- Client-side component that updates dynamically -->
          <div class="clerk-form-card">
            <UpgradePageContent 
              client:load
              initialHasUnlimited={subscriptionInfo.hasUnlimited}
              initialCurrentCount={subscriptionInfo.currentCount}
              initialLimit={subscriptionInfo.limit}
              limitsInfo={limitsInfo}
              publishableKey={publishableKey}
              unlimitedPlanId={unlimitedPlanId}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</EmptyLayout>

<!-- Enable View Transitions for client-side navigation -->
<ClientRouter />

<!-- Hide navigation and show upgrade content -->
<script is:inline>
  (function() {
    if (typeof window === 'undefined') return;
    try { sessionStorage.removeItem('harvousSkipBeforeUnload'); } catch (_) {}
    // Comprehensive function to hide all navigation elements
    function hideNavigation() {
      // Get all possible navigation selectors
      const selectors = [
        '[slot="navigation"]',
        '#persistent-navigation',
        '.desktop-layout [slot="navigation"]',
        '.mobile-layout [slot="mobile-navigation"]',
        '.desktop-layout .layout-column:first-child',
        '.mobile-layout .mobile-nav-slot',
        '.mobile-layout .mobile-bottom-sheet',
        '.app-layout .desktop-layout .layout-column:first-child',
        '.app-layout .mobile-layout .mobile-nav-slot',
        '[data-navigation-active="true"]',
        '[data-navigation-path]'
      ];
      
      // Hide all matching elements
      selectors.forEach(selector => {
        try {
          const elements = document.querySelectorAll(selector);
          elements.forEach(el => {
            const htmlEl = el;
            if (htmlEl && htmlEl.style) {
              htmlEl.style.display = 'none';
              htmlEl.style.visibility = 'hidden';
              htmlEl.style.opacity = '0';
              htmlEl.style.pointerEvents = 'none';
              htmlEl.style.position = 'absolute';
              htmlEl.style.left = '-9999px';
            }
          });
        } catch (e) {
          // Silently ignore selector errors
        }
      });
    }
    
    // Function to show upgrade content
    function showUpgradeContent() {
      var content = document.getElementById('upgrade-content');
      if (content) {
        content.classList.remove('auth-page__hidden');
      }
    }
    
    // Hide navigation immediately on load
    hideNavigation();
    showUpgradeContent();
    
    // Hide navigation BEFORE View Transition swap occurs
    document.addEventListener('astro:before-swap', function(event) {
      // Check if navigating TO upgrade page
      const targetUrl = (event && event.detail && event.detail.to && event.detail.to.url) 
        ? event.detail.to.url 
        : window.location.href;
      if (targetUrl.includes('/upgrade') || window.location.pathname === '/upgrade') {
        hideNavigation();
      }
    });
    
    // Also hide on any navigation away from upgrade page (to prevent flash when going back)
    document.addEventListener('astro:before-swap', function() {
      // If currently on upgrade page and navigating away, ensure nav is hidden during transition
      if (window.location.pathname === '/upgrade') {
        hideNavigation();
      }
    });
    
    // Ensure navigation stays hidden after page load
    document.addEventListener('astro:page-load', function() {
      // Check if we're on the upgrade page
      if (window.location.pathname === '/upgrade') {
        hideNavigation();
        showUpgradeContent();
      }
    });
    
    // MutationObserver to catch dynamically added navigation elements
    // This ensures navigation is hidden even if added after initial page load
    if (typeof MutationObserver !== 'undefined') {
      const observer = new MutationObserver(function(mutations) {
        // Only watch if we're on the upgrade page
        if (window.location.pathname === '/upgrade') {
          let shouldHide = false;
          
            mutations.forEach(function(mutation) {
              // Check if any added nodes are navigation elements
              mutation.addedNodes.forEach(function(node) {
                if (node.nodeType === 1) { // Element node
                  const el = node;
                  // Check if the added element or its children are navigation
                  if (
                    (el.hasAttribute && el.hasAttribute('slot') && el.getAttribute('slot') === 'navigation') ||
                    (el.id === 'persistent-navigation') ||
                    (el.classList && el.classList.contains('layout-column')) ||
                    (el.querySelector && el.querySelector('[slot="navigation"]')) ||
                    (el.querySelector && el.querySelector('#persistent-navigation')) ||
                    (el.hasAttribute && el.hasAttribute('data-navigation-active')) ||
                    (el.hasAttribute && el.hasAttribute('data-navigation-path'))
                  ) {
                    shouldHide = true;
                  }
                }
              });
            });
          
          if (shouldHide) {
            hideNavigation();
          }
        }
      });
      
      // Start observing when DOM is ready
      if (document.body) {
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      } else {
        // Wait for DOM to be ready
        document.addEventListener('DOMContentLoaded', function() {
          if (document.body) {
            observer.observe(document.body, {
              childList: true,
              subtree: true
            });
          }
        });
      }
      
      // Also observe after View Transitions
      document.addEventListener('astro:page-load', function() {
        if (window.location.pathname === '/upgrade' && document.body) {
          observer.observe(document.body, {
            childList: true,
            subtree: true
          });
        }
      });
    }
  })();
</script>


<style>
  /* Ensure auth-page covers viewport and is above navigation */
  .auth-page {
    position: relative;
    z-index: 100;
    min-height: 100svh;
    background-color: var(--color-light-paper);
  }

  /* Hide upgrade content by default to prevent flash */
  .auth-page__hidden {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* Hide navigation when upgrade page is present - Immediate CSS (before JS runs) */
  /* Target all possible navigation elements including layout columns */
  body:has(#upgrade-content) [slot="navigation"],
  body:has(#upgrade-content) #persistent-navigation,
  body:has(#upgrade-content) .desktop-layout [slot="navigation"],
  body:has(#upgrade-content) .mobile-layout [slot="mobile-navigation"],
  body:has(#upgrade-content) .desktop-layout .layout-column:first-child,
  body:has(#upgrade-content) .desktop-layout .layout-column:first-child > *,
  body:has(#upgrade-content) .mobile-layout .mobile-nav-slot,
  body:has(#upgrade-content) .mobile-layout .mobile-bottom-sheet,
  body:has(#upgrade-content) .app-layout .desktop-layout .layout-column:first-child,
  body:has(#upgrade-content) .app-layout .mobile-layout .mobile-nav-slot,
  body:has(#upgrade-content) [data-navigation-active="true"],
  body:has(#upgrade-content) [data-navigation-path] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    position: absolute !important;
    left: -9999px !important;
  }

  /* Hide navigation during View Transitions - target transition states */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    /* Ensure navigation is hidden in both old and new transition states */
  }

  ::view-transition-old(root) [slot="navigation"],
  ::view-transition-new(root) [slot="navigation"],
  ::view-transition-old(root) #persistent-navigation,
  ::view-transition-new(root) #persistent-navigation,
  ::view-transition-old(root) .desktop-layout .layout-column:first-child,
  ::view-transition-new(root) .desktop-layout .layout-column:first-child,
  ::view-transition-old(root) .mobile-layout [slot="mobile-navigation"],
  ::view-transition-new(root) .mobile-layout [slot="mobile-navigation"] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
  }

  /* Custom primary button styling - matches sign-in/sign-up */
  .primary-button,
  :global(.cl-formButtonPrimary) {
    background-color: var(--color-bold-blue) !important;
    will-change: transform, box-shadow !important;
    transition:
      background-color 0.125s ease-in-out,
      box-shadow 0.125s ease-in-out !important;
    box-shadow:
      0px -8px 0px 0px hsla(0, 0%, 0%, 0.1) inset,
      0px 4px 4px 0px hsla(0, 0%, 0%, 0.25) !important;
    border-radius: 1.5rem !important;
    height: 64px !important;
    font-weight: 600 !important;
    font-size: 18px !important;
    color: white !important;
    justify-content: center !important;
  }

  /* Ensure all text inside button is white */
  .primary-button *,
  :global(.cl-formButtonPrimary *) {
    color: white !important;
  }

  /* Target all Clerk primary buttons */
  :global(.cl-button[data-variant="solid"][data-color="primary"]) {
    color: white !important;
  }

  :global(.cl-button[data-variant="solid"][data-color="primary"] *) {
    color: white !important;
  }

  .primary-button:hover,
  :global(.cl-formButtonPrimary:hover) {
    background-color: var(--color-bold-blue) !important;
  }

  .primary-button:active,
  :global(.cl-formButtonPrimary:active) {
    transform: scale(0.98) !important;
    background-color: var(--color-navy) !important;
    box-shadow:
      0px -4px 0px 0px #0000001a inset,
      0px 0px 4px 0px #00000040,
      0px 4px 0px 0px #00000040 inset !important;
  }

  .primary-button:active > *,
  :global(.cl-formButtonPrimary:active > *) {
    translate: 0 0 !important;
    transform: scale(0.98) !important;
  }

  /* Hide button icons */
  .primary-button svg,
  .primary-button img,
  .primary-button [class*="icon"],
  .primary-button [class*="arrow"],
  :global(.cl-formButtonPrimary svg),
  :global(.cl-formButtonPrimary img),
  :global(.cl-formButtonPrimary [class*="icon"]),
  :global(.cl-formButtonPrimary [class*="arrow"]) {
    display: none !important;
  }

  /* Custom text input styling */
  :global(.cl-formField input[type="email"]),
  :global(.cl-formField input[type="password"]),
  :global(.cl-formField input[type="text"]) {
    background: var(--color-gradient-gray) !important;
    box-shadow: var(--shadow-small) !important;
  }

  /* Set spacing to 12px */
  :global(.cl-form),
  :global([class*="cl-internal-ht35d7"]),
  :global([class*="cl-internal-1llpz65"]),
  :global([class*="cl-internal"]:has(.cl-formField)) {
    gap: 12px !important;
  }

  /* Mesh gradient using all thread colors with subtle movement */
  .thread-colors-mesh-gradient {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
  }

  .thread-colors-mesh-gradient::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: 
      radial-gradient(circle at 20% 30%, var(--color-blue) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, var(--color-purple) 0%, transparent 50%),
      radial-gradient(circle at 40% 70%, var(--color-pink) 0%, transparent 50%),
      radial-gradient(circle at 60% 80%, var(--color-orange) 0%, transparent 50%),
      radial-gradient(circle at 10% 60%, var(--color-yellow) 0%, transparent 50%),
      radial-gradient(circle at 90% 50%, var(--color-green) 0%, transparent 50%);
    background-size: 100% 100%;
    animation: mesh-movement 6s ease-in-out infinite;
    opacity: 0.8;
  }

  .thread-colors-mesh-gradient::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(circle at 70% 40%, var(--color-pink) 0%, transparent 40%),
      radial-gradient(circle at 30% 90%, var(--color-yellow) 0%, transparent 40%),
      radial-gradient(circle at 50% 10%, var(--color-blue) 0%, transparent 40%),
      radial-gradient(circle at 15% 50%, var(--color-green) 0%, transparent 40%),
      radial-gradient(circle at 85% 70%, var(--color-purple) 0%, transparent 40%),
      radial-gradient(circle at 60% 30%, var(--color-orange) 0%, transparent 40%);
    background-size: 100% 100%;
    animation: mesh-movement-reverse 7.5s ease-in-out infinite;
    opacity: 0.6;
  }

  /* Mobile: Blue to pink gradient with blend zone sliding side to side */
  @media (max-width: 1159px) {
    .thread-colors-mesh-gradient::before {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to right, var(--color-blue), var(--color-pink));
      background-size: 200% 100%;
      animation: mesh-gradient-slide 6s ease-in-out infinite;
      opacity: 0.9;
    }
    .thread-colors-mesh-gradient::after {
      opacity: 0;
    }
  }

  @keyframes mesh-gradient-slide {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes mesh-movement {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    16.66% {
      transform: translate(4%, 3%) scale(1.06);
    }
    33.33% {
      transform: translate(-3%, 4%) scale(1.08);
    }
    50% {
      transform: translate(-4%, -2%) scale(1.07);
    }
    66.66% {
      transform: translate(3%, -4%) scale(1.09);
    }
    83.33% {
      transform: translate(3%, 2%) scale(1.05);
    }
  }

  @keyframes mesh-movement-reverse {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    16.66% {
      transform: translate(-4%, -3%) scale(1.07);
    }
    33.33% {
      transform: translate(4%, -4%) scale(1.09);
    }
    50% {
      transform: translate(3%, 4%) scale(1.08);
    }
    66.66% {
      transform: translate(-3%, 3%) scale(1.06);
    }
    83.33% {
      transform: translate(-2%, -3%) scale(1.05);
    }
  }

  /* Ensure SquareButton Back variant has proper shadow styling */
  :global(.square-button-container button[style*="background-image"]:not([data-outer-shadow])) {
    box-shadow: 0px -3px 0px 0px rgba(120, 118, 111, 0.2) inset !important;
  }

  :global(.square-button-container button[style*="background-image"]:not([data-outer-shadow]):active) {
    filter: brightness(0.97) !important;
    box-shadow: 
      0px -1px 0px 0px rgba(120, 118, 111, 0.2) inset,
      0px 1px 0px 0px rgba(120, 118, 111, 0.2) inset !important;
  }

  /* Allow scrolling on mobile while maintaining full height */
  :global(html),
  :global(body) {
    min-height: 100svh;
  }

  /* Card-level overflow protection for Clerk form elements */
  :global(.clerk-form-card),
  :global(.cl-formCard),
  :global(.cl-card) {
    overflow-x: hidden !important;
  }

  /* Ensure all Clerk form card children respect container width */
  :global(.clerk-form-card *),
  :global(.cl-formCard *),
  :global(.cl-card *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
  }

  /* Comprehensive Clerk alert/verification container constraints */
  :global([class*="cl-alert"]),
  :global([class*="cl-banner"]),
  :global([class*="cl-toast"]),
  :global([class*="cl-verification"]),
  :global([class*="cl-formFieldAlert"]),
  :global([class*="cl-formFieldWarning"]),
  :global([class*="cl-formFieldInfo"]),
  :global([class*="cl-formFieldSuccess"]) {
    box-sizing: border-box !important;
    max-width: 100% !important;
    width: 100% !important;
    overflow-x: hidden !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
  }

  /* Target all nested elements within alert containers */
  :global([class*="cl-alert"] *),
  :global([class*="cl-banner"] *),
  :global([class*="cl-toast"] *),
  :global([class*="cl-verification"] *),
  :global([class*="cl-formFieldAlert"] *),
  :global([class*="cl-formFieldWarning"] *),
  :global([class*="cl-formFieldInfo"] *),
  :global([class*="cl-formFieldSuccess"] *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
  }

  /* Ensure verification text wraps properly */
  :global([class*="cl-formFieldDescription"]),
  :global([class*="cl-formFieldDescription"] *),
  :global([class*="cl-formFieldInfoText"]),
  :global([class*="cl-formFieldInfoText"] *),
  :global([class*="cl-formFieldWarningText"]),
  :global([class*="cl-formFieldWarningText"] *),
  :global([class*="cl-formFieldSuccessText"]),
  :global([class*="cl-formFieldSuccessText"] *) {
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    white-space: normal !important;
  }

  /* Specific targeting for orange verification text and containers */
  :global([class*="verification"]),
  :global([class*="verification"] *),
  :global([style*="orange"]),
  :global([style*="orange"] *),
  :global([style*="color: orange"]),
  :global([style*="color: orange"] *),
  :global([style*="color:rgb(255"]),
  :global([style*="color:rgb(255"] *) {
    box-sizing: border-box !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    width: 100% !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Target any element with text content that might overflow */
  :global(.clerk-form-card > *),
  :global(.cl-formCard > *),
  :global(.cl-card > *) {
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Aggressive targeting for any alert-like elements */
  :global([role="alert"]),
  :global([role="alert"] *),
  :global([data-clerk-element*="alert"]),
  :global([data-clerk-element*="alert"] *),
  :global([data-clerk-element*="warning"]),
  :global([data-clerk-element*="warning"] *),
  :global([data-clerk-element*="verification"]),
  :global([data-clerk-element*="verification"] *) {
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Clerk form alert class */
  .clerk-form-alert,
  .clerk-form-alert * {
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Upgrade content styling */
  .upgrade-content {
    width: 100%;
  }

  .upgrade-content__header {
    text-align: center !important;
    margin-bottom: 2rem;
  }

  .upgrade-content__header h1.clerk-form-header-title,
  .upgrade-content__header .clerk-form-header-title {
    font-family: var(--font-roundo) !important;
    font-weight: 600 !important; /* Semi-bold */
    margin-bottom: 8px;
    text-align: center !important;
  }
  
  .upgrade-content__header .clerk-form-header-subtitle,
  .upgrade-content__header p.clerk-form-header-subtitle {
    text-align: center !important;
  }

  .upgrade-content__success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bold-blue);
    color: white;
    font-size: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .upgrade-content__plan {
    background: linear-gradient(135deg, var(--color-bold-blue) 0%, var(--color-deep-blue) 100%);
    border-radius: 1.5rem;
    padding: 2rem;
    color: white;
    margin-bottom: 1.5rem;
  }

  .upgrade-content__plan-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .upgrade-content__plan-name {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .upgrade-content__plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .upgrade-content__plan-amount {
    font-size: 3rem;
    font-weight: 700;
  }

  .upgrade-content__plan-period {
    font-size: 1.125rem;
    opacity: 0.9;
  }

  .upgrade-content__plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .upgrade-content__plan-feature {
    font-size: 1rem;
    opacity: 0.95;
  }

  .upgrade-content__checkout-button {
    width: 100%;
  }

  .upgrade-content__info {
    font-size: 0.875rem;
    color: var(--color-medium-grey);
    text-align: center;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1159px) {
    .upgrade-content__plan-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  /* PricingTable component styling to match sign-in page */
  :global(.cl-pricingTable),
  :global(.cl-pricingTable *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
  }

  /* Style pricing table cards */
  :global(.cl-pricingTable .cl-card),
  :global(.cl-pricingTable [class*="cl-card"]) {
