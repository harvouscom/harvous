---
// Static page (hybrid): redirect for already-authenticated users is handled client-side after Clerk loads
import EmptyLayout from "@/layouts/EmptyLayout.astro";
import { SignIn as ClerkSignIn } from "@clerk/astro/components";
import { ClientRouter } from "astro:transitions";

const publishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY || null;
---

<EmptyLayout title="Sign In">
  <div id="sign-in-content" class="auth-page auth-page__hidden">
    <div class="auth-page__container">
      <!-- Top Row (Mobile) / Left Column (Desktop): Animated Gradient Background -->
      <div class="auth-page__video-section thread-colors-mesh-gradient">
        <div class="auth-page__video-overlay">
          <!-- Harvous logo -->
          <a href="https://harvous.com" class="auth-page__logo-container">
            <svg
              width="28"
              height="40"
              viewBox="0 0 45 64"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="auth-page__logo sign-in-logo"
              aria-label="Harvous"
            >
              <path d="M44.8037 63.9941H0.0078125V0H44.8037V63.9941ZM34.5645 31.168C25.6988 34.2637 18.5024 41.2949 15.3711 50.543L14.2842 53.752H34.5645V31.168ZM10.2471 37.8643C15.8921 29.2487 24.5827 23.0353 34.5645 20.4824V10.2393H10.2471V37.8643Z" fill="#fff"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Bottom Row (Mobile) / Right Column (Desktop): Sign In Form -->
      <div class="auth-page__form-section">
        <div class="auth-page__form-wrapper">

      <ClerkSignIn
        appearance={{
            elements: {
                rootBox: "clerk-form-root",
                card: {
                  className: "clerk-form-card",
                  style: {
                    border: "none",
                    borderWidth: "0",
                    overflowX: "hidden"
                  }
                },
            headerTitle: "clerk-form-header-title",
            headerSubtitle: "clerk-form-header-subtitle",
            formField: "",
            formButtonPrimary: "clerk-form-button-primary primary-button",
            formFieldInput: "clerk-form-input",
            formFieldLabel: "hidden",
            formFieldError: {
              className: "clerk-form-error"
            },
            formFieldAlert: {
              className: "clerk-form-alert",
              style: {
                maxWidth: "100%",
                width: "100%",
                boxSizing: "border-box",
                overflowWrap: "break-word",
                wordWrap: "break-word",
                whiteSpace: "normal"
              }
            },
            footerActionLink: "clerk-form-link",
            dividerLine: "clerk-form-divider-line",
            dividerText: "clerk-form-divider-text"
          },
          variables: {
            colorPrimary: "var(--color-bold-blue)"
          }
        }}
        signUpUrl="/sign-up"
        fallbackRedirectUrl="/"
      />
        </div>
      </div>
    </div>
  </div>
</EmptyLayout>

<!-- Enable View Transitions for client-side navigation -->
<ClientRouter />

<!-- Clerk publishable key (EmptyLayout does not set it; required for Clerk to initialize) -->
<script is:inline define:vars={{ publishableKey }}>
  (function() {
    if (typeof window !== 'undefined') {
      window.CLERK_PUBLISHABLE_KEY = publishableKey || null;
    }
  })();
</script>

<!-- Clerk Client-Side Initialization Script -->
<script is:inline>
  (function() {
    if (typeof window === 'undefined') return;

    // Show the sign-in content as early as possible so Clerk can mount (visibility: hidden can prevent mounting)
    function showSignInContent() {
      var content = document.getElementById('sign-in-content');
      if (content) content.classList.remove('auth-page__hidden');
    }
    setTimeout(showSignInContent, 0);

    // ========================================================================
    // PWA/Mobile Device Detection & Session Restoration
    // ========================================================================
    // Load device fingerprinting and session backup utilities
    // This prevents "Detect new device" warnings in PWA/mobile contexts

    async function initializePWAAuth() {
      try {
        // Import utilities (dynamic import for inline script)
        const { getOrCreateDeviceId, getDeviceId } = await import('/src/utils/device-fingerprint.ts');
        const { restoreClerkSession, isSessionValid, backupClerkSession } = await import('/src/utils/clerk-session-backup.ts');
        const { initClerkForPWA } = await import('/src/utils/clerk-pwa-helper.ts');

        console.log('[Auth] Initializing PWA auth...');

        // PHASE 1: Generate/retrieve device fingerprint
        const deviceId = await getOrCreateDeviceId();
        console.log('[Auth] Device ID:', deviceId.substring(0, 8) + '...');

        // PHASE 2: Check for session backup
        const sessionBackup = await restoreClerkSession();

        if (sessionBackup && isSessionValid(sessionBackup)) {
          console.log('[Auth] Valid session backup found');

          // PHASE 3: Verify device ID matches
          if (sessionBackup.deviceId === deviceId) {
            console.log('[Auth] Device ID matches, attempting silent restore');

            // PHASE 4: Wait for Clerk to load
            const waitForClerk = () => new Promise((resolve) => {
              if (window.Clerk) {
                resolve(window.Clerk);
              } else {
                const checkInterval = setInterval(() => {
                  if (window.Clerk) {
                    clearInterval(checkInterval);
                    resolve(window.Clerk);
                  }
                }, 100);

                // Timeout after 10 seconds
                setTimeout(() => {
                  clearInterval(checkInterval);
                  resolve(null);
                }, 10000);
              }
            });

            const Clerk = await waitForClerk();

            if (Clerk && sessionBackup.sessionId) {
              try {
                // Try to restore session silently
                await Clerk.setSession(sessionBackup.sessionId);
                console.log('[Auth] Session restored successfully, redirecting...');

                // Success! Redirect to app
                const urlParams = new URLSearchParams(window.location.search);
                const redirectUrl = urlParams.get('redirect_url') || '/';
                window.location.href = redirectUrl;
                return; // Exit early - session restored
              } catch (error) {
                console.log('[Auth] Silent restore failed, continuing to sign-in:', error);
                // Fall through to normal sign-in flow
              }
            }
          } else {
            console.log('[Auth] Device ID mismatch - session from different device');
          }
        } else {
          console.log('[Auth] No valid session backup found');
        }

        // PHASE 5: Initialize PWA helper (cookie monitoring, session backup)
        await initClerkForPWA();

      } catch (error) {
        console.error('[Auth] PWA auth initialization failed:', error);
        // Continue with normal sign-in flow
      }
    }

    // Initialize PWA auth (non-blocking)
    initializePWAAuth();

    // ========================================================================
    // Standard Clerk Sign-In Flow (existing logic)
    // ========================================================================

    // Check if we're in production (avoid using import.meta in inline scripts)
    var isProduction = window.location.hostname !== 'localhost' && !window.location.hostname.includes('127.0.0.1');
    
    // Check if coming from logout
    var urlParams = new URLSearchParams(window.location.search);
    var fromLogout = urlParams.get('from_logout') === 'true';

    // Client-side redirect when already signed in (static page; no server redirect)
    function redirectIfAlreadySignedIn() {
      if (fromLogout) return;
      if (window.Clerk && window.Clerk.user) {
        var redirectUrl = urlParams.get('redirect_url') || '/';
        window.location.replace(redirectUrl);
      }
    }

    // Track if clerk:loaded listener has been set up (only set up once)
    var clerkLoadedListenerSetup = false;

    // Force sign-out if user is still authenticated after logout
    function forceSignOutIfNeeded() {
      if (!fromLogout) return;
      
      // Wait for Clerk to be available
      if (window.Clerk && window.Clerk.signOut) {
        // User just logged out, but might still have a cached session
        // Force sign-out to ensure session is fully cleared
        window.Clerk.signOut().then(function() {
          // Clear storage
          try {
            sessionStorage.clear();
            localStorage.removeItem('userProfileData');
            localStorage.removeItem('profileData');
          } catch (error) {
            console.error('Storage clear error:', error);
          }
          // Remove from_logout parameter to clean up URL
          var newUrl = new URL(window.location.href);
          newUrl.searchParams.delete('from_logout');
          window.history.replaceState({}, '', newUrl);
        }).catch(function(error) {
          // Sign-out might fail if user is already signed out, which is fine
          // Just clean up the URL parameter
          var newUrl = new URL(window.location.href);
          newUrl.searchParams.delete('from_logout');
          window.history.replaceState({}, '', newUrl);
        });
      } else {
        // Clerk not loaded yet, wait and retry (max 5 seconds)
        var attempts = 0;
        var maxAttempts = 50;
        var checkInterval = setInterval(function() {
          attempts++;
          if (window.Clerk && window.Clerk.signOut) {
            clearInterval(checkInterval);
            forceSignOutIfNeeded();
          } else if (attempts >= maxAttempts) {
            clearInterval(checkInterval);
            // Clerk didn't load, just clean up URL
            var newUrl = new URL(window.location.href);
            newUrl.searchParams.delete('from_logout');
            window.history.replaceState({}, '', newUrl);
          }
        }, 100);
      }
    }
    
    // Debug: Check if @clerk/astro scripts are in the DOM
    function checkClerkScripts() {
      var clerkScripts = document.querySelectorAll('script[src*="clerk"], script[src*="clerkjs"]');
      if (clerkScripts.length === 0 && isProduction) {
        console.warn('[Clerk] No Clerk scripts found in DOM - @clerk/astro may not be injecting scripts');
      } else if (isProduction) {
        console.log('[Clerk] Found', clerkScripts.length, 'Clerk script(s) in DOM');
      }
    }
    
    // Wait for Clerk to load and ensure Astro components mount
    function ensureClerkComponentsMount() {
      // Check if Clerk is loaded
      if (typeof window !== 'undefined' && window._astro_clerk_component_props) {
        // Clerk's component props map exists, try to trigger mounting
        if (typeof window.mountAllClerkAstroJSComponents === 'function') {
          window.mountAllClerkAstroJSComponents();
          if (isProduction) {
            console.log('[Clerk] Successfully mounted Astro components');
          }
        } else if (window.__clerk_frontend_api) {
          // Clerk is loaded but mount function might not be available yet
          // Wait a bit and try again
          setTimeout(ensureClerkComponentsMount, 100);
        }
      } else {
        // Clerk not loaded yet, wait and retry (max 15 seconds)
        var attempts = 0;
        var maxAttempts = 150;
        var checkInterval = setInterval(function() {
          attempts++;
          if (window._astro_clerk_component_props || window.__clerk_frontend_api) {
            clearInterval(checkInterval);
            ensureClerkComponentsMount();
          } else if (attempts >= maxAttempts) {
            clearInterval(checkInterval);
            if (isProduction) {
              console.error('[Clerk] Clerk did not load within 15 seconds - @clerk/astro scripts may not be loading');
              checkClerkScripts();
            }
          }
        }, 100);
      }
    }

    // Initialize Clerk and show content
    function initializeSignIn() {
      ensureClerkComponentsMount();
      showSignInContent();
    }
    
    // Set up clerk:loaded listener only once
    if (!clerkLoadedListenerSetup) {
      window.addEventListener('clerk:loaded', function() {
        if (typeof window.mountAllClerkAstroJSComponents === 'function') {
          window.mountAllClerkAstroJSComponents();
          if (isProduction) {
            console.log('[Clerk] Clerk loaded event fired, mounted components');
          }
        }

        // Set up session backup listener for successful sign-ins
        if (window.Clerk) {
          window.Clerk.addListener(async function(session) {
            if (session && session.id && session.userId) {
              console.log('[Auth] User signed in, backing up session...');

              try {
                const { getOrCreateDeviceId } = await import('/src/utils/device-fingerprint.ts');
                const { backupClerkSession } = await import('/src/utils/clerk-session-backup.ts');

                const deviceId = await getOrCreateDeviceId();

                await backupClerkSession({
                  sessionId: session.id,
                  sessionToken: session.lastActiveToken?.getRawString() || null,
                  userId: session.userId,
                  deviceId: deviceId,
                  expiresAt: session.expireAt || null,
                  createdAt: Date.now(),
                  lastRefreshed: Date.now(),
                });

                console.log('[Auth] Session backup complete');
              } catch (error) {
                console.error('[Auth] Failed to backup session:', error);
              }
            }
          });
        }

        // Check if we need to force sign-out after Clerk loads
        forceSignOutIfNeeded();
        // Redirect already-signed-in users (static page)
        redirectIfAlreadySignedIn();
      });
      clerkLoadedListenerSetup = true;
    }

    // Check for Clerk scripts after a short delay (only on initial load)
    setTimeout(checkClerkScripts, 500);

    // Initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initializeSignIn();
        setTimeout(forceSignOutIfNeeded, 500);
        setTimeout(redirectIfAlreadySignedIn, 500);
      });
    } else {
      // DOM already ready, initialize immediately
      setTimeout(initializeSignIn, 100);
      setTimeout(forceSignOutIfNeeded, 500);
      setTimeout(redirectIfAlreadySignedIn, 500);
    }
    
    // View Transitions: Re-initialize on page navigation
    document.addEventListener('astro:page-load', function() {
      // Only re-initialize if we're on the sign-in page
      if (window.location.pathname === '/sign-in') {
        initializeSignIn();
      }
    });
  })();
</script>

<style>
  /* Hide sign-in content by default to prevent flash when user is already authenticated */
  .auth-page__hidden {
    opacity: 0 !important;
    visibility: hidden !important;
  }
  
  /* Custom primary button styling */
  .primary-button,
  :global(.cl-formButtonPrimary) {
    background-color: var(--color-bold-blue) !important;
    will-change: transform, box-shadow !important;
    transition:
      background-color 0.125s ease-in-out,
      box-shadow 0.125s ease-in-out !important;
    box-shadow:
      0px -8px 0px 0px hsla(0, 0%, 0%, 0.1) inset,
      0px 4px 4px 0px hsla(0, 0%, 0%, 0.25) !important;
    border-radius: 1.5rem !important;
    height: 64px !important;
    font-weight: 600 !important;
    font-size: 18px !important;
    color: white !important;
    justify-content: center !important;
  }

  /* Ensure all text inside button is white */
  .primary-button *,
  :global(.cl-formButtonPrimary *) {
    color: white !important;
  }

  /* Target all Clerk primary buttons */
  :global(.cl-button[data-variant="solid"][data-color="primary"]) {
    color: white !important;
  }

  :global(.cl-button[data-variant="solid"][data-color="primary"] *) {
    color: white !important;
  }

  .primary-button:hover,
  :global(.cl-formButtonPrimary:hover) {
    background-color: var(--color-bold-blue) !important;
  }

  .primary-button:active,
  :global(.cl-formButtonPrimary:active) {
    transform: scale(0.98) !important;
    background-color: var(--color-navy) !important;
    box-shadow:
      0px -4px 0px 0px #0000001a inset,
      0px 0px 4px 0px #00000040,
      0px 4px 0px 0px #00000040 inset !important;
  }

  .primary-button:active > *,
  :global(.cl-formButtonPrimary:active > *) {
    translate: 0 0 !important;
    transform: scale(0.98) !important;
  }

  /* Hide button icons */
  .primary-button svg,
  .primary-button img,
  .primary-button [class*="icon"],
  .primary-button [class*="arrow"],
  :global(.cl-formButtonPrimary svg),
  :global(.cl-formButtonPrimary img),
  :global(.cl-formButtonPrimary [class*="icon"]),
  :global(.cl-formButtonPrimary [class*="arrow"]) {
    display: none !important;
  }

  /* Custom text input styling */
  :global(.cl-formField input[type="email"]),
  :global(.cl-formField input[type="password"]),
  :global(.cl-formField input[type="text"]) {
    background: var(--color-gradient-gray) !important;
    box-shadow: var(--shadow-small) !important;
  }

  /* Set spacing to 12px */
  :global(.cl-form),
  :global([class*="cl-internal-ht35d7"]),
  :global([class*="cl-internal-1llpz65"]),
  :global([class*="cl-internal"]:has(.cl-formField)) {
    gap: 12px !important;
  }

  /* Mesh gradient using all thread colors with subtle movement */
  .thread-colors-mesh-gradient {
    position: relative;
    overflow: hidden;
    background: var(--color-paper);
  }

  .thread-colors-mesh-gradient::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: 
      radial-gradient(circle at 20% 30%, var(--color-blue) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, var(--color-purple) 0%, transparent 50%),
      radial-gradient(circle at 40% 70%, var(--color-pink) 0%, transparent 50%),
      radial-gradient(circle at 60% 80%, var(--color-orange) 0%, transparent 50%),
      radial-gradient(circle at 10% 60%, var(--color-yellow) 0%, transparent 50%),
      radial-gradient(circle at 90% 50%, var(--color-green) 0%, transparent 50%);
    background-size: 100% 100%;
    animation: mesh-movement 6s ease-in-out infinite;
    opacity: 0.8;
  }

  .thread-colors-mesh-gradient::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(circle at 70% 40%, var(--color-pink) 0%, transparent 40%),
      radial-gradient(circle at 30% 90%, var(--color-yellow) 0%, transparent 40%),
      radial-gradient(circle at 50% 10%, var(--color-blue) 0%, transparent 40%),
      radial-gradient(circle at 15% 50%, var(--color-green) 0%, transparent 40%),
      radial-gradient(circle at 85% 70%, var(--color-purple) 0%, transparent 40%),
      radial-gradient(circle at 60% 30%, var(--color-orange) 0%, transparent 40%);
    background-size: 100% 100%;
    animation: mesh-movement-reverse 7.5s ease-in-out infinite;
    opacity: 0.6;
  }

  /* Mobile: Show top section of desktop gradient, filling entire area */
  @media (max-width: 1159px) {
    .thread-colors-mesh-gradient::before {
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      transform: scaleY(2);
      transform-origin: top center;
    }
  }

  @keyframes mesh-movement {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    16.66% {
      transform: translate(4%, 3%) scale(1.06);
    }
    33.33% {
      transform: translate(-3%, 4%) scale(1.08);
    }
    50% {
      transform: translate(-4%, -2%) scale(1.07);
    }
    66.66% {
      transform: translate(3%, -4%) scale(1.09);
    }
    83.33% {
      transform: translate(3%, 2%) scale(1.05);
    }
  }

  @keyframes mesh-movement-reverse {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    16.66% {
      transform: translate(-4%, -3%) scale(1.07);
    }
    33.33% {
      transform: translate(4%, -4%) scale(1.09);
    }
    50% {
      transform: translate(3%, 4%) scale(1.08);
    }
    66.66% {
      transform: translate(-3%, 3%) scale(1.06);
    }
    83.33% {
      transform: translate(-2%, -3%) scale(1.05);
    }
  }

  /* Override video overlay padding for 24px spacing */
  #sign-in-content .auth-page__video-overlay {
    padding: 24px;
  }

  /* Ensure SquareButton Back variant has proper shadow styling */
  :global(.square-button-container button[style*="background-image"]:not([data-outer-shadow])) {
    box-shadow: 0px -3px 0px 0px rgba(120, 118, 111, 0.2) inset !important;
  }

  :global(.square-button-container button[style*="background-image"]:not([data-outer-shadow]):active) {
    filter: brightness(0.97) !important;
    box-shadow: 
      0px -1px 0px 0px rgba(120, 118, 111, 0.2) inset,
      0px 1px 0px 0px rgba(120, 118, 111, 0.2) inset !important;
  }

  /* Allow scrolling on mobile while maintaining full height */
  :global(html),
  :global(body) {
    min-height: 100svh;
  }

  /* Card-level overflow protection for Clerk form elements */
  :global(.clerk-form-card),
  :global(.cl-formCard),
  :global(.cl-card) {
    overflow-x: hidden !important;
  }

  /* Ensure all Clerk form card children respect container width */
  :global(.clerk-form-card *),
  :global(.cl-formCard *),
  :global(.cl-card *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
  }

  /* Comprehensive Clerk alert/verification container constraints */
  :global([class*="cl-alert"]),
  :global([class*="cl-banner"]),
  :global([class*="cl-toast"]),
  :global([class*="cl-verification"]),
  :global([class*="cl-formFieldAlert"]),
  :global([class*="cl-formFieldWarning"]),
  :global([class*="cl-formFieldInfo"]),
  :global([class*="cl-formFieldSuccess"]) {
    box-sizing: border-box !important;
    max-width: 100% !important;
    width: 100% !important;
    overflow-x: hidden !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
  }

  /* Target all nested elements within alert containers */
  :global([class*="cl-alert"] *),
  :global([class*="cl-banner"] *),
  :global([class*="cl-toast"] *),
  :global([class*="cl-verification"] *),
  :global([class*="cl-formFieldAlert"] *),
  :global([class*="cl-formFieldWarning"] *),
  :global([class*="cl-formFieldInfo"] *),
  :global([class*="cl-formFieldSuccess"] *) {
    box-sizing: border-box !important;
    max-width: 100% !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
  }

  /* Ensure verification text wraps properly */
  :global([class*="cl-formFieldDescription"]),
  :global([class*="cl-formFieldDescription"] *),
  :global([class*="cl-formFieldInfoText"]),
  :global([class*="cl-formFieldInfoText"] *),
  :global([class*="cl-formFieldWarningText"]),
  :global([class*="cl-formFieldWarningText"] *),
  :global([class*="cl-formFieldSuccessText"]),
  :global([class*="cl-formFieldSuccessText"] *) {
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    white-space: normal !important;
  }

  /* Specific targeting for orange verification text and containers */
  :global([class*="verification"]),
  :global([class*="verification"] *),
  :global([style*="orange"]),
  :global([style*="orange"] *),
  :global([style*="color: orange"]),
  :global([style*="color: orange"] *),
  :global([style*="color:rgb(255"]),
  :global([style*="color:rgb(255"] *) {
    box-sizing: border-box !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    width: 100% !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Target any element with text content that might overflow */
  :global(.clerk-form-card > *),
  :global(.cl-formCard > *),
  :global(.cl-card > *) {
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Aggressive targeting for any alert-like elements */
  :global([role="alert"]),
  :global([role="alert"] *),
  :global([data-clerk-element*="alert"]),
  :global([data-clerk-element*="alert"] *),
  :global([data-clerk-element*="warning"]),
  :global([data-clerk-element*="warning"] *),
  :global([data-clerk-element*="verification"]),
  :global([data-clerk-element*="verification"] *) {
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Clerk form alert class */
  .clerk-form-alert,
  .clerk-form-alert * {
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    overflow-wrap: break-word !important;
    word-wrap: break-word !important;
    white-space: normal !important;
    overflow-x: hidden !important;
  }

  /* Remove left and right padding on mobile */
  @media (max-width: 1159px) {
    .auth-page__form-section {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }

</style>
