<!-- Initialize navigation cache with server-rendered data -->
<script is:inline define:vars={{ threads, spaces, inboxCount }}>
  (function() {
    if (typeof window === 'undefined') return;
    
    // Inline cache initialization to avoid import issues
    const CACHE_KEY = 'harvous_navigation_cache';
    const CACHE_DURATION = 30 * 1000; // 30 seconds
    
    function setCachedNavigationData(data) {
      try {
        const cacheData = {
          threads: data.threads || [],
          spaces: data.spaces || [],
          inboxCount: data.inboxCount || 0,
          timestamp: Date.now()
        };
        localStorage.setItem(CACHE_KEY, JSON.stringify(cacheData));
      } catch (error) {
        console.warn('Failed to cache navigation data:', error);
      }
    }
    
    // Initialize cache with server-rendered data
    setCachedNavigationData({ threads, spaces, inboxCount });
    
    // Prefetch dashboard data using requestIdleCallback
    // Define schedulePrefetch outside conditional block so it's always available
    const schedulePrefetch = (callback) => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(callback, { timeout: 2000 });
      } else {
        setTimeout(callback, 1000);
      }
    };
    
    // Prefetch dashboard data in background (if on thread/note/space page)
    const currentPath = window.location.pathname;
    const isThreadPage = currentPath.startsWith('/thread_');
    const isNotePage = currentPath.startsWith('/note_');
    const isSpacePage = currentPath.startsWith('/space_');
    
    if (isThreadPage || isNotePage || isSpacePage) {
      schedulePrefetch(async () => {
        try {
          const response = await fetch('/api/navigation/data', { credentials: 'include' });
          if (response.ok) {
            const data = await response.json();
            setCachedNavigationData(data);
          }
        } catch (error) {
          // Silently fail - prefetch is non-critical
        }
      });
    }
    
    // Re-initialize after View Transitions (debounced to avoid multiple calls)
    let pageLoadTimeout = null;
    document.addEventListener('astro:page-load', () => {
      // Debounce to avoid multiple rapid calls
      if (pageLoadTimeout) clearTimeout(pageLoadTimeout);
      pageLoadTimeout = setTimeout(() => {
        // Re-cache with current data
        setCachedNavigationData({ threads, spaces, inboxCount });
        
        // Re-prefetch if needed
        const newPath = window.location.pathname;
        const isThread = newPath.startsWith('/thread_');
        const isNote = newPath.startsWith('/note_');
        const isSpace = newPath.startsWith('/space_');
        
        if (isThread || isNote || isSpace) {
          schedulePrefetch(async () => {
            try {
              const response = await fetch('/api/navigation/data', { credentials: 'include' });
              if (response.ok) {
                const data = await response.json();
                setCachedNavigationData(data);
              }
            } catch (error) {
              // Silently fail
            }
          });
        }
      }, 50);
    });
  })();
</script>
 
<script type="text/javascript">
  // Helper function to safely import and use astro:transitions/client
  // Falls back to window.location if the module fails to load (e.g., on Mobile Safari)
  async function safeNavigate(path, options) {
    try {
      const { navigate } = await import('astro:transitions/client');
      navigate(path, options);
    } catch (error) {
      // Module failed to load - fall back to window.location
      // This prevents unhandled promise rejections that PostHog catches
      if (options?.history === 'replace') {
        window.location.replace(path);
      } else {
        window.location.href = path;
      }
    }
  }
  
  // Set the global save callback for CardFullEditable
  var noteSaveCallback = async function(newTitle, newContent) {
    try {
      // Get note ID from the data attribute on the container
      const container = document.querySelector('[data-note-id]');
      const noteId = container?.getAttribute('data-note-id');
      
      
      if (!noteId) {
        throw new Error('Note ID not found');
      }
      
      const response = await fetch('/api/notes/update', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        credentials: 'include',
        body: JSON.stringify({
          noteId: noteId,
          title: newTitle,
          content: newContent
        })
      });
      
      
      if (!response.ok) {
        const errorText = await response.text();
        throw new Error('Failed to update note');
      }
      
      const result = await response.json();
      return result;
    } catch (error) {
      throw error;
    }
  };
  
  // Listen for note thread changes and refresh the page using View Transitions
  window.addEventListener('noteAddedToThread', async (event) => {
    const { noteId, threadId } = event.detail;
    
    // Check if we're on the affected thread page
    const currentThreadId = window.location.pathname.substring(1);
    if (currentThreadId === threadId) {
      // Navigate using View Transitions to show updated note list
      await safeNavigate(window.location.pathname + window.location.search, { history: 'replace' });
      return;
    }
    
    // Also refresh if we're viewing unorganized and a note was added to another thread
    // (the note is no longer in unorganized when it has a thread association)
    if (currentThreadId === 'thread_unorganized' && threadId !== 'thread_unorganized') {
      await safeNavigate(window.location.pathname + window.location.search, { history: 'replace' });
    }
  });
  
  window.addEventListener('noteRemovedFromThread', async (event) => {
    const { noteId, threadId, remainingThreadIds } = event.detail;
    
    // Check if we're on the affected thread page
    const currentThreadId = window.location.pathname.substring(1);
    if (currentThreadId === threadId) {
      // Navigate using View Transitions to show updated note list
      await safeNavigate(window.location.pathname + window.location.search, { history: 'replace' });
      return;
    }
    
    // Check if we're viewing the note that was removed from thread
    const noteContainer = document.querySelector('[data-note-id]');
    const currentNoteId = noteContainer?.getAttribute('data-note-id');
    const currentSelectedThreadId = noteContainer?.getAttribute('data-selected-thread-id');
    
    if (currentNoteId === noteId && currentSelectedThreadId === threadId) {
      // We're viewing the note and it was removed from the current thread context
      // Need to navigate to another thread or unorganized/dashboard
      
      let targetUrl = '/';
      
      // If remainingThreadIds provided in event, use them
      if (remainingThreadIds && remainingThreadIds.length > 0) {
        // Navigate to the first remaining thread
        targetUrl = `/${remainingThreadIds[0]}`;
      } else {
        // Fetch remaining threads for the note
        try {
          const response = await fetch(`/api/notes/${noteId}/details`, {
            credentials: 'include'
          });
          
          if (response.ok) {
            const data = await response.json();
            const threads = data.threads || [];
            
            if (threads.length > 0) {
              // Navigate to first remaining thread
              targetUrl = `/${threads[0].id}`;
            } else {
              // No threads remaining, navigate to unorganized or dashboard
              targetUrl = '/thread_unorganized';
            }
          }
        } catch (error) {
          console.error('Error fetching note details for navigation:', error);
          // Fallback to unorganized
          targetUrl = '/thread_unorganized';
        }
      }
      
      // Navigate to the target URL
      await safeNavigate(targetUrl, { history: 'replace' });
    }
  });
  
  // Listen for thread deletion - navigate if viewing note in that thread
  document.addEventListener('threadDeleted', async (event) => {
    const { threadId } = event.detail;
    
    // Check if we're viewing a note that might have been in the deleted thread
    const noteContainer = document.querySelector('[data-note-id]');
    if (noteContainer) {
      const currentSelectedThreadId = noteContainer?.getAttribute('data-selected-thread-id');
      
      // If the deleted thread matches the current thread context, navigate away
      if (currentSelectedThreadId === threadId) {
        const noteId = noteContainer.getAttribute('data-note-id');
        
        // Fetch remaining threads for the note
        let targetUrl = '/thread_unorganized';
        
        try {
          const response = await fetch(`/api/notes/${noteId}/details`, {
            credentials: 'include'
          });
          
          if (response.ok) {
            const data = await response.json();
            const threads = data.threads || [];
            
            if (threads.length > 0) {
              // Navigate to first remaining thread
              targetUrl = `/${threads[0].id}`;
            } else {
              // No threads remaining, navigate to unorganized
              targetUrl = '/thread_unorganized';
            }
          }
        } catch (error) {
          console.error('Error fetching note details for navigation:', error);
          // Fallback to unorganized
          targetUrl = '/thread_unorganized';
        }
        
        // Navigate to the target URL
        await safeNavigate(targetUrl, { history: 'replace' });
      }
    }
  });
  
  // Listen for space deletion - navigate if viewing space or content within it
  document.addEventListener('spaceDeleted', async (event) => {
    const { spaceId } = event.detail;
    
    const currentPath = window.location.pathname;
    const currentId = currentPath.substring(1);
    
    // Check if we're viewing the deleted space
    if (currentId === spaceId) {
      // Navigate to dashboard
      await safeNavigate('/', { history: 'replace' });
      return;
    }
    
    // Check if we're viewing a thread or note that belongs to the deleted space
    // We can check data attributes or fetch to verify
    const spaceContainer = document.querySelector('[data-space-id]');
    const currentSpaceId = spaceContainer?.getAttribute('data-space-id');
    
    if (currentSpaceId === spaceId) {
      // Navigate to dashboard
      await safeNavigate('/', { history: 'replace' });
    }
  });
  
  // Listen for items removed from space - refresh space page if viewing it
  document.addEventListener('itemRemovedFromSpace', async (event) => {
    const { spaceId } = event.detail;
    
    const currentPath = window.location.pathname;
    const currentId = currentPath.substring(1);
    
    // If viewing the space, refresh it to show updated content
    if (currentId === spaceId) {
      await safeNavigate(window.location.pathname + window.location.search, { history: 'replace' });
    }
  });
  
  // Detect page type (client-side)
  const currentPath = window.location.pathname;
  
  // More specific detection logic
  const isThread = currentPath.includes('/thread_') || (currentPath.match(/^\/thread_[a-zA-Z0-9_-]+$/) && currentPath !== '/' && !currentPath.includes('/sign-in') && !currentPath.includes('/sign-up'));
  const isNote = currentPath.includes('/note_') || (currentPath.match(/^\/note_[a-zA-Z0-9_-]+$/) && currentPath !== '/' && !currentPath.includes('/sign-in') && !currentPath.includes('/sign-up'));
  
  // Track thread context for smart navigation (only on thread pages)
  if (window.trackThreadContext && isThread) {
    const threadId = window.location.pathname.substring(1);
    window.trackThreadContext(threadId);
  }
  
  // Enhanced breadcrumb navigation tracking (on thread pages)
  if (isThread) {
    const threadId = window.location.pathname.substring(1);
    
    // Track referrer-based context for breadcrumb navigation
    if (window.getThreadContextFromReferrer) {
      const referrerThreadId = window.getThreadContextFromReferrer();
      if (referrerThreadId) {
        localStorage.setItem('harvous-referrer-thread-context', referrerThreadId);
      }
    }
    
    // Add click handlers to note links for breadcrumb tracking
    document.addEventListener('click', function(event) {
      const link = event.target.closest('a[href]');
      if (link) {
        const href = link.getAttribute('href');
        
        // Check if it's a note link (starts with / and contains note ID pattern)
        if (href && href.startsWith('/') && href.length > 1) {
          const noteId = href.split('/').pop();
          
          // Check if it looks like a note ID (not a thread or space ID)
          if (noteId && noteId !== 'dashboard' && noteId !== 'sign-in' && noteId !== 'sign-up' && !noteId.startsWith('thread_') && !noteId.startsWith('space_')) {
            if (window.trackBreadcrumbNavigation) {
              window.trackBreadcrumbNavigation(threadId, noteId);
            }
          }
        }
      }
    });
  }
  
  // Debug breadcrumb data on note pages
  if (isNote) {
    // Wrap in try-catch to prevent script breaking
    try {
      const breadcrumbData = localStorage.getItem('harvous-breadcrumb-navigation');
      if (breadcrumbData) {
        try {
          const parsed = JSON.parse(breadcrumbData);
          const age = Date.now() - parsed.timestamp;
          
          // Check if the breadcrumb data is valid
          if (parsed.fromThreadId && parsed.toNoteId && parsed.timestamp) {
            // Apply the breadcrumb context immediately
            localStorage.setItem('harvous-current-thread-context', parsed.fromThreadId);
            localStorage.setItem('harvous-thread-context-timestamp', Date.now().toString());
            
            // Force update the React component with the correct thread context
            setTimeout(() => {
              try {
                // Update the data attributes on the container
                const container = document.querySelector('[data-note-id]');
                if (container) {
                  container.setAttribute('data-selected-thread-id', parsed.fromThreadId);
                  container.setAttribute('data-parent-thread-id', parsed.fromThreadId);
                  
                  // Trigger a custom event to update the React component
                  const event = new CustomEvent('breadcrumbContextUpdate', {
                    detail: { threadId: parsed.fromThreadId }
                  });
                  window.dispatchEvent(event);
                }
              } catch (updateError) {
                // Error updating container
              }
            }, 100);
          }
        } catch (parseError) {
          // Error parsing breadcrumb data
        }
      }
    } catch (breadcrumbError) {
      // Error in breadcrumb logic
    }
  }
  
</script>


