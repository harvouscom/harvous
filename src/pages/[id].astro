---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import CardStack from "@/components/CardStack.astro";
import CardFull from "@/components/CardFull.astro";
import CardFullEditableReact from "@/components/CardFullEditableReact.astro";
import SearchInput from "@/components/SearchInput.astro";
import SquareButton from "@/components/SquareButton.astro";
import Avatar from "@/components/Avatar.astro";
import TabNav from "@/components/TabNav.astro";
import TabNavReact from "@/components/react/TabNav";
import CardNote from "@/components/CardNote.astro";
import CondensedNoteItem from "@/components/react/CondensedNoteItem";
import ThreadNotesList from "@/components/react/ThreadNotesList";
import SpaceContentList from "@/components/react/SpaceContentList";
import CardThread from "@/components/CardThread.astro";
import NavigationColumnReact from "@/components/NavigationColumnReact.astro";
import OfflineThreadLoader from "@/components/react/OfflineThreadLoader";
import ThreadCardStackHeader from "@/components/react/ThreadCardStackHeader";
import SpaceCardStackHeader from "@/components/react/SpaceCardStackHeader";
import { db, Threads, Notes, Spaces, NoteThreads, ScriptureMetadata, ResourceMetadata, eq, and, desc, count, ne } from "astro:db";
import { getAllThreadsWithCounts, getThreadWithCount, getSpacesWithCounts, getNotesForThread, getThreadsForSpace, getNotesForSpace, getInboxCount, getInboxDisplayCount, getThreadNoteTypeCounts } from "@/utils/dashboard-data";
import { getThreadColorCSS, getThreadGradientCSS, getThreadTextColorCSS } from "@/utils/colors";
// Sample data imports removed - using real database data only
import { detectActiveThreadFromPath } from "@/utils/navigation-state";
import { debug } from "@/utils/logger";
import { stripHtml } from "@/utils/html-stripper";

// Helper function to determine if lastVisited should be updated
// Returns true if this is a new visit (not a refresh of the same page)
function shouldUpdateLastVisitedTimestamp(request: Request, currentPath: string): boolean {
  try {
    // FIRST CHECK: Explicit prefetch requests should NEVER update lastVisited
    // This catches background precaching from precacheRecentContent and similar utilities
    const isPrefetch = request.headers.get('x-prefetch-request');
    if (isPrefetch) {
      debug('[shouldUpdateLastVisitedTimestamp] Prefetch request detected, skipping update');
      return false;
    }

    // SECOND CHECK: Browser prefetch (Astro prefetch, <link rel="prefetch">, etc.)
    // Check for standard prefetch purpose headers
    const purpose = request.headers.get('purpose') || request.headers.get('x-moz-prefetch');
    if (purpose === 'prefetch') {
      debug('[shouldUpdateLastVisitedTimestamp] Browser prefetch detected, skipping update');
      return false;
    }

    const referrer = request.headers.get('referer');

    // IMPORTANT: Check Cache-Control header for browser refresh indicators
    // When user does a hard refresh (Cmd+R or F5), browsers send specific cache headers
    const cacheControl = request.headers.get('cache-control');
    const pragma = request.headers.get('pragma');

    // If cache-control indicates a refresh (max-age=0 or no-cache), don't update
    // This catches hard refreshes where referrer might be missing
    if (cacheControl && (cacheControl.includes('max-age=0') || cacheControl.includes('no-cache'))) {
      debug('[shouldUpdateLastVisitedTimestamp] Refresh detected via cache-control, skipping update');
      return false;
    }
    if (pragma && pragma.includes('no-cache')) {
      debug('[shouldUpdateLastVisitedTimestamp] Refresh detected via pragma, skipping update');
      return false;
    }

    // Parse referrer URL
    const referrerUrl = referrer ? new URL(referrer) : null;
    const referrerPath = referrerUrl?.pathname;

    // Get current URL to compare origins and check for closed item parameter
    const currentUrl = new URL(request.url);

    // Note: Closed item handling is automatic - when closing an item,
    // we navigate away from it, so its page doesn't load and lastVisited isn't updated

    // Strip query parameters and hash from both paths for comparison
    // This handles cases like /thread_123?tab=all vs /thread_123
    const normalizePath = (path: string): string => {
      // Remove query string and hash
      return path.split('?')[0].split('#')[0];
    };

    const normalizedCurrentPath = normalizePath(currentPath);

    // If referrer exists and is from the same origin, compare paths
    if (referrerUrl && referrerPath) {
      // If referrer is from a different origin, it's a new visit - update
      if (referrerUrl.origin !== currentUrl.origin) {
        debug('[shouldUpdateLastVisitedTimestamp] Cross-origin navigation detected, updating lastVisited');
        return true;
      }

      const normalizedReferrerPath = normalizePath(referrerPath);

      // If referrer is the same page (normalized), it's a refresh - don't update
      if (normalizedReferrerPath === normalizedCurrentPath) {
        debug('[shouldUpdateLastVisitedTimestamp] Same page refresh detected, skipping update');
        return false;
      }

      // Different page on same origin - this is a new visit - update
      debug('[shouldUpdateLastVisitedTimestamp] Same-origin navigation to different page, updating lastVisited');
      return true;
    }

    // No referrer - this could be:
    // 1. Direct navigation (URL bar, bookmark) - should update
    // 2. Page refresh in PWA - should NOT update
    // 3. PWA app resumption (launching app to last viewed page) - should NOT update
    // 4. Opening link in new tab - should update
    //
    // Check Sec-Fetch headers for more context
    const secFetchSite = request.headers.get('sec-fetch-site');
    const secFetchMode = request.headers.get('sec-fetch-mode');
    const secFetchDest = request.headers.get('sec-fetch-dest');

    // Check for PWA launch scenario using cookie-based session tracking
    // The client-side script sets a cookie when PWA launches, which we can read here
    const cookies = request.headers.get('cookie') || '';
    const pwaLaunchMatch = cookies.match(/harvous-pwa-launch-time=(\d+)/);
    if (pwaLaunchMatch) {
      const launchTime = parseInt(pwaLaunchMatch[1], 10);
      const now = Date.now();
      const timeSinceLaunch = now - launchTime;
      // If request is within 5 seconds of PWA launch, treat as app resumption
      if (timeSinceLaunch < 5000) {
        debug('[shouldUpdateLastVisitedTimestamp] PWA app resumption detected (launched ' + timeSinceLaunch + 'ms ago), skipping update');
        return false;
      }
    }

    // If Sec-Fetch-Site is 'same-origin', this is likely a refresh or internal navigation
    // without a proper referrer (can happen in PWAs or after service worker interactions)
    if (secFetchSite === 'same-origin') {
      // Additional check: if Sec-Fetch-Mode is 'navigate' but no referrer, it might be a PWA restoration
      // In this case, err on the side of NOT updating to preserve order
      if (secFetchMode === 'navigate' && secFetchDest === 'document') {
        debug('[shouldUpdateLastVisitedTimestamp] Same-origin navigate without referrer (likely PWA restoration), skipping update');
        return false;
      }
      debug('[shouldUpdateLastVisitedTimestamp] Same-origin request without referrer, skipping update');
      return false;
    }

    // If Sec-Fetch-Site is 'none', check additional context
    if (secFetchSite === 'none') {
      // If Sec-Fetch-Mode is 'navigate' and Sec-Fetch-Dest is 'document', this could be:
      // 1. Direct URL bar navigation (should update)
      // 2. PWA launch/restoration (should NOT update)
      // 
      // For PWA launches, we check if this happens very early in the session
      // If Sec-Fetch-Mode is not 'navigate', it's likely not a user-initiated navigation
      if (secFetchMode !== 'navigate') {
        debug('[shouldUpdateLastVisitedTimestamp] Sec-Fetch-Site=none but mode is not navigate, skipping update');
        return false;
      }
      
      // If it's a navigate with 'none' site, it could be a bookmark or direct URL entry
      // But to be safe for PWAs, we'll only update if we're confident it's user-initiated
      // Check if there's a user-agent hint that suggests this is a real navigation
      const userAgent = request.headers.get('user-agent') || '';
      const isMobilePWA = userAgent.includes('Mobile') && (userAgent.includes('Safari') || userAgent.includes('Chrome'));
      
      // For mobile PWAs, be more conservative - only update if we have strong evidence
      if (isMobilePWA) {
        debug('[shouldUpdateLastVisitedTimestamp] Mobile PWA with sec-fetch-site=none, being conservative and skipping update');
        return false;
      }
      
      debug('[shouldUpdateLastVisitedTimestamp] Direct navigation detected (sec-fetch-site=none, mode=navigate), updating lastVisited');
      return true;
    }

    // If we still can't determine, check if this looks like the user is coming from
    // within the app by looking at other request characteristics
    // For safety in ambiguous cases, we'll now default to NOT updating to prevent
    // random order changes on refresh
    debug('[shouldUpdateLastVisitedTimestamp] Ambiguous case, defaulting to NOT updating to preserve order');
    return false;
  } catch (error) {
    // If we can't determine due to error, don't update to prevent random reordering
    console.error('[shouldUpdateLastVisitedTimestamp] Error:', error);
    return false;
  }
}

import { ensureUnorganizedThread } from "@/utils/unorganized-thread";
import MobileNavigation from "@/components/MobileNavigation.astro";
import MobileAdditional from "@/components/MobileAdditional.astro";

// Dynamic routing - no static paths needed

// Get user data from Clerk authentication
const auth = Astro.locals.auth();
const { userId } = auth;

// Auth redirect is now handled by middleware - no need to check here
// Pages can still use userId for conditional rendering
// Type guard: middleware ensures userId exists, but TypeScript doesn't know this
if (!userId) {
  throw new Error('User ID is required but not found');
}

// Now TypeScript knows userId is non-null
const authenticatedUserId: string = userId;

// Get cached user data (optimized - no API calls on every page load)
import { getCachedUserData, type CachedUserData } from '@/utils/user-cache';

let userData: CachedUserData;
try {
  userData = await getCachedUserData(authenticatedUserId);
} catch (error) {
  // Fallback data
  userData = {
    firstName: '',
    lastName: '',
    email: '',
    initials: 'U',
    displayName: 'User',
    userColor: 'paper',
  };
}

const { firstName, lastName, initials, userColor } = userData;

// Cache-Control for Netlify function optimization (repeat visits served from CDN when valid)
Astro.response.headers.set('Cache-Control', 'private, max-age=60, stale-while-revalidate=120');

const { id } = Astro.params;

// Determine if this is a thread, note, or space based on the ID prefix
const isThread = id?.startsWith('thread_');
const isNote = id?.startsWith('note_');
const isSpace = id?.startsWith('space_');
// Detect offline thread IDs (local_ prefix)
const isOfflineThread = id?.startsWith('local_');

// Determine content type for context-aware More menu
let contentType: "thread" | "note" | "space" | "dashboard" = "dashboard";
if (isThread || isOfflineThread) contentType = "thread";
else if (isNote) contentType = "note";
else if (isSpace) contentType = "space";

let content: any = null;
let threads: any[] = [];
let spaces: any[] = [];
let pageTitle = "";
let pageContent = "";
let currentThread: any = null;
let currentSpace: any = null;
let threadNotes: any[] = [];
let noteTypeCounts: { all: number; default: number; scripture: number; resource: number } | null = null;
let inboxCount: number = 0;

// Always use real database data
try {
    if (isThread) {
      // Special handling for unorganized thread
      if (id === 'thread_unorganized') {
        // Ensure the unorganized thread exists in database and get actual count
        const unorganizedThreadData = await ensureUnorganizedThread(authenticatedUserId);
        const [notesResult, noteTypeCountsData] = await Promise.all([
          getNotesForThread(id!, authenticatedUserId),
          getThreadNoteTypeCounts(id!, authenticatedUserId)
        ]);
        const notesData = Array.isArray(notesResult) ? [] : notesResult.notes;
        
        content = {
          id: 'thread_unorganized',
          title: 'Unorganized',
          subtitle: 'Individual notes and unassigned content',
          color: null,
          spaceId: null,
          notes: notesData,
          noteCount: unorganizedThreadData.noteCount
        };
        currentThread = {
          id: 'thread_unorganized',
          title: 'Unorganized',
          color: null,
          spaceId: null,
          noteCount: unorganizedThreadData.noteCount,
          backgroundGradient: getThreadGradientCSS('paper')
        };
        
          // Set threadNotes for template rendering
          threadNotes = notesData;
          // Store note type counts for tab badges
          noteTypeCounts = noteTypeCountsData;
          
          pageTitle = 'Unorganized';
          pageContent = `${unorganizedThreadData.noteCount} notes`;
      } else {
        // Update lastVisited timestamp FIRST, before fetching data
        // This ensures fetched data includes the updated lastVisited timestamp
        // Only update if this is a new visit (not a refresh)
        const shouldUpdate = shouldUpdateLastVisitedTimestamp(Astro.request, Astro.url.pathname);
        if (shouldUpdate) {
          try {
            // Throttle: Only update if > 3 seconds since last update
            // Prevents accidental double-clicks and rapid refreshes
            // With hover prefetch disabled, 3 seconds is sufficient
            const currentThread = await db.select({ lastVisited: Threads.lastVisited })
              .from(Threads)
              .where(and(eq(Threads.id, id!), eq(Threads.userId, authenticatedUserId)))
              .get();

            const now = new Date();
            const threeSecondsAgo = new Date(now.getTime() - 3 * 1000);

            if (!currentThread?.lastVisited || new Date(currentThread.lastVisited) < threeSecondsAgo) {
              await db.update(Threads)
                .set({ lastVisited: now })
                .where(and(eq(Threads.id, id!), eq(Threads.userId, authenticatedUserId)));
            }
          } catch (error) {
            // Log error but don't fail page load
            console.error(`[id].astro] Error updating lastVisited for thread ${id}:`, error);
          }
        }
        
        // NOW fetch thread and its notes from database (with updated lastVisited)
        // Use getThreadWithCount for single thread lookup (much faster than getAllThreadsWithCounts)
        const [threadData, notesResult, noteTypeCountsData] = await Promise.all([
          getThreadWithCount(id!, authenticatedUserId),
          getNotesForThread(id!, authenticatedUserId),
          getThreadNoteTypeCounts(id!, authenticatedUserId)
        ]);
        const notesData = Array.isArray(notesResult) ? [] : notesResult.notes;
        
        debug(`[id].astro] Thread lookup`, { id, found: !!threadData, title: threadData?.title });
        
        if (threadData) {
          content = {
            id: threadData.id,
            title: threadData.title,
            subtitle: threadData.subtitle,
            color: threadData.color,
            spaceId: threadData.spaceId,
            notes: notesData,
            noteCount: threadData.noteCount
          };
          currentThread = {
            id: threadData.id,
            title: threadData.title,
            color: threadData.color,
            spaceId: threadData.spaceId || null,
            noteCount: threadData.noteCount,
            backgroundGradient: getThreadGradientCSS(threadData.color)
          };
          
          // Set threadNotes for template rendering
          threadNotes = notesData;
          // Store note type counts for tab badges
          noteTypeCounts = noteTypeCountsData;
          
          pageTitle = threadData.title;
          pageContent = `${threadData.noteCount} notes`;
        } else {
          // Fallback: Query thread directly by ID if not found in getAllThreadsWithCounts
          // This can happen for newly created threads that haven't been indexed yet
          debug(`[id].astro] Fallback: Querying thread directly`, { id });
          
          // Retry logic for newly created threads that might not be committed yet
          let thread = null;
          let retries = 0;
          const maxRetries = 3;
          
          while (!thread && retries < maxRetries) {
            try {
              thread = await db.select()
                .from(Threads)
                .where(and(eq(Threads.id, id!), eq(Threads.userId, authenticatedUserId)))
                .get();
              
              if (!thread && retries < maxRetries - 1) {
                // Small delay before retry (for database commit timing)
                await new Promise(resolve => setTimeout(resolve, 100));
                retries++;
                debug(`[id].astro] Thread not found, retrying`, { retries, maxRetries });
              } else {
                break;
              }
            } catch (error) {
              console.error(`[id].astro] Error querying thread ${id} (attempt ${retries + 1}):`, error);
              if (retries < maxRetries - 1) {
                await new Promise(resolve => setTimeout(resolve, 100));
                retries++;
              } else {
                break;
              }
            }
          }
          
          debug(`[id].astro] Direct thread query result`, { found: !!thread, title: thread?.title });
          
          if (thread) {
            // Get actual note count from database using junction table
            const noteCountResult = await db.select({ count: count() })
              .from(Notes)
              .innerJoin(NoteThreads, eq(NoteThreads.noteId, Notes.id))
              .where(and(
                eq(NoteThreads.threadId, thread.id),
                eq(Notes.userId, authenticatedUserId)
              ))
              .get();
            
            const noteCount = noteCountResult?.count || 0;
            debug(`[id].astro] Thread note count`, { noteCount });
            
            content = {
              id: thread.id,
              title: thread.title,
              subtitle: thread.subtitle,
              color: thread.color,
              spaceId: thread.spaceId,
              notes: notesData,
              noteCount: noteCount
            };
            currentThread = {
              id: thread.id,
              title: thread.title,
              color: thread.color,
              spaceId: thread.spaceId || null,
              noteCount: noteCount,
              backgroundGradient: getThreadGradientCSS(thread.color)
            };
            
            // Set threadNotes for template rendering
            threadNotes = notesData;
            // Store note type counts for tab badges
            noteTypeCounts = noteTypeCountsData;
            
            pageTitle = thread.title;
            pageContent = `${noteCount} notes`;
            debug(`[id].astro] Successfully set up thread content`, { title: thread.title });
            
            // Note: lastVisited was already updated before data fetch (see above)
          } else {
            // Thread not found even in direct query
            // Check if this is an offline thread (local_ prefix)
            if (isOfflineThread) {
              // Set up minimal content for offline thread - will be hydrated by client-side loader
              content = {
                id: id!,
                title: 'Loading...',
                subtitle: null,
                color: null,
                spaceId: null,
                notes: [],
                noteCount: 0
              };
              currentThread = {
                id: id!,
                title: 'Loading...',
                color: null,
                spaceId: null,
                noteCount: 0,
                backgroundGradient: getThreadGradientCSS('paper')
              };
              threadNotes = [];
              noteTypeCounts = { all: 0, default: 0, scripture: 0, resource: 0 };
              pageTitle = 'Loading...';
              pageContent = '0 notes';
            } else {
              // Thread not found and not an offline thread - log for debugging
              console.error(`[id].astro] Thread not found in direct query: ${id} for user: ${authenticatedUserId}`);
              // Also check if thread exists at all (without userId check) for debugging
              const anyThread = await db.select()
                .from(Threads)
                .where(eq(Threads.id, id!))
                .get();
              console.error(`[id].astro] Thread exists in DB (any user):`, !!anyThread, anyThread ? `userId: ${anyThread.userId}` : 'N/A');
            }
          }
        }
      }
    } else if (isNote) {
      // Update lastVisited timestamp FIRST, before fetching data
      // This ensures fetched data includes the updated lastVisited timestamp
      // Only update if this is a new visit (not a refresh)
      const shouldUpdate = shouldUpdateLastVisitedTimestamp(Astro.request, Astro.url.pathname);
      if (shouldUpdate) {
        try {
          // Throttle: Only update if > 3 seconds since last update
          // Prevents accidental double-clicks and rapid refreshes
          // With hover prefetch disabled, 3 seconds is sufficient
          const currentNote = await db.select({ lastVisited: Notes.lastVisited })
            .from(Notes)
            .where(and(eq(Notes.id, id!), eq(Notes.userId, authenticatedUserId)))
            .get();

          const now = new Date();
          const threeSecondsAgo = new Date(now.getTime() - 3 * 1000);

          if (!currentNote?.lastVisited || new Date(currentNote.lastVisited) < threeSecondsAgo) {
            await db.update(Notes)
              .set({ lastVisited: now })
              .where(and(eq(Notes.id, id!), eq(Notes.userId, authenticatedUserId)));
          }
        } catch (error) {
          // Log error but don't fail page load
          console.error(`[id].astro] Error updating lastVisited for note ${id}:`, error);
        }
      }
      
      // NOW fetch note from database (with updated lastVisited)
      const note = await db.select().from(Notes).where(eq(Notes.id, id!)).get();
      
      if (note) {
        // Fetch scripture metadata if this is a scripture note
        let version: string | undefined;
        if (note.noteType === 'scripture') {
          try {
            const scriptureMeta = await db.select()
              .from(ScriptureMetadata)
              .where(eq(ScriptureMetadata.noteId, note.id))
              .get();
            version = scriptureMeta?.translation;
            
          } catch (error: any) {
            // Error fetching ScriptureMetadata - version will remain undefined
          }
        }

        // Fetch resource metadata if this is a resource note
        let resourceTitle: string | undefined;
        let resourceDescription: string | undefined;
        let resourceImage: string | undefined;
        let resourceUrl: string | undefined;
        if (note.noteType === 'resource') {
          try {
            const resourceMeta = await db.select()
              .from(ResourceMetadata)
              .where(eq(ResourceMetadata.noteId, note.id))
              .get();
            if (resourceMeta) {
              resourceTitle = resourceMeta.sourceTitle || undefined;
              resourceDescription = resourceMeta.sourceDescription || undefined;
              resourceImage = resourceMeta.sourceImage || undefined;
              resourceUrl = resourceMeta.sourceUrl || undefined;
            }
          } catch (error: any) {
            // Error fetching ResourceMetadata - values will remain undefined
          }
        }

        content = {
          id: note.id,
          title: note.title,
          content: note.content,
          threadId: note.threadId,
          createdAt: note.createdAt,
          noteId: note.simpleNoteId,
          updatedAt: note.updatedAt,
          noteType: note.noteType || 'default',
          version,
          resourceTitle,
          resourceDescription,
          resourceImage,
          resourceUrl,
          contentEncrypted: note.contentEncrypted ?? false
        };

        // Set page title for note
        pageTitle = note.title || "Untitled Note";

        // Note: lastVisited was already updated before data fetch (see above)

        // Smart Default Logic for Multi-Thread Navigation
        // Priority order:
        // 1. URL parameter (?thread=threadId) - explicit user choice
        // 2. Referrer thread context (where user came from)
        // 3. Most recently updated thread (fallback)
        // For Scripture notes: prioritize thread context where note was opened from
        
        const urlParams = new URL(Astro.url.href).searchParams;
        const requestedThreadId = urlParams.get('thread');
        const isScriptureNote = note.noteType === 'scripture';
        
        let selectedThreadId = null; // No default - will be determined by logic below
        
        if (requestedThreadId) {
          // Priority 1: URL parameter - verify the requested thread exists and note belongs to it
          const noteThreads = await db.select()
            .from(NoteThreads)
            .where(eq(NoteThreads.noteId, note.id))
            .all();
          
          const threadIds = noteThreads.map(nt => nt.threadId);
          if (threadIds.includes(requestedThreadId)) {
            selectedThreadId = requestedThreadId;
          }
        } else {
          // Priority 2 & 3: Smart Default - Use navigation context if available
          // Check if user was recently viewing a thread that this note belongs to
          const noteThreads = await db.select()
            .from(NoteThreads)
            .where(eq(NoteThreads.noteId, note.id))
            .all();
          
          // Pure junction table approach: Only use junction table for thread relationships
          const uniqueThreadIds = noteThreads.map(nt => nt.threadId);
          
          if (uniqueThreadIds.length > 1) {
            // Note belongs to multiple threads - use smart default
            // Enhanced breadcrumb-like logic for thread context detection
            // For Scripture notes: prioritize thread where note was opened from
            let navigationHistoryThreadId = null;
            try {
              // Priority 2: Check referrer for thread context (server-side approach)
              const referrer = Astro.request.headers.get('referer');
              
              if (referrer) {
                try {
                  const referrerUrl = new URL(referrer);
                  const referrerPath = referrerUrl.pathname;
                  
                  // Check if referrer is a thread page
                  if (referrerPath.includes('/thread_') || (!referrerPath.includes('/note_') && !referrerPath.includes('/space_') && !referrerPath.includes('/dashboard'))) {
                    const threadId = referrerPath.split('/').pop();
                    
                    if (threadId && threadId !== 'dashboard' && threadId !== 'sign-in' && threadId !== 'sign-up' && 
                        !threadId.startsWith('note_') && !threadId.startsWith('space_')) {
                      // Verify this thread is one the note belongs to
                      if (uniqueThreadIds.includes(threadId)) {
                        navigationHistoryThreadId = threadId;
                      }
                    }
                  }
                  
                  // Check if referrer is a note page - extract thread from query params
                  // This is especially important for Scripture notes opened from other notes
                  if (!navigationHistoryThreadId && referrerPath.includes('/note_')) {
                    const referrerThreadParam = referrerUrl.searchParams.get('thread');
                    if (referrerThreadParam && uniqueThreadIds.includes(referrerThreadParam)) {
                      navigationHistoryThreadId = referrerThreadParam;
                    }
                  }
                } catch (parseError) {
                  // Could not parse referrer URL
                }
              }
              
              // Priority 3: Fallback to most recently updated thread
              // For Scripture notes, this only applies if no referrer context was found
            } catch (error) {
              // Could not access navigation history
            }
            
            if (navigationHistoryThreadId) {
              // Use the thread from navigation history/referrer
              // This ensures Scripture notes open in the thread they were clicked from
              selectedThreadId = navigationHistoryThreadId;
            } else {
              // Fallback: Use the most recently updated thread
              // Only used when no referrer context is available
              const threads = await Promise.all(
                uniqueThreadIds.map(async (threadId) => {
                  const thread = await db.select()
                    .from(Threads)
                    .where(and(eq(Threads.id, threadId), eq(Threads.userId, authenticatedUserId)))
                    .get();
                  return thread;
                })
              );
              
              // Filter out null results and sort by most recent
              const validThreads = threads.filter(thread => thread !== null)
                .sort((a, b) => {
                  if (!a || !b) return 0;
                  const aTime = a.updatedAt || a.createdAt;
                  const bTime = b.updatedAt || b.createdAt;
                  return bTime.getTime() - aTime.getTime();
                });
              
              if (validThreads.length > 0 && validThreads[0]) {
                selectedThreadId = validThreads[0].id;
              }
            }
          } else if (uniqueThreadIds.length === 1) {
            // Note belongs to only one thread - use that thread
            selectedThreadId = uniqueThreadIds[0];
          } else {
            // Note has no threads - use unorganized thread as fallback
            selectedThreadId = 'thread_unorganized';
          }
        }

        // Get the selected thread context
        if (selectedThreadId === 'thread_unorganized') {
          // Special handling for unorganized thread - get actual count
          const unorganizedThreadData = await ensureUnorganizedThread(authenticatedUserId);
          currentThread = {
            id: 'thread_unorganized',
            title: 'Unorganized',
            color: null,
            spaceId: null,
            noteCount: unorganizedThreadData.noteCount,
            backgroundGradient: getThreadGradientCSS('paper')
          };
        } else if (selectedThreadId) {
          const thread = await db.select().from(Threads).where(eq(Threads.id, selectedThreadId)).get();
          
          if (thread) {
            // Get actual note count from database using junction table
            const noteCountResult = await db.select({ count: count() })
              .from(Notes)
              .innerJoin(NoteThreads, eq(NoteThreads.noteId, Notes.id))
              .where(and(
                eq(NoteThreads.threadId, selectedThreadId),
                eq(Notes.userId, authenticatedUserId)
              ))
              .get();
            
            currentThread = {
              id: thread.id,
              title: thread.title,
              color: thread.color,
              spaceId: thread.spaceId || null,
              noteCount: noteCountResult?.count || 0,
              backgroundGradient: getThreadGradientCSS(thread.color)
            };
          } else {
            // Selected thread doesn't exist (might have been deleted)
            // Try to use one of the other threads the note belongs to
            const noteThreads = await db.select()
              .from(NoteThreads)
              .where(eq(NoteThreads.noteId, note.id))
              .all();
            
            const threadIds = noteThreads.map(nt => nt.threadId).filter(tid => tid !== selectedThreadId);
            
            if (threadIds.length > 0) {
              // Try to get the first available thread
              for (const threadId of threadIds) {
                const fallbackThread = await db.select()
                  .from(Threads)
                  .where(and(eq(Threads.id, threadId), eq(Threads.userId, authenticatedUserId)))
                  .get();
                
                if (fallbackThread) {
                  // Get actual note count from database using junction table
                  const noteCountResult = await db.select({ count: count() })
                    .from(Notes)
                    .innerJoin(NoteThreads, eq(NoteThreads.noteId, Notes.id))
                    .where(and(
                      eq(NoteThreads.threadId, fallbackThread.id),
                      eq(Notes.userId, authenticatedUserId)
                    ))
                    .get();
                  
                  currentThread = {
                    id: fallbackThread.id,
                    title: fallbackThread.title,
                    color: fallbackThread.color,
                    spaceId: fallbackThread.spaceId || null,
                    noteCount: noteCountResult?.count || 0,
                    backgroundGradient: getThreadGradientCSS(fallbackThread.color)
                  };
                  break;
                }
              }
            }
            
            // If still no thread found, fall back to unorganized
            if (!currentThread) {
              const unorganizedThreadData = await ensureUnorganizedThread(authenticatedUserId);
              currentThread = {
                id: 'thread_unorganized',
                title: 'Unorganized',
                color: null,
                spaceId: null,
                noteCount: unorganizedThreadData.noteCount,
                backgroundGradient: getThreadGradientCSS('paper')
              };
            }
          }
        } else {
          // Fallback: no valid thread selected, use unorganized
          const unorganizedThreadData = await ensureUnorganizedThread(authenticatedUserId);
          currentThread = {
            id: 'thread_unorganized',
            title: 'Unorganized',
            color: null,
            spaceId: null,
            noteCount: unorganizedThreadData.noteCount,
            backgroundGradient: getThreadGradientCSS('paper')
          };
        }

        // Removed: NoteThreadAccess tracking (complexity reduction)
      }
    } else if (isSpace) {
      // Fetch space, its threads, and standalone notes from database
      const [spaceData, spaceThreads, spaceNotesResult] = await Promise.all([
        getSpacesWithCounts(authenticatedUserId).then(spaces => spaces.find(s => s.id === id)),
        getThreadsForSpace(id!, authenticatedUserId),
        getNotesForSpace(id!, authenticatedUserId)
      ]);
      const spaceNotes = spaceNotesResult.notes;
      
      if (spaceData) {
        content = {
          id: spaceData.id,
          title: spaceData.title,
          totalItemCount: spaceData.totalItemCount,
          color: spaceData.color,
          threads: spaceThreads,
          notes: spaceNotes // Standalone notes in this space
        };
        currentSpace = {
          id: spaceData.id,
          title: spaceData.title,
          color: spaceData.color,
          totalItemCount: spaceData.totalItemCount,
          backgroundGradient: spaceData.backgroundGradient || getThreadGradientCSS(spaceData.color || 'paper')
        };
        
        // Create combined and sorted array for "All" tab (most recent first)
        // Ensure threadColors are explicitly preserved when spreading notes
        const allItems = [
          ...spaceThreads.map((thread: any) => ({ ...thread, itemType: 'thread' })),
          ...spaceNotes.map((note: any) => ({ 
            ...note, 
            itemType: 'note',
            threadColors: note.threadColors // Explicitly preserve threadColors
          }))
        ].sort((a, b) => {
          // Sort by lastVisited (newest first), fallback to createdAt if lastVisited is null
          const aTime = a.lastVisited || a.createdAt;
          const bTime = b.lastVisited || b.createdAt;
          const aDate = aTime instanceof Date ? aTime : new Date(aTime);
          const bDate = bTime instanceof Date ? bTime : new Date(bTime);
          return bDate.getTime() - aDate.getTime(); // Descending order (newest first)
        });
        
        content.sortedAllItems = allItems;
        
        threads = spaceThreads;
        pageTitle = spaceData.title;
        pageContent = `${spaceData.totalItemCount} items`;
      }
    }

    // Get navigation data from database
    const [allThreads, allSpaces, inboxCountData] = await Promise.all([
      getAllThreadsWithCounts(authenticatedUserId),
      getSpacesWithCounts(authenticatedUserId),
      getInboxDisplayCount(authenticatedUserId)
    ]);
    
    spaces = allSpaces;
    threads = [...allThreads, ...threads]; // Combine with space-specific threads
    inboxCount = inboxCountData;
    
} catch (error) {
  // Fallback to empty data
  content = null;
  threads = [];
  spaces = [];
  inboxCount = 0;
}



// If content not found, redirect to dashboard
if (!content) {
  return Astro.redirect('/');
}

// Extract noteType for menu options
const noteTypeForMenu = isNote && content?.noteType ? content.noteType : undefined;
