---
export const prerender = false;
import EmptyLayout from "@/layouts/EmptyLayout.astro";
---

<EmptyLayout title="Signing out...">
  <div class="auth-page" style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">
    <p>Signing out...</p>
  </div>
</EmptyLayout>

<script>
  import { clearSessionBackup } from '@/utils/clerk-session-backup';
  clearSessionBackup()
    .then(() => { window.location.replace('/sign-in?from_logout=true'); })
    .catch(() => { window.location.replace('/sign-in?from_logout=true'); });
</script>
