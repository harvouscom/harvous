---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
---

<EmptyLayout title="Logging out...">
  <div class="min-h-[100svh] flex items-center justify-center">
    <div class="text-center">
      <p class="text-lg text-[var(--color-deep-grey)]">Logging you out...</p>
    </div>
  </div>
</EmptyLayout>

<script is:inline>
  // Logout script - always redirects after maximum timeout
  (async function() {
    // Clear storage immediately - don't wait for Clerk
    try {
      sessionStorage.clear();
      localStorage.removeItem('userProfileData');
      localStorage.removeItem('profileData');
    } catch (error) {
      console.error('Storage clear error:', error);
    }
    
    // Maximum timeout for entire logout operation (2 seconds)
    var maxTimeout = 2000;
    var redirectPromise = new Promise(function(resolve) {
      setTimeout(function() {
        // Always redirect after timeout, even if Clerk hasn't finished
        window.location.replace('/sign-in');
        resolve();
      }, maxTimeout);
    });
    
    // Try to use Clerk's signOut if available
    var clerkSignOutPromise = (async function() {
      try {
        // Wait for Clerk to be loaded (with shorter timeout)
        var waitStartTime = Date.now();
        var maxWaitTime = 1000; // Only wait 1 second for Clerk
        
        while (!window.Clerk && (Date.now() - waitStartTime) < maxWaitTime) {
          await new Promise(resolve => setTimeout(resolve, 100));
        }
        
        if (window.Clerk && window.Clerk.signOut) {
          // Use Clerk's built-in signOut with redirectUrl
          await window.Clerk.signOut({ redirectUrl: '/sign-in' });
          // If signOut completes successfully, it will redirect
          // But we still have the timeout as backup
        } else {
          // Clerk not available, redirect immediately
          window.location.replace('/sign-in');
        }
      } catch (error) {
        console.error('Clerk signOut error:', error);
        // On error, redirect immediately
        window.location.replace('/sign-in');
      }
    })();
    
    // Race between Clerk signOut and timeout
    // Whichever completes first will handle the redirect
    await Promise.race([clerkSignOutPromise, redirectPromise]);
  })();
</script>

