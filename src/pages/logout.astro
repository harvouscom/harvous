---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
---

<EmptyLayout title="Logging out...">
  <div class="min-h-[100svh] flex items-center justify-center">
    <div class="text-center">
      <p class="text-lg text-[var(--color-deep-grey)]">Logging you out...</p>
    </div>
  </div>
</EmptyLayout>

<script is:inline>
  // Logout script - uses Clerk's built-in signOut with redirect
  (async function() {
    // Wait for Clerk to be loaded
    var maxWaitTime = 3000; // Max 3 seconds to wait for Clerk
    var startTime = Date.now();
    
    while (!window.Clerk && (Date.now() - startTime) < maxWaitTime) {
      await new Promise(resolve => setTimeout(resolve, 100));
    }
    
    // Clear local storage before sign-out
    try {
      sessionStorage.clear();
      localStorage.removeItem('userProfileData');
      localStorage.removeItem('profileData');
    } catch (error) {
      console.error('Storage clear error:', error);
    }
    
    // Use Clerk's built-in signOut with redirectUrl
    // This handles the sign-out and redirect automatically
    try {
      if (window.Clerk && window.Clerk.signOut) {
        await window.Clerk.signOut({ redirectUrl: '/sign-in' });
      } else {
        // Fallback if Clerk isn't loaded
        window.location.href = '/sign-in';
      }
    } catch (error) {
      console.error('Clerk signOut error:', error);
      // Fallback redirect on error
      window.location.href = '/sign-in';
    }
  })();
</script>

