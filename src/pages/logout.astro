---
import EmptyLayout from "@/layouts/EmptyLayout.astro";
---

<EmptyLayout title="Logging out...">
  <div class="min-h-[100svh] flex items-center justify-center">
    <div class="text-center">
      <p class="text-lg text-[var(--color-deep-grey)]">Logging you out...</p>
    </div>
  </div>
</EmptyLayout>

<script is:inline>
  // Logout script - waits for Clerk signOut to complete before redirecting
  (async function() {
    // Clear storage immediately - don't wait for Clerk
    try {
      sessionStorage.clear();
      localStorage.removeItem('userProfileData');
      localStorage.removeItem('profileData');
    } catch (error) {
      console.error('Storage clear error:', error);
    }
    
    // Maximum timeout for entire logout operation (8 seconds)
    // This gives Clerk time to properly invalidate the session
    var maxTimeout = 8000;
    var timeoutId = setTimeout(function() {
      // Fallback: redirect after timeout even if signOut hasn't completed
      window.location.replace('/sign-in?from_logout=true');
    }, maxTimeout);
    
    try {
      // Wait for Clerk to be loaded
      var waitStartTime = Date.now();
      var maxWaitTime = 3000; // Wait up to 3 seconds for Clerk to load
      
      while (!window.Clerk && (Date.now() - waitStartTime) < maxWaitTime) {
        await new Promise(resolve => setTimeout(resolve, 100));
      }
      
      if (window.Clerk && window.Clerk.signOut) {
        // Wait for Clerk's signOut to complete
        // This ensures the session is properly invalidated on the server
        await window.Clerk.signOut();
        
        // Clear the timeout since signOut completed
        clearTimeout(timeoutId);
        
        // Small delay to ensure session invalidation propagates
        await new Promise(resolve => setTimeout(resolve, 300));
        
        // Redirect to sign-in with from_logout parameter
        window.location.replace('/sign-in?from_logout=true');
      } else {
        // Clerk not available, clear timeout and redirect
        clearTimeout(timeoutId);
        window.location.replace('/sign-in?from_logout=true');
      }
    } catch (error) {
      console.error('Clerk signOut error:', error);
      // On error, clear timeout and redirect
      clearTimeout(timeoutId);
      window.location.replace('/sign-in?from_logout=true');
    }
  })();
</script>

