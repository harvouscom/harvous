---
import { getThreadTextColorCSS, THREAD_COLORS, type ThreadColor } from '@/utils/colors';

export interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
  headerBgColor?: string;
  centerTitle?: boolean;
  id?: string;
  threadId?: string;
}

const { 
  title = "Welcome to Harvous", 
  subtitle,
  class: className = "",
  headerBgColor = "var(--color-paper)",
  centerTitle = false,
  id,
  threadId
} = Astro.props;

// Extract color name from CSS variable format (e.g., "var(--color-blue)" -> "blue")
function extractColorName(bgColor: string): ThreadColor | null {
  const match = bgColor.match(/--color-([a-z]+)/);
  if (match && THREAD_COLORS.includes(match[1] as ThreadColor)) {
    return match[1] as ThreadColor;
  }
  return null;
}

// Determine text color based on header background color
const colorName = extractColorName(headerBgColor);
const textColor = getThreadTextColorCSS(colorName);
---

<div class={`card-stack ${className}`} {...(id ? { id } : {})}>
  <div class="card-stack__container">
    <!-- Header section with dynamic background -->
    {Astro.slots.has('header') ? (
      <slot name="header" />
    ) : (
      <div 
        class="card-stack__header" 
        style={`background-color: ${headerBgColor}; color: ${textColor}`}
        {...(threadId ? { 'data-thread-id': threadId } : {})}
      >
        {subtitle ? (
          <>
            <div class={`page-heading ${centerTitle ? 'page-heading--center' : ''}`}>
              <p>{title}</p>
            </div>
            <div class="card-stack__subtitle">
              <p>{subtitle}</p>
            </div>
          </>
        ) : (
          <div class="page-heading page-heading--center">
            <p>{title}</p>
          </div>
        )}
      </div>
    )}
    
    <!-- Content area -->
    <div class="card-stack__content">
      <div class="card-stack__inner">
        <div class="card-stack__inner-content">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    // Only attach listener once globally
    if (window.__cardStackHeaderListenerAttached) {
      return;
    }
    window.__cardStackHeaderListenerAttached = true;
    
    // Use event delegation to handle clicks on card-stack__header with data-thread-id or data-space-id
    // This works with View Transitions since we're listening on document
    function handleCardStackHeaderClick(event) {
      const header = event.target.closest('.card-stack__header[data-thread-id], .card-stack__header[data-space-id]');
      if (!header) return;
      
      const threadId = header.getAttribute('data-thread-id');
      const spaceId = header.getAttribute('data-space-id');
      
      // Skip unorganized thread - it cannot be edited
      if (threadId === 'thread_unorganized') {
        return;
      }
      
      if (threadId) {
        // Dispatch event to open EditThreadPanel
        // DesktopPanelManager will handle this event
        window.dispatchEvent(new CustomEvent('openEditThreadPanel'));
      } else if (spaceId) {
        // Dispatch event to open EditSpacePanel
        // DesktopPanelManager will handle this event
        window.dispatchEvent(new CustomEvent('openEditSpacePanel'));
      }
    }
    
    // Attach listener to document for event delegation
    document.addEventListener('click', handleCardStackHeaderClick);
  })();
</script>
