---
export interface Props {
  tabs: Array<{
    id: string;
    label: string;
    isActive?: boolean;
    count?: number;
  }>;
  onTabChange?: (tabId: string) => void;
  class?: string;
}

const { tabs, class: className = "" } = Astro.props;
---

<div 
  class:list={[
    "tab-nav-container",
    className
  ]}
>
  <!-- Tab Navigation -->
  <div class="tab-nav">
    {tabs.map((tab) => (
      <button
        class="tab-nav__button"
        data-tab-id={tab.id}
        data-active={tab.isActive ? "true" : "false"}
        data-tab-button
      >
        <span class="tab-nav__label">
          {tab.label}
        </span>
        {tab.count !== undefined && tab.count > 0 && (
          <div class="badge-count">
            <span class="badge-number">{tab.count > 99 ? '99+' : String(tab.count)}</span>
          </div>
        )}
      </button>
    ))}
  </div>
</div>
