---
export interface Props {
  tabs: Array<{
    id: string;
    label: string;
    isActive?: boolean;
  }>;
  onTabChange?: (tabId: string) => void;
  class?: string;
}

const { tabs, class: className = "" } = Astro.props;
---

<div 
  class:list={[
    "tab-nav-container",
    className
  ]}
>
  <!-- Tab Navigation -->
  <div class="tab-nav">
    {tabs.map((tab) => (
      <button
        class="tab-nav__button"
        data-tab-id={tab.id}
        data-active={tab.isActive ? "true" : "false"}
        data-tab-button
      >
        <span class="tab-nav__label">
          {tab.label}
        </span>
      </button>
    ))}
  </div>
</div>
