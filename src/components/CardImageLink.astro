---
export interface Props {
  title?: string;
  date?: string;
  noteId?: string;
  content?: string;
  imageUrl?: string;
  source?: string;
  className?: string;
}

const {
  title = "Abraham",
  date = "Feb 7, 2025",
  noteId = "#N004",
  content = "How can the story of one family who lived thousands of years ago help us see God at work today? As God shapes Abraham through calling and testing, the story of the people of Israel and all of humanity is told in the ups and downs of his life. Journey with Abraham through a lifetime of failures and faithfulness as he learns to trust God's promise and becomes the father of many nations.",
  imageUrl = "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400&h=300&fit=crop",
  source = "BibleProject",
  className = ""
} = Astro.props;
---

<div class={`card-image-link ${className}`}>
  <!-- Image -->
  <div 
    class="card-image-link__image" 
    style={`background-image: url('${imageUrl}')`}
  ></div>
  
  <!-- Title and Bookmark -->
  <div class="card-image-link__header">
    <div class="card-image-link__title">
      <p>{title}</p>
    </div>
    <div class="card-image-link__bookmark">
      <svg fill="currentColor" viewBox="0 0 24 24">
        <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/>
      </svg>
    </div>
  </div>
  
  <!-- Date and Note ID -->
  <div class="card-image-link__meta">
    <div class="card-image-link__meta-item">
      <p>{date}</p>
    </div>
    <div class="card-image-link__meta-item">
      <p>{noteId}</p>
    </div>
  </div>
  
  <!-- Content -->
  <div class="card-image-link__content">
    <div class="card-image-link__content-text">
      <p>{content}</p>
    </div>
  </div>
  
  <!-- Source Link -->
  <div class="card-image-link__source">
    <div class="card-image-link__source-content">
      <div class="card-image-link__source-row">
        <div class="card-image-link__source-text">
          <p>{source}</p>
        </div>
        <div class="card-image-link__source-icon">
          <svg fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </div>
      </div>
    </div>
    <div class="card-image-link__shadow"></div>
  </div>
  
  <!-- Gradient Overlay -->
  <div class="card-image-link__gradient"></div>
</div>
