---
// This component contains the slotted content for the main profile CardStack.
// It is kept separate to be used within an Astro component (CardStack)
// while the interactive panels are handled by the main React component.

import ProfileOptionsList from '@/components/react/ProfileOptionsList';

interface Props {
    joinDate: string;
    seasonalXP: number;
    seasonName: string;
}

const { joinDate, seasonalXP, seasonName } = Astro.props;
---

<div class="flex flex-col justify-between h-full w-full">
    <!-- Top Info Cards -->
    <div class="grid grid-cols-2" style="gap: 12px; margin-bottom: 12px;">
        <!-- Joined Date Card -->
        <div class="bg-white border border-[var(--color-fog-white)] rounded-xl p-3 flex items-center gap-3">
        <svg class="w-4 h-4 fill-current text-[var(--color-deep-grey)]" viewBox="0 0 448 512">
            <path d="M152 24c0-13.3-10.7-24-24-24s-24 10.7-24 24V64H64C28.7 64 0 92.7 0 128v16 48V448c0 35.3 28.7 64 64 64H384c35.3 0 64-28.7 64-64V192 144 128c0-35.3-28.7-64-64-64H344V24c0-13.3-10.7-24-24-24s-24 10.7-24 24V64H152V24zM48 192H400V448c0 8.8-7.2 16-16 16H64c-8.8 0-16-7.2-16-16V192z"/>
        </svg>
        <div>
            <div class="text-base font-semibold text-[var(--color-deep-grey)]">{joinDate}</div>
            <div class="text-xs text-[var(--color-pebble-grey)]">Joined</div>
        </div>
        </div>
        
        <!-- XP Card - Shows seasonal XP with season label -->
        <div class="bg-white border border-[var(--color-fog-white)] rounded-xl p-3 flex items-center gap-3">
            <svg class="w-4 h-4 fill-current text-[var(--color-deep-grey)]" viewBox="0 0 448 512">
                <path d="M349.4 44.6c5.9-13.7 1.5-29.7-10.6-38.5s-28.6-8-39.9 1.8l-256 224c-10 8.8-13.6 22.9-8.9 35.3S50.7 288 64 288l111.5 0L98.6 467.4c-5.9 13.7-1.5 29.7 10.6 38.5s28.6 8 39.9-1.8l256-224c10-8.8 13.6-22.9 8.9-35.3s-16.6-20.7-30-20.7l-111.5 0L349.4 44.6z"/>
            </svg>
            <div>
                <div class="text-base font-semibold text-[var(--color-deep-grey)]">{seasonalXP} XP</div>
                <div class="text-xs text-[var(--color-pebble-grey)]">{seasonName}</div>
            </div>
        </div>
    </div>

    <!-- Settings Options -->
    <!-- React component handles offline state and disables options that require online connectivity -->
    <ProfileOptionsList client:load />

    <!-- Bottom Section - Get Support & About Harvous -->
    <div class="mt-auto pt-3 pb-3 flex flex-col gap-3">
        <!-- Get Support Button -->
        <div onclick="window.dispatchEvent(new CustomEvent('openProfilePanel', { detail: { panelName: 'getSupport' } }))" class="w-full">
             <div class="space-button relative rounded-3xl h-[64px] cursor-pointer transition-[scale,shadow] duration-300 pl-4 pr-0 w-full" style="background-image: var(--color-gradient-gray);">
                <div class="flex items-center justify-between relative w-full h-full pl-2 pr-0 transition-transform duration-125 min-w-0">
                    <div class="flex-1 min-w-0 overflow-hidden">
                        <span class="font-sans text-[18px] font-semibold whitespace-nowrap overflow-hidden text-ellipsis block" style="color: var(--color-deep-grey);">Get Support</span>
                    </div>
                    <div class="flex items-center justify-center relative shrink-0">
                        <div class="box-border content-stretch flex gap-2.5 items-center justify-start p-[12px] relative">
                            <div class="flex items-center justify-center relative shrink-0">
                                <div class="relative w-6 h-6">
                                    <svg class="fill-[var(--color-pebble-grey)] block max-w-none w-full h-full transition-transform duration-125" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"/></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Letter from the Founder Button -->
        <div onclick="window.dispatchEvent(new CustomEvent('openProfilePanel', { detail: { panelName: 'aboutHarvous' } }))" class="w-full">
             <div class="space-button relative rounded-3xl h-[64px] cursor-pointer transition-[scale,shadow] duration-300 pl-4 pr-0 w-full" style="background-image: var(--color-gradient-gray);">
                <div class="flex items-center justify-between relative w-full h-full pl-2 pr-0 transition-transform duration-125 min-w-0">
                    <div class="flex-1 min-w-0 overflow-hidden">
                        <span class="font-sans text-[18px] font-semibold whitespace-nowrap overflow-hidden text-ellipsis block" style="color: var(--color-deep-grey);">Letter from the Founder</span>
                    </div>
                    <div class="flex items-center justify-center relative shrink-0">
                        <div class="box-border content-stretch flex gap-2.5 items-center justify-start p-[12px] relative">
                            <div class="flex items-center justify-center relative shrink-0">
                                <div class="relative w-6 h-6">
                                    <svg class="fill-[var(--color-pebble-grey)] block max-w-none w-full h-full transition-transform duration-125" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"/></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
