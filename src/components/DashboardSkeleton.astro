---
// Skeleton loading state for dashboard
---

<div class="dashboard-skeleton">
  <div class="dashboard-skeleton__container">
    <!-- CardStack skeleton -->
    <div class="dashboard-skeleton__card">
      <div class="dashboard-skeleton__card-inner">
        <!-- Header skeleton -->
        <div class="dashboard-skeleton__header">
          <div class="h-7 w-24 skeleton-shimmer"></div>
        </div>
        
        <!-- Content skeleton -->
        <div class="dashboard-skeleton__content">
          <!-- TabNav skeleton -->
          <div class="dashboard-skeleton__tabs">
            <div class="h-10 w-20 skeleton-shimmer"></div>
            <div class="h-10 w-20 skeleton-shimmer"></div>
          </div>
          
          <!-- Content items skeleton -->
          <div class="dashboard-skeleton__items">
            <!-- Skeleton item 1 -->
            <div class="dashboard-skeleton__item skeleton-shimmer"></div>
            <!-- Skeleton item 2 -->
            <div class="dashboard-skeleton__item skeleton-shimmer"></div>
            <!-- Skeleton item 3 -->
            <div class="dashboard-skeleton__item skeleton-shimmer"></div>
          </div>
          
          <!-- Second TabNav skeleton -->
          <div class="dashboard-skeleton__tabs dashboard-skeleton__tabs--spaced">
            <div class="h-10 w-16 skeleton-shimmer"></div>
            <div class="h-10 w-20 skeleton-shimmer"></div>
            <div class="h-10 w-20 skeleton-shimmer"></div>
          </div>
          
          <!-- More content items skeleton -->
          <div class="dashboard-skeleton__items">
            <!-- Skeleton item 4 -->
            <div class="dashboard-skeleton__item dashboard-skeleton__item--small skeleton-shimmer"></div>
            <!-- Skeleton item 5 -->
            <div class="dashboard-skeleton__item dashboard-skeleton__item--small skeleton-shimmer"></div>
            <!-- Skeleton item 6 -->
            <div class="dashboard-skeleton__item dashboard-skeleton__item--small skeleton-shimmer"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

