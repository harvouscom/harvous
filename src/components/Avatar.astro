---
import { getThreadTextColorCSS, type ThreadColor } from '@/utils/colors';

interface Props {
    initials?: string;
    className?: string;
    color?: string;
    id?: string;
}

const { 
    initials = "DJ", 
    className = "", 
    color = "paper",
    ...props 
} = Astro.props;

// Avatar component - integrates with avatar-manager utility for updates
const textColor = getThreadTextColorCSS(color as ThreadColor);
---

<div 
    class={`avatar ${className}`}
    style={`background: var(--color-${color});`}
    data-avatar-color={color}
    data-avatar-initials={initials}
    {...props}
>
    <div class="avatar__initials" style={`color: ${textColor}`}>
        <p>{initials}</p>
    </div>
</div>
