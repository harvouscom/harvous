---
import MobileAdditionalReact from "./react/MobileAdditional";

export interface Props {
  contentType?: "thread" | "note" | "space" | "dashboard" | "profile" | "search" | "new-space";
  contentId?: string;
  currentThread?: any;
  currentSpace?: any;
  noteType?: string;
  contentEncrypted?: boolean;
  noteSimpleId?: number | null;
  spaceRole?: 'owner' | 'member' | null;
  contentOwnerId?: string;
  userId?: string;
}

const { contentType = "dashboard", contentId, currentThread, currentSpace, noteType, contentEncrypted, noteSimpleId, spaceRole, contentOwnerId, userId } = Astro.props;
---

<MobileAdditionalReact
  contentType={contentType}
  contentId={contentId}
  currentThread={currentThread}
  currentSpace={currentSpace}
  currentThreadId={currentThread?.id}
  noteType={noteType}
  contentEncrypted={contentEncrypted}
  noteSimpleId={noteSimpleId}
  spaceRole={spaceRole}
  contentOwnerId={contentOwnerId}
  userId={userId}
  client:load
/>
