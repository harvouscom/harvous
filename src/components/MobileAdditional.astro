---
import MobileAdditionalReact from "./react/MobileAdditional";

export interface Props {
  contentType?: "thread" | "note" | "space" | "dashboard" | "profile";
  contentId?: string;
  currentThread?: any;
  currentSpace?: any;
  noteType?: string;
}

const { contentType = "dashboard", contentId, currentThread, currentSpace, noteType } = Astro.props;
---

<MobileAdditionalReact
  contentType={contentType}
  contentId={contentId}
  currentThread={currentThread}
  currentSpace={currentSpace}
  currentThreadId={currentThread?.id}
  noteType={noteType}
  client:load
/>
