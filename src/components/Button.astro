---
export interface Props {
  state?: "Default" | "Secondary" | "Delete";
  class?: string;
  [key: string]: any;
}

const { state = "Default", class: className = "" } = Astro.props;

const variantClass = state === "Default" ? "btn--primary" : 
                     state === "Secondary" ? "btn--secondary" : 
                     "btn--danger";
---

<button
  class:list={["btn btn--lg", variantClass, className]}
  {...Astro.props}
>
  <div class="btn__content">
    <slot>Button</slot>
  </div>
  <div class="btn__shadow-overlay" />
</button>
