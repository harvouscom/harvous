---
export interface Props {
  state?: "Default" | "Secondary" | "Delete";
  class?: string;
  href?: string;
  type?: "button" | "submit" | "reset";
  [key: string]: any;
}

const { state = "Default", class: className = "", href, type, ...rest } = Astro.props;

const variantClass = state === "Default" ? "btn--primary" : 
                     state === "Secondary" ? "btn--secondary" : 
                     "btn--danger";

const baseClass = ["btn", "btn--lg", variantClass, className];
---

{href ? (
  <a
    class:list={baseClass}
    href={href}
    {...rest}
  >
    <div class="btn__content">
      <slot>Button</slot>
    </div>
    <div class="btn__shadow-overlay" />
  </a>
) : (
  <button
    class:list={baseClass}
    type={type}
    {...rest}
  >
    <div class="btn__content">
      <slot>Button</slot>
    </div>
    <div class="btn__shadow-overlay" />
  </button>
)}
