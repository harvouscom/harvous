---
import CardFullEditable from './react/CardFullEditable';

export interface Props {
  title: string;
  content: string;
  date: string;
  noteId?: string;
  noteType?: 'default' | 'scripture' | 'resource';
  version?: string;
  resourceTitle?: string;
  resourceDescription?: string;
  resourceImage?: string;
  resourceUrl?: string;
  className?: string;
}

const { title, content, date, noteId, noteType = 'default', version, resourceTitle, resourceDescription, resourceImage, resourceUrl, className } = Astro.props;
---

<!-- React version of CardFullEditable -->
<CardFullEditable 
  title={title}
  content={content}
  date={date}
  noteId={noteId}
  noteType={noteType}
  version={version}
  resourceTitle={resourceTitle}
  resourceDescription={resourceDescription}
  resourceImage={resourceImage}
  resourceUrl={resourceUrl}
  className={className}
  client:load 
/>
