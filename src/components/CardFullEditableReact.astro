---
import CardFullEditable from './react/CardFullEditable';

export interface Props {
  title: string;
  content: string;
  date: string;
  noteId?: string;
  noteType?: 'default' | 'scripture' | 'resource';
  version?: string;
  resourceTitle?: string;
  resourceDescription?: string;
  resourceImage?: string;
  resourceUrl?: string;
  contentEncrypted?: boolean;
  className?: string;
  /** When false, note is view-only (e.g. member viewing another user's note in a shared space). Default true. */
  isEditable?: boolean;
}

const { title, content, date, noteId, noteType = 'default', version, resourceTitle, resourceDescription, resourceImage, resourceUrl, contentEncrypted, className, isEditable = true } = Astro.props;
---

<!-- React version of CardFullEditable -->
<CardFullEditable 
  title={title}
  content={content}
  date={date}
  noteId={noteId}
  noteType={noteType}
  version={version}
  resourceTitle={resourceTitle}
  resourceDescription={resourceDescription}
  resourceImage={resourceImage}
  resourceUrl={resourceUrl}
  contentEncrypted={contentEncrypted}
  className={className}
  isEditable={isEditable}
  client:load 
/>
