---
import MobileNavigationWrapper from "@/components/react/navigation/MobileNavigationWrapper.tsx";

export interface Props {
  spaces?: any[];
  threads?: any[];
  inboxCount?: number;
  currentSpace?: any;
  currentThread?: any;
  initials?: string;
  userColor?: string;
  initialPath?: string;
}

const {
  spaces = [],
  threads = [],
  inboxCount = 0,
  currentSpace,
  currentThread,
  initials = 'U',
  userColor = 'paper',
  initialPath = ''
} = Astro.props;
---

<MobileNavigationWrapper
  client:load
  spaces={spaces}
  threads={threads}
  inboxCount={inboxCount}
  currentSpace={currentSpace}
  currentThread={currentThread}
  initials={initials}
  userColor={userColor}
  initialPath={initialPath}
/>



