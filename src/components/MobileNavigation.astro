---
import MobileNavigationWrapper from "@/components/react/navigation/MobileNavigationWrapper.tsx";

export interface Props {
  spaces?: any[];
  threads?: any[];
  inboxCount?: number;
  currentSpace?: any;
  currentThread?: any;
  initials?: string;
  userColor?: string;
}

const { 
  spaces = [], 
  threads = [], 
  inboxCount = 0,
  currentSpace,
  currentThread,
  initials = 'U',
  userColor = 'paper'
} = Astro.props;
---

<MobileNavigationWrapper 
  client:only="react"
  spaces={spaces}
  threads={threads}
  inboxCount={inboxCount}
  currentSpace={currentSpace}
  currentThread={currentThread}
  initials={initials}
  userColor={userColor}
/>



