{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "app-navigate": ["spa/src/shims/app-navigate.ts"] },
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "spa/**/*", "server/**/*", "scripts/**/*", "db/**/*", "e2e/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "dist-spa", "public"]
}
