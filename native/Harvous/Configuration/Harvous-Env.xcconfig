// Per-environment settings consumed by Info.plist via $(VAR) substitution.
//
// CLERK_PUBLISHABLE_KEY: from Clerk dashboard → API keys → Publishable key.
//   Use the test (pk_test_…) key for Debug, live (pk_live_…) for Release.
//   Safe to commit — publishable keys are not secret.
// HARVOUS_API_BASE_URL: base URL the native API client points at. Localhost for
//   simulator development; the production host for shipped builds.
//
// Override locally if needed by editing this file; do not commit personal keys.

CLERK_PUBLISHABLE_KEY = pk_test_REPLACE_ME
HARVOUS_API_BASE_URL = https:/$()/app.harvous.com
