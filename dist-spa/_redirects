# API routes → Astro SSR function (Netlify serverless)
/api/*  /.netlify/functions/ssr  200

# PWA web-app-origin-association endpoint
/.well-known/*  /.netlify/functions/ssr  200

# SSR-only pages (no SPA equivalent)
/logout  /.netlify/functions/ssr  200

# SPA catch-all: all other non-static routes serve the React SPA's index.html.
# Static assets (/_astro/*, /scripts/*, /fonts/*, etc.) are served directly
# by Netlify before redirects apply (no force flag = static files take priority).
/*  /index.html  200
