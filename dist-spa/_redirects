# API routes → Hono Netlify Function
/api/*  /.netlify/functions/api/:splat  200

# SPA routes — serve index.html for all client-side routes.
# Static assets (JS, CSS, images, fonts) are served directly from dist-spa/.
# Everything else falls through to the SPA's client-side router.
/                /index.html  200
/note/*          /index.html  200
/thread/*        /index.html  200
/space/*         /index.html  200
/search          /index.html  200
/profile         /index.html  200
/profile/        /index.html  200
/new-space       /index.html  200
/upgrade         /index.html  200
/dashboard       /index.html  200
/sign-in/*       /index.html  200
/sign-up/*       /index.html  200
/spaces/join/*   /index.html  200
/shared/*        /index.html  200
/invitations/*  /index.html  200
