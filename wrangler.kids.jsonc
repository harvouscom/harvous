// Production child site: kids.harvous.com (KWS Production approved 13 Nov 2026). Deploy with
// `npm run build:child && npx wrangler deploy -c wrangler.kids.jsonc`; the retention secret is set with
// `wrangler secret put FAMILY_RETENTION_CRON_SECRET -c wrangler.kids.jsonc`. See docs/CHILD_NOTEBOOKS_LAUNCH.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harvous-kids",
  "main": "cloudflare/child-worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist-kids",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": { "API_ORIGIN": "https://harvous.fly.dev" },
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 4 * * *"] },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kids.harvous.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "harvous-kids-staging",
      "assets": {
        "directory": "./dist-kids-staging",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "html_handling": "none",
        "run_worker_first": true
      },
      "vars": { "API_ORIGIN": "https://harvous-family-staging.fly.dev" },
      "observability": { "enabled": false },
      "triggers": { "crons": ["17 4 * * *"] },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "kids-test.harvous.com", "custom_domain": true }]
    }
  }
}
